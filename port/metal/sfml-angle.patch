+// AgePad alteration: hardware keyboard HID translation, shared with host checks.
+#ifndef SFML_IOS_KEYBOARDMAPPING_HPP
+#define SFML_IOS_KEYBOARDMAPPING_HPP
+#include <SFML/Window/Keyboard.hpp>
+namespace sf { namespace priv {
+// Numeric values come from UIKit UIKeyConstants.h (USB keyboard usage page).
+// This is physical US-key positioning, not localized text entry. Keys without
+// an sf::Keyboard::Key representation intentionally remain Unknown.
+inline sf::Keyboard::Key keyFromHIDUsage(int key) {
+    if(key>=4 && key<=29)return sf::Keyboard::Key(sf::Keyboard::A+key-4);
+    if(key>=30 && key<=38)return sf::Keyboard::Key(sf::Keyboard::Num1+key-30);
+    if(key>=58 && key<=69)return sf::Keyboard::Key(sf::Keyboard::F1+key-58);
+    if(key>=104 && key<=106)return sf::Keyboard::Key(sf::Keyboard::F13+key-104);
+    if(key>=89 && key<=97)return sf::Keyboard::Key(sf::Keyboard::Numpad1+key-89);
+    switch(key) {
+    case 39:return sf::Keyboard::Num0;case 40:return sf::Keyboard::Return;
+    case 41:return sf::Keyboard::Escape;case 42:return sf::Keyboard::BackSpace;
+    case 43:return sf::Keyboard::Tab;case 44:return sf::Keyboard::Space;
+    case 45:return sf::Keyboard::Hyphen;case 46:return sf::Keyboard::Equal;
+    case 47:return sf::Keyboard::LBracket;case 48:return sf::Keyboard::RBracket;
+    case 49:return sf::Keyboard::Backslash;case 51:return sf::Keyboard::Semicolon;
+    case 52:return sf::Keyboard::Apostrophe;case 53:return sf::Keyboard::Grave;
+    case 54:return sf::Keyboard::Comma;case 55:return sf::Keyboard::Period;
+    case 56:return sf::Keyboard::Slash;
+    case 72:return sf::Keyboard::Pause;case 73:return sf::Keyboard::Insert;
+    case 74:return sf::Keyboard::Home;case 75:return sf::Keyboard::PageUp;
+    case 76:return sf::Keyboard::Delete;case 77:return sf::Keyboard::End;
+    case 78:return sf::Keyboard::PageDown;
+    case 84:return sf::Keyboard::Divide;case 85:return sf::Keyboard::Multiply;
+    case 86:return sf::Keyboard::Subtract;case 87:return sf::Keyboard::Add;
+    case 88:return sf::Keyboard::Enter;case 98:return sf::Keyboard::Numpad0;
