diff --git a/dlls/kernel32/thread.c b/dlls/kernel32/thread.c
index f26e308feed..eac50c41f7a 100644
--- a/dlls/kernel32/thread.c
+++ b/dlls/kernel32/thread.c
@@ -31,6 +31,7 @@
 #include "wine/asm.h"
 #include "wine/debug.h"
 #include "kernel_private.h"
+#include "winsvc.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(thread);
 
@@ -64,8 +65,87 @@ __ASM_GLOBAL_FUNC( BaseThreadInitThunk,
                     "movl %eax,%ecx\n\t"
                     "call " __ASM_NAME( "RtlExitUserThread" ))
 #else
+#ifdef AGEPAD_SIGNED_WINE_TSD
+/* Diagnostic initial-process service startup. Consume the environment request
+ * before creating children so their first thread does not recursively bootstrap. */
+static BOOL agepad_start_rpcss(void)
+{
+    HMODULE module = LoadLibraryW(L"sechost.dll");
+    SC_HANDLE manager = NULL, service = NULL;
+    SC_HANDLE (WINAPI *open_manager)(LPCWSTR,LPCWSTR,DWORD);
+    SC_HANDLE (WINAPI *open_service)(SC_HANDLE,LPCWSTR,DWORD);
+    BOOL (WINAPI *start_service)(SC_HANDLE,DWORD,LPCWSTR *);
+    BOOL (WINAPI *query_service)(SC_HANDLE,SC_STATUS_TYPE,BYTE *,DWORD,DWORD *);
+    BOOL (WINAPI *close_service)(SC_HANDLE);
+    SERVICE_STATUS_PROCESS state = {0};
+    DWORD needed, error = ERROR_PROC_NOT_FOUND;
+    ULONGLONG deadline;
+    BOOL ok = FALSE;
+    if (!module) return FALSE;
+    open_manager = (void *)GetProcAddress(module, "OpenSCManagerW");
+    open_service = (void *)GetProcAddress(module, "OpenServiceW");
+    start_service = (void *)GetProcAddress(module, "StartServiceW");
+    query_service = (void *)GetProcAddress(module, "QueryServiceStatusEx");
+    close_service = (void *)GetProcAddress(module, "CloseServiceHandle");
+    if (!open_manager || !open_service || !start_service || !query_service || !close_service) goto done;
+    manager = open_manager(NULL, NULL, SC_MANAGER_CONNECT);
+    if (!manager) { error = GetLastError(); goto done; }
+    service = open_service(manager, L"RpcSs", SERVICE_START | SERVICE_QUERY_STATUS);
+    if (!service) { error = GetLastError(); goto done; }
+    if (!start_service(service, 0, NULL) && (error = GetLastError()) != ERROR_SERVICE_ALREADY_RUNNING) goto done;
+    deadline = GetTickCount64() + 120000;
+    do {
+        if (!query_service(service, SC_STATUS_PROCESS_INFO, (BYTE *)&state, sizeof(state), &needed)) {
+            error = GetLastError(); goto done;
+        }
+        if (state.dwCurrentState == SERVICE_RUNNING) { ok = TRUE; error = ERROR_SUCCESS; break; }
+        if (state.dwCurrentState == SERVICE_STOPPED) { error = state.dwWin32ExitCode; break; }
+        Sleep(100);
+        error = ERROR_TIMEOUT;
+    } while (GetTickCount64() < deadline);
+ done:
+    ERR("[AgePad-rpcss-bootstrap] running=%u state=%lu error=%lu\n", ok, state.dwCurrentState, error);
+    if (service) close_service(service);
+    if (manager) close_service(manager);
+    FreeLibrary(module);
+    return ok;
+}
+
+static void agepad_start_services(void)
+{
+    static LONG entered;
+    WCHAR enabled[2], command[] = L"C:\\windows\\system32\\services.exe";
+    STARTUPINFOW startup = {0};
+    PROCESS_INFORMATION process = {0};
+    HANDLE handles[2];
+    DWORD result;
+    BOOL rpcss;
+    if (!GetEnvironmentVariableW(L"AGEPAD_BOOTSTRAP_SERVICES", enabled, 2)) return;
+    if (InterlockedCompareExchange(&entered, 1, 0)) return;
+    if (!SetEnvironmentVariableW(L"AGEPAD_BOOTSTRAP_SERVICES", NULL)) ExitProcess(92);
+    rpcss = GetEnvironmentVariableW(L"AGEPAD_BOOTSTRAP_RPCSS", enabled, 2) != 0;
+    if (!SetEnvironmentVariableW(L"AGEPAD_BOOTSTRAP_RPCSS", NULL)) ExitProcess(96);
+    handles[0] = CreateEventW(NULL, TRUE, FALSE, L"__wine_SvcctlStarted");
+    if (!handles[0]) ExitProcess(93);
+    startup.cb = sizeof(startup);
+    if (!CreateProcessW(command, command, NULL, NULL, FALSE, DETACHED_PROCESS,
+                        NULL, NULL, &startup, &process)) ExitProcess(94);
+    CloseHandle(process.hThread);
+    handles[1] = process.hProcess;
+    result = WaitForMultipleObjects(2, handles, FALSE, 120000);
+    ERR("[AgePad-service-bootstrap] wait=%#lx\n", result);
+    CloseHandle(handles[0]);
+    CloseHandle(handles[1]);
+    if (result != WAIT_OBJECT_0) ExitProcess(95);
+    if (rpcss && !agepad_start_rpcss()) ExitProcess(97);
+}
+#endif
+
 void __fastcall BaseThreadInitThunk( DWORD unknown, LPTHREAD_START_ROUTINE entry, void *arg )
 {
+#ifdef AGEPAD_SIGNED_WINE_TSD
+    agepad_start_services();
+#endif
     RtlExitUserThread( entry( arg ) );
 }
 #endif
