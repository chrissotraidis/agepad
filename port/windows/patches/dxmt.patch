+/* DXMT stores one eight-byte texture binding in its argument table. */
+static uint64_t
+agepad_texture_binding(id<MTLTexture> texture) {
+  uint64_t direct = [texture gpuResourceID]._impl;
+#if TARGET_OS_SIMULATOR
+  const char *enabled = getenv("AGEPAD_ENCODE_TEXTURE_IDS");
+  if (!texture || direct || !enabled || strcmp(enabled, "1")) return direct;
+  MTLArgumentDescriptor *arg = [[MTLArgumentDescriptor alloc] init];
+  arg.dataType = MTLDataTypeTexture; arg.index = 0;
+  arg.access = MTLArgumentAccessReadOnly; arg.textureType = texture.textureType;
+  NSArray *arguments = [[NSArray alloc] initWithObjects:arg, nil];
+  id<MTLArgumentEncoder> encoder = [texture.device newArgumentEncoderWithArguments:arguments];
+  [arguments release]; [arg release];
+  uint64_t encoded = 0;
+  /* Reject other layouts; never truncate a larger opaque encoding. */
+  if (encoder && encoder.encodedLength == sizeof(encoded)) {
+    id<MTLBuffer> buffer = [texture.device newBufferWithLength:sizeof(encoded) options:MTLResourceStorageModeShared];
+    if (buffer && buffer.contents) {
+      memset(buffer.contents, 0, sizeof(encoded));
+      [encoder setArgumentBuffer:buffer offset:0];
+      [encoder setTexture:texture atIndex:0];
+      memcpy(&encoded, buffer.contents, sizeof(encoded));
+    }
+    [buffer release];
+  }
+  static unsigned count;
+  if (__atomic_fetch_add(&count, 1, __ATOMIC_RELAXED) < 16)
+    dprintf(2, "[AgePad-texture-binding] length=%llu direct=%llx encoded=%llx\n", (unsigned long long)encoder.encodedLength, (unsigned long long)direct, (unsigned long long)encoded);
+  [encoder release];
+  return encoded;
+#else
+  return direct;
+#endif
