+  auto &state = tessellation ? ts_draw_arguments_marshal : gs_draw_arguments_marshal;
+  if (state) return;
+  auto pool = WMT::MakeAutoreleasePool();
+  const char *name = tessellation ? "ts_draw_arguments_marshal" : "gs_draw_arguments_marshal";
