+                a->size <= agepad_jit_chunks[i].size - (a->address - start)) {
+                a->result = 1; break;
+            }
+        }
+        break;
+    case 5:
+        status = STATUS_INVALID_PARAMETER;
+        for (unsigned int i = 0; i < agepad_jit_count; ++i)
+            if (agepad_jit_chunks[i].owner == owner && (ULONG_PTR)agepad_jit_chunks[i].base == a->address && !agepad_jit_chunks[i].released &&
+                a->size <= agepad_jit_chunks[i].size) {
+                agepad_jit_chunks[i].reusable = a->size == agepad_jit_chunks[i].size;
+                agepad_jit_chunks[i].released = TRUE; status = STATUS_SUCCESS;
+                dprintf(2, "[AgePad-JIT] quarantined allocation=%p\n", agepad_jit_chunks[i].base); break;
