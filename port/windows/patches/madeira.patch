+
+static struct ios_thread_lease ios_thread_lease_for_teb(uintptr_t target)
+{
+    struct ios_thread_lease lease = {.slot = -1};
+    int count = __atomic_load_n(&ios_thread_count, __ATOMIC_SEQ_CST);
+    if (!target) return lease;
+    if (count > IOS_MAX_WINE_THREADS) count = IOS_MAX_WINE_THREADS;
+    for (int i = 0; i < count; ++i)
+    {
+        uintptr_t teb;
+        thread_t candidate;
+        void *trampoline;
+        if (!ios_thread_registry_snapshot(i, &teb, &candidate, &trampoline) || teb != target) continue;
+        if (!ios_thread_registry_acquire(i, &lease.value))
+        {
