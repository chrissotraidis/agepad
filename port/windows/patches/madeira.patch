+            status = create_view(&view, pool, agepad_jit_capacity,
+                                VPROT_SYSTEM | VPROT_COMMITTED | VPROT_READ | VPROT_WRITE | VPROT_EXEC);
+            if (status) { munmap(pool, agepad_jit_capacity); break; }
