+static unsigned long long agepad_jit_full_flushes, agepad_jit_explicit_flushes;
+static struct { void *base; SIZE_T size; BOOL released; void *owner; BOOL reusable; } agepad_jit_chunks[4096];
+extern BOOL agepad_signed_owner_registered(void *owner);
+static unsigned int agepad_jit_count;
+/* Requires virtual_mutex, blocked server signals and an active JIT write scope.
+ * Only exact full releases qualify; partial release markers stay quarantined.
+ * Reuse stays within the owning pseudo-process and never splits a chunk. */
+static void *agepad_jit_reuse_chunk(void *owner, SIZE_T size)
+{
+    for (unsigned int i = 0; i < agepad_jit_count; ++i)
+    {
+        if (agepad_jit_chunks[i].owner != owner || !agepad_jit_chunks[i].released ||
+            !agepad_jit_chunks[i].reusable || agepad_jit_chunks[i].size != size) continue;
+        void *base = agepad_jit_chunks[i].base;
+        memset(base, 0, size);
+        __builtin___clear_cache(base, (char *)base + size);
+        agepad_jit_chunks[i].released = FALSE;
+        agepad_jit_chunks[i].reusable = FALSE;
+        return base;
+    }
+    return NULL;
