+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+/* Portable unicast subset of Wine nsiproxy.sys/ip.c at pinned repository revision. */
+#include "config.h"
+#include <sys/types.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <ifaddrs.h>
+#include "ntstatus.h"
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#define USE_WS_PREFIX
+#include "winsock2.h"
+#include "ws2ipdef.h"
+#include "ifdef.h"
+#include "nldef.h"
+#include "netiodef.h"
+#include "wine/nsi.h"
+#include "wine/debug.h"
+#include "../../wine/dlls/nsiproxy.sys/unix_private.h"
+WINE_DEFAULT_DEBUG_CHANNEL(nsi);
+static inline UINT nsi_popcount( UINT m )
+{
+#ifdef HAVE___BUILTIN_POPCOUNT
+    return __builtin_popcount( m );
+#else
+    m -= m >> 1 & 0x55555555;
+    m = (m & 0x33333333) + (m >> 2 & 0x33333333);
+    return ((m + (m >> 4)) & 0x0f0f0f0f) * 0x01010101 >> 24;
+#endif
+}
+
+static UINT mask_v4_to_prefix( struct in_addr *addr )
+{
+    return nsi_popcount( addr->s_addr );
+}
+
+static UINT mask_v6_to_prefix( struct in6_addr *addr )
+{
+    UINT ret;
+
+    ret = nsi_popcount( *(UINT *)addr->s6_addr );
+    ret += nsi_popcount( *(UINT *)(addr->s6_addr + 4) );
+    ret += nsi_popcount( *(UINT *)(addr->s6_addr + 8) );
+    ret += nsi_popcount( *(UINT *)(addr->s6_addr + 12) );
+    return ret;
+}
+
+static ULONG64 get_boot_time( void )
+{
+    SYSTEM_TIMEOFDAY_INFORMATION ti;
+
+    NtQuerySystemInformation( SystemTimeOfDayInformation, &ti, sizeof(ti), NULL );
+    return ti.BootTime.QuadPart;
+}
+
+static void unicast_fill_entry( struct ifaddrs *entry, void *key, struct nsi_ip_unicast_rw *rw,
+                                struct nsi_ip_unicast_dynamic *dyn, struct nsi_ip_unicast_static *stat )
+{
+    struct nsi_ipv6_unicast_key placeholder, *key6 = key;
+    struct nsi_ipv4_unicast_key *key4 = key;
+    UINT scope_id = 0;
+
+    if (!key)
+    {
+        key6 = &placeholder;
+        key4 = (struct nsi_ipv4_unicast_key *)&placeholder;
+    }
+
+    convert_unix_name_to_luid( entry->ifa_name, &key6->luid );
+
+    if (entry->ifa_addr->sa_family == AF_INET)
+    {
+        memcpy( &key4->addr, &((struct sockaddr_in *)entry->ifa_addr)->sin_addr, sizeof(key4->addr) );
+        key4->pad = 0;
+    }
+    else if (entry->ifa_addr->sa_family == AF_INET6)
+    {
+        memcpy( &key6->addr, &((struct sockaddr_in6 *)entry->ifa_addr)->sin6_addr, sizeof(key6->addr) );
+        scope_id = ((struct sockaddr_in6 *)entry->ifa_addr)->sin6_scope_id;
+    }
+
+    if (rw)
+    {
+        rw->preferred_lifetime = 60000;
+        rw->valid_lifetime = 60000;
+
+        if (key6->luid.Info.IfType != IF_TYPE_SOFTWARE_LOOPBACK)
+        {
+            rw->prefix_origin = IpPrefixOriginDhcp;
+            rw->suffix_origin = IpSuffixOriginDhcp;
+        }
+        else
+        {
+            rw->prefix_origin = IpPrefixOriginManual;
+            rw->suffix_origin = IpSuffixOriginManual;
+        }
+        if (entry->ifa_netmask && entry->ifa_netmask->sa_family == AF_INET)
+            rw->on_link_prefix = mask_v4_to_prefix( &((struct sockaddr_in *)entry->ifa_netmask)->sin_addr );
+        else if (entry->ifa_netmask && entry->ifa_netmask->sa_family == AF_INET6)
+            rw->on_link_prefix = mask_v6_to_prefix( &((struct sockaddr_in6 *)entry->ifa_netmask)->sin6_addr );
+        else rw->on_link_prefix = 0;
+        rw->unk[0] = 0;
+        rw->unk[1] = 0;
+    }
+
+    if (dyn)
+    {
+        dyn->scope_id = scope_id;
+        dyn->dad_state = IpDadStatePreferred;
+    }
+
+    if (stat) stat->creation_time = get_boot_time();
+}
+
+static NTSTATUS ip_unicast_enumerate_all( int family, void *key_data, UINT key_size, void *rw_data, UINT rw_size,
+                                          void *dynamic_data, UINT dynamic_size,
+                                          void *static_data, UINT static_size, UINT_PTR *count )
+{
+    UINT num = 0;
+    NTSTATUS status = STATUS_SUCCESS;
+    BOOL want_data = key_size || rw_size || dynamic_size || static_size;
+    struct ifaddrs *addrs, *entry;
+
+    TRACE( "%p %d %p %d %p %d %p %d %p\n", key_data, key_size, rw_data, rw_size,
+           dynamic_data, dynamic_size, static_data, static_size, count );
+
+    if (getifaddrs( &addrs )) return STATUS_NO_MORE_ENTRIES;
+
+    for (entry = addrs; entry; entry = entry->ifa_next)
+    {
+        if (!entry->ifa_addr || entry->ifa_addr->sa_family != family) continue;
+
+        if (num < *count)
+        {
+            unicast_fill_entry( entry, key_data, rw_data, dynamic_data, static_data );
+            key_data = (BYTE *)key_data + key_size;
+            rw_data = (BYTE *)rw_data + rw_size;
+            dynamic_data = (BYTE *)dynamic_data + dynamic_size;
+            static_data = (BYTE *)static_data + static_size;
+        }
+        num++;
+    }
+
+    freeifaddrs( addrs );
+
+    if (!want_data || num <= *count) *count = num;
+    else status = STATUS_BUFFER_OVERFLOW;
+
+    return status;
+}
+
+static NTSTATUS ipv4_unicast_enumerate_all( void *key_data, UINT key_size, void *rw_data, UINT rw_size,
+                                            void *dynamic_data, UINT dynamic_size,
+                                            void *static_data, UINT static_size, UINT_PTR *count )
+{
+    return ip_unicast_enumerate_all( AF_INET, key_data, key_size, rw_data, rw_size,
+                                     dynamic_data, dynamic_size, static_data, static_size, count );
+}
+
+static NTSTATUS ipv6_unicast_enumerate_all( void *key_data, UINT key_size, void *rw_data, UINT rw_size,
+                                            void *dynamic_data, UINT dynamic_size,
+                                            void *static_data, UINT static_size, UINT_PTR *count )
+{
+    return ip_unicast_enumerate_all( AF_INET6, key_data, key_size, rw_data, rw_size,
+                                     dynamic_data, dynamic_size, static_data, static_size, count );
+}
+
+
+NTSTATUS agepad_unicast_enumerate(struct nsi_enumerate_all_ex *p, BOOL ipv6)
+{
+    UINT key_size = ipv6 ? sizeof(struct nsi_ipv6_unicast_key) : sizeof(struct nsi_ipv4_unicast_key);
+    if ((p->key_size && p->key_size != key_size) ||
+        (p->rw_size && p->rw_size != sizeof(struct nsi_ip_unicast_rw)) ||
+        (p->dynamic_size && p->dynamic_size != sizeof(struct nsi_ip_unicast_dynamic)) ||
+        (p->static_size && p->static_size != sizeof(struct nsi_ip_unicast_static))) return STATUS_INVALID_PARAMETER;
+    return ip_unicast_enumerate_all(ipv6 ? AF_INET6 : AF_INET,
+        p->key_size ? p->key_data : NULL, p->key_size,
+        p->rw_size ? p->rw_data : NULL, p->rw_size,
+        p->dynamic_size ? p->dynamic_data : NULL, p->dynamic_size,
+        p->static_size ? p->static_data : NULL, p->static_size, &p->count);
+}
diff --git a/build/ntdll-unix/nsi_routes_ios.c b/build/ntdll-unix/nsi_routes_ios.c
new file mode 100644
index 0000000..b296a73
--- /dev/null
+++ b/build/ntdll-unix/nsi_routes_ios.c
@@ -0,0 +1,112 @@
+/* Darwin route-dump to Wine NSI adapter. ABI offsets verified against the
+ * Xcode 26.5 macOS SDK net/route.h; iOS exposes sysctl but omits that header.
+ * Failure to read or decode the table remains a failure, not an empty result. */
+#include "config.h"
+#include <sys/types.h>
+#include <sys/socket.h>
+#include <sys/sysctl.h>
+#include <net/if.h>
+#include <netinet/in.h>
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "ntstatus.h"
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#define USE_WS_PREFIX
+#include "winsock2.h"
+#include "ws2ipdef.h"
+#include "ifdef.h"
+#include "nldef.h"
+#include "netiodef.h"
+#include "wine/nsi.h"
+#include "../../wine/dlls/nsiproxy.sys/unix_private.h"
+
+/* rt_msghdr is 92 bytes: length@0, version@2, type@3, index@4,
+ * flags@8, address bitmap@12, errno@24, metrics.hopcount@44. */
+static unsigned route_u32(const unsigned char *p) { unsigned v; memcpy(&v,p,4); return v; }
+static unsigned route_u16(const unsigned char *p) { unsigned short v; memcpy(&v,p,2); return v; }
+
+NTSTATUS agepad_route_enumerate(struct nsi_enumerate_all_ex *p, BOOL ipv6)
+{
+    int family = ipv6 ? AF_INET6 : AF_INET;
+    int mib[6] = {CTL_NET, PF_ROUTE, 0, family, NET_RT_DUMP, 0};
+    unsigned keysz = ipv6 ? sizeof(struct nsi_ipv6_forward_key) : sizeof(struct nsi_ipv4_forward_key);
+    unsigned dynsz = ipv6 ? sizeof(struct nsi_ipv6_forward_dynamic) : sizeof(struct nsi_ipv4_forward_dynamic);
+    size_t bytes=0, pos=0;
+    unsigned char *data;
+    UINT_PTR rows=0, capacity=p->count;
+    NTSTATUS status=STATUS_SUCCESS;
+    BOOL want=p->key_size||p->rw_size||p->dynamic_size||p->static_size;
+    if ((p->key_size && p->key_size!=keysz) ||
+        (p->rw_size && p->rw_size!=sizeof(struct nsi_ip_forward_rw)) ||
+        (p->dynamic_size && p->dynamic_size!=dynsz) ||
+        (p->static_size && p->static_size!=sizeof(struct nsi_ip_forward_static))) return STATUS_INVALID_PARAMETER;
+    if (sysctl(mib,6,NULL,&bytes,NULL,0)) {
+        dprintf(2,"[nsi-route] family=%d size-query errno=%d\n",family,errno);
+        return STATUS_NOT_SUPPORTED;
+    }
+    if (bytes>64*1024*1024) return STATUS_NO_MEMORY;
+    if (!bytes) {p->count=0;return STATUS_SUCCESS;}
+    data=malloc(bytes);if(!data)return STATUS_NO_MEMORY;
+    if(sysctl(mib,6,data,&bytes,NULL,0)){free(data);return STATUS_UNSUCCESSFUL;}
+    while(pos<bytes) {
+        const unsigned char *m=data+pos,*addr[8]={0};
+        unsigned len,flags,bitmap,i,off=92,prefix_len=0,index;
+        unsigned char prefix[16]={0},gateway[16]={0},mask[16]={0};
+        unsigned width=ipv6?16:4,addr_offset=ipv6?8:4;
+        char ifname[IF_NAMESIZE];NET_LUID luid;
+        BOOL have_mask=FALSE;
+        if(bytes-pos<92){status=STATUS_INVALID_PARAMETER;break;}
+        len=route_u16(m);if(len<92||len>bytes-pos){status=STATUS_INVALID_PARAMETER;break;}
+        flags=route_u32(m+8);bitmap=route_u32(m+12);index=route_u16(m+4);
+        if(m[2]!=5){status=STATUS_NOT_SUPPORTED;break;}
+        if(m[3]!=4 || route_u32(m+24) || !(flags&1) || (flags&8) || (flags&0x800000)) {pos+=len;continue;}
+        if(bitmap&~255u){status=STATUS_NOT_SUPPORTED;break;}
+        for(i=0;i<8;i++)if(bitmap&(1u<<i)) {
+            unsigned size,step;
+            if(off+2>len){status=STATUS_INVALID_PARAMETER;break;}
+            size=m[off];step=size?((size+3)&~3u):4;
+            if(step>len-off){status=STATUS_INVALID_PARAMETER;break;}
+            addr[i]=m+off;off+=step;
+        }
+        if(status)break;
+        if(!addr[0]||addr[0][1]!=family||addr[0][0]<addr_offset+width){pos+=len;continue;}
+        memcpy(prefix,addr[0]+addr_offset,width);
+        if(addr[1] && addr[1][1]==family && addr[1][0]>=addr_offset+width)
+            memcpy(gateway,addr[1]+addr_offset,width);
+        else if((flags&2) && addr[1]) {status=STATUS_NOT_SUPPORTED;break;}
+        if(addr[2]) {
+            unsigned available=addr[2][0]>addr_offset?addr[2][0]-addr_offset:0;
+            if(available>width){status=STATUS_INVALID_PARAMETER;break;}
+            memcpy(mask,addr[2]+(available?addr_offset:0),available);have_mask=TRUE;
+        }
+        if(flags&4)prefix_len=width*8;
+        else if(have_mask) {
+            BOOL zero=FALSE;unsigned bit;
+            for(i=0;i<width;i++)for(bit=128;bit;bit>>=1) {
+                if(mask[i]&bit){if(zero){status=STATUS_INVALID_PARAMETER;break;}prefix_len++;}
+                else zero=TRUE;
+            }
+            if(status)break;
+        }
+        if(!if_indextoname(index,ifname)||!convert_unix_name_to_luid(ifname,&luid)){status=STATUS_NOT_FOUND;break;}
+        if(want && rows<capacity) {
+            if(p->key_size) {
+                void *key=(BYTE *)p->key_data+rows*p->key_size;memset(key,0,p->key_size);
+                if(ipv6){struct nsi_ipv6_forward_key *k=key;k->luid=k->luid2=luid;k->prefix_len=prefix_len;memcpy(&k->prefix,prefix,16);memcpy(&k->next_hop,gateway,16);}
+                else {struct nsi_ipv4_forward_key *k=key;k->luid=k->luid2=luid;k->prefix_len=prefix_len;memcpy(&k->prefix,prefix,4);memcpy(&k->next_hop,gateway,4);}
+            }
+            if(p->rw_size){struct nsi_ip_forward_rw *rw=(void *)((BYTE *)p->rw_data+rows*p->rw_size);memset(rw,0,sizeof(*rw));rw->metric=route_u32(m+44);rw->protocol=(flags&2)?MIB_IPPROTO_NETMGMT:MIB_IPPROTO_LOCAL;rw->valid_lifetime=rw->preferred_lifetime=~0u;rw->immortal=1;rw->loopback=luid.Info.IfType==IF_TYPE_SOFTWARE_LOOPBACK;}
+            if(p->dynamic_size)memset((BYTE *)p->dynamic_data+rows*p->dynamic_size,0,p->dynamic_size);
+            if(p->static_size){struct nsi_ip_forward_static *st=(void *)((BYTE *)p->static_data+rows*p->static_size);st->origin=NlroManual;st->if_index=index;}
+        }
+        rows++;pos+=len;
+    }
+    free(data);
+    if(!status){if(!want||rows<=capacity)p->count=rows;else status=STATUS_BUFFER_OVERFLOW;}
+    dprintf(2,"[nsi-route] family=%d status=%x rows=%llu\n",family,(UINT)status,(unsigned long long)rows);
+    return status;
+}
