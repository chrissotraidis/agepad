+static struct ios_thread_lease ios_thread_lease_for_port(thread_t port)
+{
+    struct ios_thread_lease lease = {.slot = -1};
+    int count = __atomic_load_n(&ios_thread_count, __ATOMIC_SEQ_CST);
+    if (!port) return lease;
+    if (count > IOS_MAX_WINE_THREADS) count = IOS_MAX_WINE_THREADS;
+    for (int i = 0; i < count; ++i)
