+/* Called with virtual_mutex held and server signals blocked. The pool is a
+ * process-lifetime MAP_JIT mapping; snapshot its monotonic extent before dropping
+ * the metadata lock. Never restore signals until executable protection is back.
+ * Opt-in experiment: this does not reduce the range or omit any cache flush. */
+static void agepad_jit_flush_extent(void *pool, SIZE_T size, BOOL unlock_metadata)
+{
+    if (unlock_metadata) mutex_unlock(&virtual_mutex);
+    if (pool) __builtin___clear_cache(pool, (char *)pool + size);
+    agepad_jit_protect(1);
+    if (unlock_metadata) mutex_lock(&virtual_mutex);
+}
