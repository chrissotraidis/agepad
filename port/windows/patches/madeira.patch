+    lease.native = ios_thread_lease_for_teb(teb);
+    if (lease.native.slot < 0) return lease;
+    uint64_t *access = &ios_thread_registry[lease.native.slot].state_access;
+    uint64_t state = __atomic_load_n(access, __ATOMIC_SEQ_CST);
+    if ((state & IOS_THREAD_ACCESS_CLOSED) || (state & ~IOS_THREAD_ACCESS_CLOSED) == IOS_THREAD_ACCESS_CLOSED - 1 ||
