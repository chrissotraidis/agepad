+    if (!agepad_jit_protect) { status = STATUS_NOT_SUPPORTED; goto done; }
+    if (agepad_jit_owner && agepad_jit_owner != owner &&
+        (!getenv("AGEPAD_SIGNED_CHILD_NTDLL") || !agepad_signed_owner_registered(owner))) {
+        status = STATUS_ACCESS_DENIED; goto done;
+    }
+    switch (a->operation)
+    {
+    case 0: a->result = 0x4147504a495431ULL; break;
+    case 2:
