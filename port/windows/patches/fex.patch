+// Local Simulator experiment, not a physical-iPad JIT implementation.
+#pragma once
+extern bool agepad_cache_hit_explicit_flush;
+extern bool agepad_dispatch_pending_work;
+extern bool agepad_explicit_invalidation_flush;
+extern bool agepad_explicit_compile_flush;
+extern bool agepad_explicit_memory_flush;
+#if defined(__APPLE__) || (defined(_WIN32) && defined(FEX_IOS_HOST))
+extern void (*agepad_jit_write_enter)(void);
+extern void (*agepad_jit_write_leave)(void);
+extern void (*agepad_jit_write_leave_explicit)(void);
+extern "C" void agepad_set_jit_write_hooks(void (*enter)(void), void (*leave)(void));
+struct AgePadJITWriteScope {
+  void (*leave)(void);
+  AgePadJITWriteScope(bool explicitly_flushed = false, bool enabled = true)
+    : leave(enabled && agepad_jit_write_enter ? ((explicitly_flushed && agepad_jit_write_leave_explicit) ? agepad_jit_write_leave_explicit : agepad_jit_write_leave) : nullptr) {
+    if (leave) agepad_jit_write_enter();
+  }
+  ~AgePadJITWriteScope() { if (leave) leave(); }
+};
+#else
+struct AgePadJITWriteScope { AgePadJITWriteScope(bool = false, bool = true) {} };
+#endif
