+  uint64_t explicit_flush = 0;
+  if (!agepad_jit_call(6, 0, 0, &explicit_flush) && explicit_flush == 1) {
+    agepad_jit_write_leave_explicit = agepad_leave_explicit;
+    LogMan::Msg::IFmt("[AgePad-JIT] audited link flush optimization enabled");
+  }
+  LogMan::Msg::IFmt("[AgePad-JIT] native single-mapping service v1 verified");
+  return true;
+}
+#else
+bool FEX::Windows::UnixLib::InitAgePadJit() { return false; }
+#endif
