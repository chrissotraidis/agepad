+static NTSTATUS agepad_jit_call(uint32_t op, uint64_t address, uint64_t size, uint64_t* result = nullptr) {
+  AgePadJitArgs args {1, op, address, size, 0};
+  auto status = FEX::Windows::UnixLib::Call(FEXUnixLibFunctions::AgePadJitControl, &args);
+  if (result) *result = args.Result;
+  return status;
+}
+static void agepad_enter() { if (agepad_jit_call(2, 0, 0)) __builtin_trap(); }
+static void agepad_leave() { if (agepad_jit_call(3, 0, 0)) __builtin_trap(); }
+static void agepad_leave_explicit() { if (agepad_jit_call(7, 0, 0)) __builtin_trap(); }
+void* agepad_windows_jit_alloc(void* base, size_t size, bool commit) {
+  if (base || !commit) return nullptr;
+  uint64_t result {};
+  if (agepad_jit_call(1, 0, size, &result)) return nullptr;
+  return reinterpret_cast<void*>(result);
+}
+bool agepad_windows_jit_owns(void* ptr, size_t size) {
+  uint64_t result {};
+  if (agepad_jit_call(4, reinterpret_cast<uint64_t>(ptr), size, &result)) __builtin_trap();
+  return result != 0;
+}
+void agepad_windows_jit_release(void* ptr, size_t size) {
+  if (agepad_jit_call(5, reinterpret_cast<uint64_t>(ptr), size)) __builtin_trap();
+}
