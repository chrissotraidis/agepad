+inline uint64_t Hash16(const uint8_t* Bytes) {
+  uint64_t Hash = 14695981039346656037ULL;
+  for (unsigned i = 0; i < 16; ++i) Hash = (Hash ^ Bytes[i]) * 1099511628211ULL;
+  return Hash;
+}
+inline bool Arm(uint64_t Address, uint64_t End) {
+  Base.store(0, std::memory_order_release);
+  if (!Enabled || End < Address) return false;
+  for (const auto& Site : Sites) {
+    if (Site.RVA + 16 > End - Address ||
+        Hash16(reinterpret_cast<const uint8_t*>(Address + Site.RVA)) != Site.Hash) return false;
+  }
+  Base.store(Address, std::memory_order_release);
+  return true;
+}
+inline uint64_t Match(uint64_t Address) {
+  if (!Enabled) return 0;
+  const uint64_t Current = Base.load(std::memory_order_acquire);
+  if (!Current || Address < Current) return 0;
+  for (const auto& Site : Sites) {
+    if (Address - Current == Site.RVA &&
+        Hash16(reinterpret_cast<const uint8_t*>(Address)) == Site.Hash) return Site.RVA;
+  }
+  return 0;
+}
