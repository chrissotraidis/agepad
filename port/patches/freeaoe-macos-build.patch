+agepad::SaveBytes Building::saveProductionRuntime() const
+{
+    const auto owner=player().lock();
+    if(!owner)throw agepad::SaveError("Production owner unavailable");
+    agepad::SaveWriter writer;writer.u32(1);writer.i32(data()->ID);writer.i32(playerId());
+    writer.i64(m_lastUpdateTime);writer.f32(m_productionProgress);
+    writer.f32(waypoint.x);writer.f32(waypoint.y);writer.f32(waypoint.z);
+    auto writeProduct=[&](const Product &product){
+        writer.u32(product.type==Product::Unit ? 0 : 1);
+        if(product.type==Product::Unit){
+            if(!product.unit || &owner->civilization.unitData(product.unit->ID)!=product.unit)
+                throw agepad::SaveError("Production unit is outside owner catalog");
+            writer.i32(product.unit->ID);
+        }else{
+            const auto identity=researchIdentity(product.tech,*owner);
+            if(identity.id<0)throw agepad::SaveError("Production research is outside catalog");
+            writer.i32(identity.id);writer.u32(identity.origin);
+        }
+        std::vector<std::pair<int,float>> costs;
+        for(const auto &cost:product.cost)costs.emplace_back(int(cost.first),cost.second);
+        std::sort(costs.begin(),costs.end());writer.u32(costs.size());
+        for(const auto &cost:costs){writer.i32(cost.first);writer.f32(cost.second);}
+    };
+    writer.boolean(bool(m_currentProduct));if(m_currentProduct)writeProduct(*m_currentProduct);
+    if(m_productionQueue.size()>65536)throw agepad::SaveError("Production queue exceeds save limit");
+    writer.u32(m_productionQueue.size());for(const auto &product:m_productionQueue)writeProduct(*product);
+    return std::move(writer.bytes);
+}
+
+void Building::restoreProductionRuntime(const agepad::SaveBytes &bytes,Time simulationTime)
+{
+    if(m_currentProduct || !m_productionQueue.empty())throw agepad::SaveError("Production restore requires empty destination queue");
+    const auto owner=player().lock();if(!owner)throw agepad::SaveError("Production owner unavailable");
+    agepad::SaveReader reader(bytes);
+    if(reader.u32()!=1 || reader.i32()!=data()->ID || reader.i32()!=playerId())throw agepad::SaveError("Production identity mismatch");
+    const auto previous=reader.i64();const float progress=reader.f32();
+    MapPos rally;rally.x=reader.f32();rally.y=reader.f32();rally.z=reader.f32();
+    if(previous<0 || previous>simulationTime || progress<0)throw agepad::SaveError("Invalid production timeline");
+    for(float value:{rally.x,rally.y})if(double(value)<std::numeric_limits<std::int32_t>::min() || double(value)>std::numeric_limits<std::int32_t>::max())
+        throw agepad::SaveError("Production waypoint exceeds coordinate range");
+    auto readProduct=[&](){
+        auto product=std::make_unique<Product>();const auto kind=reader.u32();const int id=reader.i32();
+        if(id<0)throw agepad::SaveError("Invalid production catalog ID");
+        if(kind==0){
+            const auto &unit=owner->civilization.unitData(id);
+            if(unit.ID!=id)throw agepad::SaveError("Missing production unit");
+            product->type=Product::Unit;product->unit=&unit;
+        }else if(kind==1){
+            const auto origin=reader.u32();product->type=Product::Research;
+            if(origin==0){
+                const auto &techs=owner->civilization.availableTechs();const auto found=techs.find(id);
+                if(id>65535 || found==techs.end())throw agepad::SaveError("Missing civilization research");
+                product->tech=&found->second;
+            }else if(origin==1 && std::size_t(id)<DataManager::Inst().allTechs().size())product->tech=&DataManager::Inst().allTechs()[id];
+            else throw agepad::SaveError("Missing production research");
+        }else throw agepad::SaveError("Invalid production kind");
+        const auto count=reader.u32();if(count>65536)throw agepad::SaveError("Too many production costs");
+        int last=std::numeric_limits<int>::min();
+        for(std::uint32_t i=0;i<count;++i){
+            const int key=reader.i32();const float amount=reader.f32();
+            if(key < -32768 || key>32767 || key<=last)throw agepad::SaveError("Invalid production cost key");
+            last=key;product->cost.emplace(genie::ResourceType(key),amount);
+        }
+        return product;
+    };
+    std::unique_ptr<Product> current;if(reader.boolean())current=readProduct();
+    const auto count=reader.u32();if(count>65536)throw agepad::SaveError("Production queue exceeds save limit");
+    std::vector<std::unique_ptr<Product>> queue;
+    for(std::uint32_t i=0;i<count;++i)queue.push_back(readProduct());
+    reader.finish();
+    if(!current && progress!=0)throw agepad::SaveError("Progress without active product");
+    // No enqueue calls: costs were already paid in the saved economy. Retain
+    // recorded costs so cancellation refunds exactly what was originally paid.
+    m_lastUpdateTime=previous;m_productionProgress=progress;waypoint=rally;
+    m_currentProduct.swap(current);m_productionQueue.swap(queue);
+}
