+ActionPatrol::ActionPatrol(const std::shared_ptr<Unit> &unit,std::vector<MapPos> route,bool loop)
+    : IAction(Type::Patrol,unit,Task::move()),m_route(std::move(route)),m_loop(loop)
+{
+    if(!unit || !unit->map() || m_route.size()<2 || m_route.size()>256)
+        throw agepad::SaveError("Invalid patrol route");
+    for(const auto &point:m_route) {
+        agepad::SaveWriter finite;finite.f32(point.x);finite.f32(point.y);finite.f32(point.z);
+        if(!unit->map()->isValidPosition(point))throw agepad::SaveError("Patrol waypoint outside map");
+    }
+    m_engagement=m_route.front();
+}
+IAction::UnitState ActionPatrol::unitState() const
+{
+    if(!m_child)return Idle;
+    return m_child->type==Type::Move ? Moving : m_child->unitState();
+}
+float ActionPatrol::routeDistance(const MapPos &point) const
+{
+    float nearest=std::numeric_limits<float>::max();
+    const std::size_t segments=m_loop?m_route.size():m_route.size()-1;
+    for(std::size_t i=0;i<segments;++i) {
+        const auto &a=m_route[i];const auto &b=m_route[(i+1)%m_route.size()];
+        const float dx=b.x-a.x,dy=b.y-a.y,length=dx*dx+dy*dy;
+        const float t=length>0?std::clamp(((point.x-a.x)*dx+(point.y-a.y)*dy)/length,0.f,1.f):0.f;
+        nearest=std::min(nearest,point.distance(MapPos(a.x+t*dx,a.y+t*dy)));
+    }
+    return nearest;
+}
+void ActionPatrol::advanceWaypoint()
+{
+    if(m_loop){m_next=(m_next+1)%m_route.size();return;}
+    if(m_next==m_route.size()-1)m_reverse=true;
+    else if(m_next==0)m_reverse=false;
+    if(m_reverse)--m_next;else ++m_next;
+}
+IAction::UpdateResult ActionPatrol::update(Time time)
+{
+    const auto unit=m_unit.lock();if(!unit || !unit->map())return UpdateResult::Completed;
+    const auto owner=unit->player().lock();if(!owner)return UpdateResult::Completed;
+    const float sight=std::max(0.f,unit->data()->LineOfSight)*Constants::TILE_SIZE;
+    auto target=m_target.lock();
+    if(m_child && m_child->type==Type::Attack) {
+        // Stances can change while the order is running. Stand Ground patrols
+        // keep moving along their route instead of breaking off to pursue.
+        if(!target || target->healthLeft()<=0 || owner->diplomaticStance(target->playerId())!=Player::Enemy ||
+           unit->stance==Unit::Stance::NoAttack || unit->stance==Unit::Stance::StandGround ||
+           routeDistance(target->position())>sight || routeDistance(unit->position())>sight ||
+           (unit->stance==Unit::Stance::Defensive && target->position().distance(m_engagement)>sight)) {
+            m_child.reset();m_target.reset();m_returning=true;
+        } else {
+            const auto before=unit->position();
+            const auto result=m_child->update(time);
+            if(routeDistance(unit->position())>sight ||
+               (unit->stance==Unit::Stance::Defensive && unit->position().distance(m_engagement)>sight)) {
+                unit->setPosition(before);
+            } else if(result!=UpdateResult::Completed && result!=UpdateResult::Failed)return result;
+            m_child.reset();m_target.reset();m_returning=true;
+        }
+    }
+    if(!m_returning && unit->stance!=Unit::Stance::NoAttack && unit->stance!=Unit::Stance::StandGround) {
+        auto task=unit->actions.checkForAutoTargets(true);
+        target=task.target.lock();
+        if(target && routeDistance(target->position())<=sight) {
+            m_engagement=unit->position();m_target=target;
+            m_child=std::make_shared<ActionAttack>(unit,task);
+            return UpdateResult::Updated;
+        }
+    }
+    if(!m_child)m_child=ActionMove::moveUnitTo(unit,m_returning?m_engagement:m_route[m_next]);
+    if(!m_child)return UpdateResult::Failed;
+    const auto result=m_child->update(time);
+    if(result==UpdateResult::Completed) {
+        m_child.reset();
+        if(m_returning)m_returning=false;else advanceWaypoint();
+        return UpdateResult::Updated;
+    }
+    return result;
+}
+agepad::SaveBytes ActionPatrol::saveRuntime() const
+{
+    const auto unit=m_unit.lock();if(!unit)throw agepad::SaveError("Patrol owner unavailable");
+    agepad::SaveWriter w;w.u32(1);w.u64(unit->id);w.u32(m_route.size());
+    auto point=[&](const MapPos &p){w.f32(p.x);w.f32(p.y);w.f32(p.z);};
+    for(const auto &p:m_route)point(p);
+    w.u32(m_next);w.boolean(m_loop);w.boolean(m_reverse);w.boolean(m_returning);point(m_engagement);
+    w.u64(agepad::EntitySaveIndex::reference(m_target.lock()));w.boolean(bool(m_child));
+    if(m_child){w.u32(static_cast<std::uint32_t>(m_child->type));w.blob(m_child->saveRuntime());}
+    return std::move(w.bytes);
+}
+std::shared_ptr<ActionPatrol> ActionPatrol::fromRuntime(const agepad::SaveBytes &bytes,
+    const agepad::EntitySaveIndex &entities,Time time)
+{
+    agepad::SaveReader r(bytes);if(r.u32()!=1)throw agepad::SaveError("Unsupported patrol version");
+    const auto unit=entities.unit(r.u64());const auto count=r.u32();
+    if(count<2 || count>256)throw agepad::SaveError("Invalid patrol waypoint count");
+    auto point=[&](){MapPos p;p.x=r.f32();p.y=r.f32();p.z=r.f32();return p;};
+    std::vector<MapPos> route;for(std::uint32_t i=0;i<count;++i)route.push_back(point());
+    const auto next=r.u32();const bool loop=r.boolean(),reverse=r.boolean(),returning=r.boolean();
+    const auto engagement=point();const auto target=entities.unit(r.u64());ActionPtr child;
+    if(r.boolean()) {
+        const auto kind=static_cast<Type>(r.u32());
+        if(kind!=Type::Move && kind!=Type::Attack)throw agepad::SaveError("Invalid patrol child type");
+        child=IAction::fromRuntime(kind,r.blob(),entities,time);
+    }
+    r.finish();
+    auto action=std::make_shared<ActionPatrol>(unit,std::move(route),loop);
+    if(next>=count || (loop && reverse) || !unit->map()->isValidPosition(engagement) ||
+       (child && child->owner()!=unit) || (returning && child && child->type==Type::Attack))
+        throw agepad::SaveError("Invalid patrol phase");
+    action->m_next=next;action->m_reverse=reverse;action->m_returning=returning;
+    action->m_engagement=engagement;action->m_target=target;action->m_child=std::move(child);
+    return action;
+}
