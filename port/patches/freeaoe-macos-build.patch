+        changed=false;
+        for (std::size_t id=0;id<catalog.size();++id) {
+            const auto &research=catalog[id];
+            // Zero-prerequisite hidden records include age/building markers;
+            // those need their explicit scenario or building activation.
+            if (research.ResearchLocation!=-1 || research.RequiredTechCount<=0 ||
+                (research.Civ!=-1 && research.Civ!=civilization.id()) ||
+                m_completedResearch.count(id) || civilization.researchDisabled(id) || !researchRequirementsMet(research)) continue;
+            m_completedResearch.insert(id);
+            applyTechEffect(research.EffectID);
+            changed=true;
+        }
+    } while (changed);
     updateAvailableTechs();
 }
 
