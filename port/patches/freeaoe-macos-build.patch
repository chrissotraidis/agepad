+#pragma once
+#include <map>
+#include <utility>
+#include <vector>
+struct Player;
+namespace genie {class Tech;}
+class TechnologyTreeModel {
+public:
+    enum class Kind { Age, Building, Unit, Research };
+    enum class Reachability { Possible, Impossible, Unknown };
+    using Key=std::pair<Kind,int>;
+    struct Node {
+        Key key;
+        int age=-1,building=-1,line=-1,slot=0,enablingResearch=-1,upgradeResearch=-1;
+        bool visible=true,disabled=false,unlocked=false,researched=false,availabilityKnown=true;
+    };
+    using Edge=std::pair<Key,Key>;
+    explicit TechnologyTreeModel(const Player &player);
+    static int representedUnitId(const Player &player,Key key);
+    const std::vector<Node> &nodes() const {return m_nodes;}
+    const std::vector<Edge> &edges() const {return m_edges;}
+    const std::vector<Edge> &unresolvedEdges() const {return m_unresolvedEdges;}
+    const Node *find(Kind kind,int id) const;
+    Reachability researchReachability(int id) const;
+private:
+    Reachability resolveResearch(int id) const;
+    const Player &m_player;
+    const std::vector<genie::Tech> &m_research;
+    std::vector<Node> m_nodes;
+    std::map<Key,std::size_t> m_index;
+    std::vector<Edge> m_edges,m_unresolvedEdges;
+    mutable std::vector<int> m_reachability;
+    std::map<int,std::vector<int>> m_buildingMarkers;
+};
