diff --git a/src/resource/HdTerrainSampling.h b/src/resource/HdTerrainSampling.h
new file mode 100644
index 0000000..886215f
--- /dev/null
+++ b/src/resource/HdTerrainSampling.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include <SFML/Graphics/Image.hpp>
+#include <stdexcept>
+
+// HD stores a square texture with a one-pixel border and overlapping cells.
+// Screen coordinates below are relative to the flat 97x49 terrain diamond;
+// map tile spacing remains 96x48. No slope or lighting transformation here.
+class HdTerrainSampling {
+public:
+    HdTerrainSampling(const sf::Image &image, int columns, int rows)
+        : m_image(image), m_columns(columns), m_rows(rows)
+    {
+        const auto size = image.getSize();
+        if (columns <= 0 || rows <= 0 || size.x < unsigned(columns + 2)
+                || size.y < unsigned(rows + 2)
+                || (size.x - 2) % columns || (size.y - 2) % rows)
+            throw std::runtime_error("Unsupported HD terrain texture/grid dimensions");
+        m_stepX = (size.x - 2) / columns;
+        m_stepY = (size.y - 2) / rows;
+    }
+
+    sf::Color sample(int frame, int screenX, int screenY) const
+    {
+        if (frame < 0 || frame >= m_columns * m_rows)
+            throw std::out_of_range("HD terrain frame out of range");
+        // Twice the local world coordinates: inverse of (u+v, (v-u)/2).
+        const int u2 = screenX - 2 * screenY + 48;
+        const int v2 = screenX + 2 * screenY - 48;
+        if (u2 < 0 || u2 > 96 || v2 < 0 || v2 > 96)
+            throw std::out_of_range("HD terrain sample outside diamond");
+        const unsigned x = 1 + (frame / m_rows) * m_stepX + u2 * m_stepX / 96;
+        const unsigned y = 1 + (frame % m_rows) * m_stepY + v2 * m_stepY / 96;
+        return m_image.getPixel(x, y);
+    }
+
+private:
+    const sf::Image &m_image;
+    int m_columns, m_rows;
+    unsigned m_stepX, m_stepY;
+};
