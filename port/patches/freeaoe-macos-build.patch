 {
+    // Information-screen bindings verified against the supplied HD profile.
+    if(event.key.code==sf::Keyboard::F2 && !event.key.alt && !event.key.control && !event.key.system && !event.key.shift) {
+        cancelInteraction();showMenu();
+        if(m_currentDialog)m_currentDialog->showTechnologyTree(state);
+        return true;
+    }
+    if(event.key.code==sf::Keyboard::O && event.key.alt && !event.key.control && !event.key.system && !event.key.shift) {
+        cancelInteraction();showMenu();
+        if(m_currentDialog)m_currentDialog->showReports(state->missionReports());
+        return true;
+    }
+    if(event.key.code==sf::Keyboard::D && event.key.alt && !event.key.control && !event.key.system) {
+        cancelInteraction();showMenu();
+        if(m_currentDialog)m_currentDialog->showDiplomacy(state);
+        return true;
+    }
+    if(event.key.code>=sf::Keyboard::Num0 && event.key.code<=sf::Keyboard::Num9 && !event.key.alt && !event.key.system) {
+        const int digit=event.key.code-sf::Keyboard::Num0;
+        const int slot=(digit+9)%10;
+        cancelInteraction();
