+    state->scenario_=scenario;state->m_scenarioController->setScenario(scenario);
+    state->m_scenarioController->restoreRuntime(triggers,time);
+    state->result=Result(result);state->m_gameType=GameType(type);
+    // Scenario initialization can snap an edge building onto the excluded
+    // far edge (El Cid 3 wall spawn3609). Preserve those saved records only
+    // at their exact authored identity and initialized position. Ownership
+    // may change through conversion or triggers. Runtime-created
+    // or moved out-of-map units still fail normal activation validation.
+    std::unordered_set<const Unit*> authoredOutside;
+    for(const auto &unit:graph.records) {
+        if(state->map_->isValidPosition(unit->position())) continue;
+        for(const auto &group:scenario->playerUnits) for(const auto &entry:group.units) {
+            MapPos authored(entry.positionY*Constants::TILE_SIZE,
+                                  entry.positionX*Constants::TILE_SIZE,
+                                  entry.positionZ*DataManager::Inst().terrainBlock().ElevHeight);
+            if(unit->isBuilding()) authored=state->map_->snapPositionToGrid(authored,unit->clearanceSize());
+            if(unit->spawnId==entry.spawnID && unit->data()->ID==entry.objectID && unit->position()==authored) {
