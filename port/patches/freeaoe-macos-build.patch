+int DiplomacyPanel::hit(const ScreenPos &point) const
+{
+    if(ScreenRect(m_origin.x+35,m_origin.y+376,215,30).contains(point))return 1003;
+    for(int i=0;i<3;++i)if(m_footer[i].rect.contains(point))return 1000+i;
+    for(std::size_t i=0;i<m_cells.size();++i)if(m_cells[i].contains(point))return int(i);
+    return -1;
+}
+bool DiplomacyPanel::activate(int control,bool subtract)
+{
+    m_error.clear();
+    if(control==1003) {m_session.setAlliedVictory(!m_session.alliedVictory());return false;}
+    if(control==1002)return true;
+    if(control==1001) {m_session.clearTributes();return false;}
+    if(control==1000)return m_session.commit(m_error);
+    if(control<0 || std::size_t(control)>=m_cells.size())return false;
+    const auto &row=m_session.rows()[control/7];const int column=control%7;
+    if(column<3)m_session.setStance(row.playerId,stances[column]);
+    else m_session.incrementTribute(row.playerId,column-3,subtract);
+    return false;
+}
+bool DiplomacyPanel::handleEvent(const sf::Event &event, bool shiftHeld)
+{
+    if(event.type==sf::Event::KeyPressed) {
+        if(event.key.code==sf::Keyboard::Escape)return true;
+        if(event.key.code==sf::Keyboard::Return)return activate(1000,false);
+    }
+    if((event.type!=sf::Event::MouseButtonPressed && event.type!=sf::Event::MouseButtonReleased) || event.mouseButton.button!=sf::Mouse::Left)return false;
+    const int control=hit(ScreenPos(event.mouseButton.x,event.mouseButton.y));
+    if(event.type==sf::Event::MouseButtonPressed) {
+        m_pressed=control;for(int i=0;i<3;++i)m_footer[i].pressed=control==1000+i;
+        return false;
+    }
+    const bool matched=control>=0 && control==m_pressed;cancelInteraction();
+    return matched && activate(control,shiftHeld);
+}
