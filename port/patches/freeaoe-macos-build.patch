diff --git a/src/ui/TechnologyTreeLayout.cpp b/src/ui/TechnologyTreeLayout.cpp
new file mode 100644
index 0000000..b3d9c3c
--- /dev/null
+++ b/src/ui/TechnologyTreeLayout.cpp
@@ -0,0 +1,43 @@
+#include "TechnologyTreeLayout.h"
+#include <algorithm>
+#include <set>
+#include <tuple>
+
+TechnologyTreeLayout::TechnologyTreeLayout(const TechnologyTreeModel &model)
+{
+    using K=TechnologyTreeModel::Kind;
+    using Node=TechnologyTreeModel::Node;
+    std::vector<int> producers;
+    std::map<int,std::vector<const Node *>> groups;
+    // The Town Center introduces the economy and age advancement. Remaining
+    // building groups retain the authored tree order.
+    if(model.find(K::Building,109))producers.push_back(109);
+    for(const auto &node:model.nodes())if(node.visible && node.key.first==K::Building && node.key.second!=109)producers.push_back(node.key.second);
+    for(const auto &node:model.nodes()) {
+        if(!node.visible || node.key.first==K::Age)continue;
+        const int producer=node.key.first==K::Building?node.key.second:node.building;
+        if(std::find(producers.begin(),producers.end(),producer)==producers.end())producers.push_back(producer);
+        groups[producer].push_back(&node);
+    }
+    int column=0;
+    for(int producer:producers) {
+        auto found=groups.find(producer);if(found==groups.end())continue;
+        // Reserve a complete vertical lane at once. A collision in one age
+        // must never move only the base unit away from its upgrades.
+        using Lane=std::pair<K,int>;
+        std::map<Lane,std::vector<const Node *>> lanes;
+        for(const Node *node:found->second)lanes[{node->key.first,node->line>=0?node->line:node->key.second}].push_back(node);
+        for(const auto &lane:lanes) {
+            std::vector<std::set<int>> occupied;
+            for(const Node *node:lane.second) {
+                const int row=std::clamp(node->age-1,0,3)*2+std::clamp(node->slot-1,0,1);
+                std::size_t sub=0;while(sub<occupied.size() && occupied[sub].count(row))++sub;
+                if(sub==occupied.size())occupied.emplace_back();occupied[sub].insert(row);
+                m_positions[node->key]={float(column+sub)*80.f,float(row/2)*150.f+float(row%2)*70.f+5.f};
+            }
+            column+=int(occupied.size());
+        }
+        ++column; // Separate unrelated producer branches with an empty lane.
+    }
+    m_width=std::max(0,column-1)*80.f;
+}
