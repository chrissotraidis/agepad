--- /dev/null
+++ b/src/ui/TechnologyTreeDescription.cpp
@@ -0,0 +1,55 @@
+#include "TechnologyTreeDescription.h"
+#include "mechanics/Player.h"
+#include "resource/DataManager.h"
+#include "resource/LanguageManager.h"
+#include <map>
+#include <sstream>
+namespace {
+std::string number(float value){std::ostringstream out;out<<value;return out.str();}
+template<class Costs> std::string costs(const Costs &entries) {
+    const char *names[]={"food","wood","stone","gold"};std::string result;
+    for(const auto &entry:entries)if(entry.Type>=0 && entry.Amount>0) {
+        if(!result.empty())result+=", ";result+=number(entry.Amount)+" ";
+        result+=entry.Type<4?names[entry.Type]:entry.Type==4?"population space":"resource "+std::to_string(entry.Type);
+        if(!entry.Paid)result+=" (required)";
+    }
+    return result.empty()?"No resource cost":result;
+}
+}
+std::string agepad::technologyTreeDescription(const Player &player,TechnologyTreeModel::Key key)
+{
+    using K=TechnologyTreeModel::Kind;
+    std::map<std::string,std::string> tokens;int help=-1;unsigned fallback=0;std::string timing;
+    if(key.first==K::Research) {
+        const auto &tech=DataManager::Inst().getTech(key.second);help=tech.LanguageDLLHelp;fallback=tech.LanguageDLLDescription;
+        tokens["cost"]=costs(tech.ResourceCosts);timing="Research time: "+number(tech.ResearchTime)+" seconds";
+    } else if(key.first==K::Unit || key.first==K::Building) {
+        const auto &unit=player.civilization.unitData(TechnologyTreeModel::representedUnitId(player,key));help=unit.LanguageDLLHelp;fallback=unit.LanguageDLLCreation;
+        const auto &display=unit.Type==genie::Unit::BuildingType && unit.Building.StackUnitID>=0?player.civilization.unitData(player.upgradedUnitId(unit.Building.StackUnitID)):unit;
+        tokens["cost"]=costs(unit.Creatable.ResourceCosts);
+        tokens["hp"]="HP: "+number(display.HitPoints);
+        tokens["attack"]="Base attack: "+number(display.Combat.DisplayedAttack);
+        tokens["armor"]="Base armor: "+number(display.Combat.DisplayedMeleeArmour);
+        tokens["piercearmor"]="Base pierce armor: "+number(display.Creatable.DisplayedPierceArmour);
+        tokens["range"]="Base range: "+number(display.Combat.DisplayedRange);
+        tokens["garrison"]="Garrison: "+number(display.GarrisonCapacity);
+        timing=(key.first==K::Building?"Build time: ":"Train time: ")+number(unit.Creatable.TrainTime)+" seconds";
+    } else return {};
+    // Classic/HD encoded help IDs map to the 26000/28000 language banks.
+    std::string source=help>=100000?LanguageManager::getString(help-100000+21000):std::string{};
+    if(source.empty())source=LanguageManager::getString(fallback);
+    std::string text;
+    for(std::size_t i=0;i<source.size();) {
+        if(source[i]=='\\' && i+1<source.size() && source[i+1]=='n'){text+='\n';i+=2;continue;}
+        if(source[i]=='<') {
+            auto end=source.find('>',i+1);
+            if(end!=std::string::npos){const auto tag=source.substr(i+1,end-i-1);auto replacement=tokens.find(tag);
+                if(replacement!=tokens.end()){text+=replacement->second;if(tag!="cost")text+="; ";}
+                else if(tag!="b" && tag!="i" && tag!="BLUE" && tag!="RED" && tag!="YELLOW" && tag!="GREEN" && tag!="PURPLE" && tag!="ORANGE" && tag!="AQUA" && tag!="GREY" && tag!="WHITE")text+=source.substr(i,end-i+1);
+                i=end+1;continue;}
+        }
+        text+=source[i++];
+    }
+    if(text.empty())text="No description is supplied for this item.";
+    return text+"\n\n"+timing;
+}
