+    if(taskCount>4096)throw agepad::SaveError("Saved automatic tasks exceed limit");
+    TaskSet tasks;for(std::uint32_t i=0;i<taskCount;++i) {
+        auto task=Task::fromDescriptor(reader.blob(1024),entities);
+        if(!task.isValid() || tasks.contains(task))throw agepad::SaveError("Invalid or duplicate automatic task");
+        tasks.add(task);
+    }
+    reader.finish();
+    // Commit only after every action, link and descriptor has validated. Avoid
+    // setCurrentAction: restoring must not restart animation/task side effects.
+    m_currentAction=std::move(current);m_actionQueue=std::move(queue);
+    m_autoTargetTasks=std::move(tasks);autoConvert=convert;
+}
