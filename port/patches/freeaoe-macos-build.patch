+Unit::Ptr UnitFactory::restoreUnitBase(const agepad::SaveBytes &bytes,const Player::Ptr &owner,
+    UnitManager &manager,Time simulationTime)
+{
+    agepad::SaveReader identity(bytes);
+    if(identity.u32()!=1)throw agepad::SaveError("Unsupported unit base version");
+    const int id=identity.i32(),ownerID=identity.i32();const bool building=identity.boolean();
+    if(!owner || ownerID!=owner->playerId || id<0)throw agepad::SaveError("Saved unit owner or catalog identity invalid");
+    const auto &data=owner->civilization.unitData(id);
+    if(data.ID!=id)throw agepad::SaveError("Saved unit catalog entry unavailable");
+    if(building && data.Type!=genie::Unit::BuildingType)throw agepad::SaveError("Saved building has non-building catalog type");
+    constexpr auto mode=Unit::CreationMode::RestoreStaging;
+    Unit::Ptr unit;
+    if(building && id==Unit::Farm)unit=std::make_shared<Farm>(data,owner,manager,mode);
+    else if(building)unit=std::make_shared<Building>(data,owner,manager,mode);
+    else unit=std::make_shared<Unit>(data,owner,manager,mode);
+    unit->restoreBaseRuntime(bytes,simulationTime);
+    return unit;
+}
