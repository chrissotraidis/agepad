+agepad::SaveBytes GameState::saveRuntime(Time time,const std::string &scenarioIdentity) const
+{
+    if(time<0 || !m_humanPlayer || !map_ || !renderTarget_ || bool(scenario_)!=!scenarioIdentity.empty())
+        throw agepad::SaveError("Incomplete game snapshot identity");
+    agepad::SaveWriter w;w.u32(1);w.i64(time);
+    auto string=[&](const std::string &value){w.blob(agepad::SaveBytes(value.begin(),value.end()),65536);};
+    string(scenarioIdentity);w.i32(int(result));w.i32(int(m_gameType));w.i32(m_humanPlayer->playerId);
+    const auto camera=m_hasRestoredCamera ? m_restoredCamera : renderTarget_->camera()->targetPosition();w.f32(camera.x);w.f32(camera.y);w.f32(camera.z);
+    w.blob(map_->saveTerrain());
+    if(m_players.empty() || m_players.size()>256)throw agepad::SaveError("Invalid game roster");
+    w.u32(m_players.size());
+    for(std::size_t i=0;i<m_players.size();++i) {
+        const auto &p=m_players[i];if(!p || p->playerId!=int(i))throw agepad::SaveError("Non-indexed game roster");
+        w.i32(p->playerId);w.i32(p->civilization.id());w.i32(p->civilization.gaiaOverrideCiv());
+        string(p->name);w.i32(p->playerColor);w.boolean(p->alive);
+        w.blob(p->civilization.saveUnitAttributes());w.blob(p->saveResearchState());w.blob(p->saveEconomyDiplomacy());
+        w.blob(p->visibility->saveRuntime());w.blob(p->saveUnitMembership());
+    }
+    std::vector<std::pair<int,int>> prices;
+    for(const auto &[type,price]:m_tradingPrices)prices.emplace_back(int(type),price);
+    std::sort(prices.begin(),prices.end());w.u32(prices.size());
+    for(const auto &[type,price]:prices){w.i32(type);w.i32(price);}
+    w.blob(agepad::UnitGraphSave::save(m_unitManager->units()));
+    w.blob(agepad::UnitGraphSave::saveEffects(*m_unitManager));w.blob(agepad::UnitGraphSave::saveManager(*m_unitManager));
+    w.blob(m_scenarioController->saveRuntime());return std::move(w.bytes);
