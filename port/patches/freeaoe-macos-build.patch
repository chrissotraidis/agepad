+++ b/src/mechanics/Diplomacy.cpp
@@ -0,0 +1,112 @@
+#include "Diplomacy.h"
+#include "GameState.h"
+#include "UnitManager.h"
+#include "Unit.h"
+#include "audio/AudioPlayer.h"
+#include <cmath>
+#include <bit>
+#include <algorithm>
+#include <limits>
+namespace { bool finite(float value) { return (std::bit_cast<std::uint32_t>(value)&0x7f800000u)!=0x7f800000u; } }
+
+DiplomacySession::DiplomacySession(std::shared_ptr<GameState> state):m_state(std::move(state))
+{
+    auto human=m_state->humanPlayer();
+    m_alliedVictory=human->alliedVictory;
+    for(std::size_t id=1;id<m_state->playerCount();++id) {
+        auto other=m_state->player(id);
+        const auto stance=human->diplomaticStance(id);
+        m_rows.push_back({int(id),stance,stance,other->diplomaticStance(human->playerId),{}});
+    }
+}
+std::shared_ptr<Player> DiplomacySession::player(int id) const {return id<0?nullptr:m_state->player(id);}
+int DiplomacySession::humanId() const {return m_state->humanPlayer()->playerId;}
+bool DiplomacySession::locked() const {return m_state->diplomacyLocked();}
+bool DiplomacySession::hasMarket() const
+{
+    auto human=m_state->humanPlayer();
+    for(const auto &unit:m_state->unitManager()->units())
+        if(unit->playerId()==human->playerId && unit->isAlive() && unit->creationProgress()>=1.f &&
+           unit->data()->Type==genie::Unit::BuildingType && human->civilization.matchesBuildingReference(unit->data()->ID,84))return true;
+    return false;
+}
+float DiplomacySession::taxRate() const {return m_state->humanPlayer()->resourcesAvailable(genie::ResourceType::TributeInefficiency);}
+std::array<float,4> DiplomacySession::costs() const
+{
+    std::array<float,4> total{};
+    for(const auto &row:m_rows)for(int r=0;r<4;++r)if(row.tribute[r]>0)total[r]+=row.tribute[r]*(1.f+taxRate());
+    return total;
+}
+std::array<float,4> DiplomacySession::remaining() const
+{
+    auto result=costs();auto human=m_state->humanPlayer();
+    for(int r=0;r<4;++r)result[r]=human->resourcesAvailable(resources[r])-human->resourcesUsed(resources[r])-result[r];
+    return result;
+}
+bool DiplomacySession::incrementTribute(int id,int resource,bool subtract)
+{
+    if(resource<0 || resource>=4)return false;
+    for(const auto &row:m_rows)if(row.playerId==id) {
+        const int current=row.tribute[resource];
+        if(subtract)return setTribute(id,resource,std::max(0,current-100));
+        const float rate=taxRate(),available=remaining()[resource];
+        if(!finite(rate) || rate<0 || !finite(available) || available<=0)return false;
+        int increment=int(std::min(100.f,std::floor(available/(1.f+rate))));
+        while(increment>0 && increment*(1.f+rate)>available)--increment;
+        if(increment<=0 || current>std::numeric_limits<int>::max()-increment)return false;
+        return setTribute(id,resource,current+increment);
+    }
+    return false;
+}
+bool DiplomacySession::setStance(int id,Player::DiplomaticStance stance)
+{
+    if(locked() || id==humanId() || (stance!=Player::Allied && stance!=Player::Neutral && stance!=Player::Enemy))return false;
+    for(auto &row:m_rows)if(row.playerId==id) {row.stance=stance;return true;}
+    return false;
+}
+bool DiplomacySession::setTribute(int id,int resource,int amount)
+{
+    if(id==humanId() || resource<0 || resource>=4 || amount<0 || !hasMarket())return false;
+    if(locked() && !m_state->humanPlayer()->isAllied(id))return false;
+    for(auto &row:m_rows)if(row.playerId==id) {row.tribute[resource]=amount;return true;}
+    return false;
+}
+void DiplomacySession::clearTributes() {for(auto &row:m_rows)row.tribute.fill(0);}
+bool DiplomacySession::commit(std::string &error)
+{
+    error.clear();
+    auto human=m_state->humanPlayer();
+    bool sending=false;
+    for(const auto &row:m_rows) {
+        if(row.stance!=row.original && locked()) {error="Teams are locked.";return false;}
+        for(int amount:row.tribute)if(amount>0) {
+            if(locked() && !human->isAllied(row.playerId)) {error="With locked teams, tribute can only be sent to allies.";return false;}
+            sending=true;
+        }
+    }
+    if(sending && !hasMarket()) {error="You need a Market to pay tribute.";return false;}
+    if(sending && (!finite(taxRate()) || taxRate()<0)) {error="Invalid tribute cost.";return false;}
+    const auto total=costs();
+    for(int r=0;r<4;++r)if(!finite(total[r]) || (total[r]>0 && total[r]>human->resourcesAvailable(resources[r])-human->resourcesUsed(resources[r]))) {
+        error="You do not have enough resources for this tribute.";return false;
+    }
+    // Validate every row and the aggregate cost before changing any player.
+    for(const auto &row:m_rows)if(!player(row.playerId)) {error="Player is no longer available.";return false;}
+    for(int r=0;r<4;++r)if(total[r]>0)human->removeResource(resources[r],total[r]);
+    for(auto &row:m_rows) {
+        auto other=player(row.playerId);
+        if(row.stance!=row.original)human->setDiplomaticStance(row.playerId,row.stance);
+        float received=0;
+        for(int r=0;r<4;++r)if(row.tribute[r]) {other->addResource(resources[r],row.tribute[r]);received+=row.tribute[r];}
+        if(received>0) {
+            human->addResource(genie::ResourceType::TributeSent,received);
+            other->addResource(genie::ResourceType::TotalTributeReceived,received);
+            if(row.playerId<=8)human->addResource(genie::ResourceType(int(genie::ResourceType::P1Tribute)+row.playerId-1),received);
+            if(humanId()<=8)other->addResource(genie::ResourceType(int(genie::ResourceType::TributefromP1)+humanId()-1),received);
+        }
+        row.original=row.stance;row.tribute.fill(0);
+    }
+    human->alliedVictory=m_alliedVictory;
+    if(sending)AudioPlayer::instance().playSound(AudioPlayer::TributeSound);
+    return true;
+}
