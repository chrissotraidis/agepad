+agepad::SaveBytes Player::saveUnitMembership() const
+{
+    constexpr std::size_t limit=65536;
+    if(m_units.size()>limit || m_unitGroups.size()>limit)throw agepad::SaveError("Player membership exceeds limit");
+    agepad::SaveWriter w;w.u32(1);w.i32(playerId);
+    std::vector<std::uint64_t> ids;
+    for(auto *unit:m_units) {
+        if(!unit || unit->player().lock().get()!=this)throw agepad::SaveError("Invalid live player member");
+        ids.push_back(unit->id);
+    }
+    std::sort(ids.begin(),ids.end());w.u32(ids.size());for(auto id:ids)w.u64(id);
+    std::unordered_set<Unit*> grouped;w.u32(m_unitGroups.size());
+    for(const auto &group:m_unitGroups) {
+        ids.clear();
+        for(auto *unit:group) {
+            if(!m_units.contains(unit) || !grouped.insert(unit).second)
+                throw agepad::SaveError("Invalid or repeated player group member");
+            ids.push_back(unit->id);
+        }
+        std::sort(ids.begin(),ids.end());w.u32(ids.size());for(auto id:ids)w.u64(id);
+    }
+    if(grouped.size()!=m_units.size())throw agepad::SaveError("Player member missing group");
+    return std::move(w.bytes);
+}
+
+Player::PreparedUnitMembership Player::prepareUnitMembership(const agepad::SaveBytes &bytes,
+    const agepad::EntitySaveIndex &index) const
+{
+    constexpr std::uint32_t limit=65536;
+    agepad::SaveReader r(bytes);
+    if(r.u32()!=1 || r.i32()!=playerId)throw agepad::SaveError("Saved player membership identity mismatch");
+    auto count=[&](){auto n=r.u32();if(n>limit)throw agepad::SaveError("Saved membership count exceeds limit");return n;};
+    PreparedUnitMembership result;
+    std::uint64_t previous=0;bool first=true;
+    for(auto n=count();n;--n) {
+        const auto id=r.u64();if(!first && id<=previous)throw agepad::SaveError("Unordered or duplicate player member");
+        first=false;previous=id;auto unit=index.unit(id);
+        if(!unit || !unit->isRestoreStaging() || unit->player().lock().get()!=this)
+            throw agepad::SaveError("Player member does not belong to staged owner");
+        result.units.insert(unit.get());result.records.push_back(unit);
+    }
+    std::unordered_set<Unit*> grouped;
+    for(auto groups=count();groups;--groups) {
+        std::unordered_set<Unit*> group;first=true;previous=0;
+        for(auto n=count();n;--n) {
+            const auto id=r.u64();if(!first && id<=previous)throw agepad::SaveError("Unordered or duplicate group entry");
+            first=false;previous=id;auto unit=index.unit(id);
+            if(!unit || !result.units.contains(unit.get()) || !grouped.insert(unit.get()).second)
+                throw agepad::SaveError("Saved group has foreign or repeated member");
+            group.insert(unit.get());
+        }
+        result.groups.push_back(std::move(group));
+    }
+    r.finish();
+    if(grouped.size()!=result.units.size())throw agepad::SaveError("Saved player member has no group");
+    return result;
+}
