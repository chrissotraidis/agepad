+#pragma once
+#include "IAction.h"
+#include <vector>
+
+// The route remains the order while movement and combat are interruptible children.
+class ActionPatrol : public IAction {
+public:
+    ActionPatrol(const std::shared_ptr<Unit> &unit, std::vector<MapPos> route, bool loop=false);
+    UpdateResult update(Time time) override;
+    UnitState unitState() const override;
+    genie::ActionType taskType() const override { return genie::ActionType::MoveTo; }
+    agepad::SaveBytes saveRuntime() const override;
+    static std::shared_ptr<ActionPatrol> fromRuntime(const agepad::SaveBytes &,
+        const agepad::EntitySaveIndex &,Time);
+private:
+    float routeDistance(const MapPos &position) const;
+    void advanceWaypoint();
+    std::vector<MapPos> m_route;
+    std::size_t m_next=1;
+    bool m_loop=false, m_reverse=false, m_returning=false;
+    MapPos m_engagement;
+    std::weak_ptr<Unit> m_target;
+    ActionPtr m_child;
+};
