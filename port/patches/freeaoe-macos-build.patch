+void Engine::zoomAt(float factor,const ScreenPos &anchor,const std::shared_ptr<GameState> &state)
+{
+    auto camera=renderTarget_->camera();
+    const auto before=camera->absoluteMapPos(worldScreen(anchor));
+    const float zoom=std::clamp(m_worldZoom*factor,0.5f,2.f);
+    if(zoom==m_worldZoom) return;
