+        if(id!=int(i) || civ<0 || std::size_t(civ)>=civCount || gaia < -1 || (gaia>=0 && std::size_t(gaia)>=civCount))
+            throw agepad::SaveError("Invalid saved player identity");
+        auto p=std::make_shared<Player>(id,civ,state->map_);p->setEventsEnabled(false);
+        if(scenario && id>0 && std::size_t(id-1)<scenario->players.size())
