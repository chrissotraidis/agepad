+int Player::upgradedUnitId(int unitId) const
+{
+    // Derive upgrade chains from exact completed research; no additional save
+    // state or effect replay is needed when a world is restored.
+    std::vector<int> completed(m_completedResearch.begin(),m_completedResearch.end());
+    std::sort(completed.begin(),completed.end());
+    std::vector<int> visited;
+    while (std::find(visited.begin(),visited.end(),unitId)==visited.end()) {
+        visited.push_back(unitId);
+        int next=unitId;
+        for (const int researchId : completed) {
+            const int effectId=DataManager::Inst().getTech(researchId).EffectID;
+            if (effectId<0) continue;
+            for (const auto &command : DataManager::Inst().getEffect(effectId).EffectCommands)
+                if (command.Type==genie::EffectCommand::UpgradeUnit && command.TargetUnit==unitId && command.UnitClassID>=0)
+                    next=command.UnitClassID;
+        }
+        if (next==unitId) break;
+        unitId=next;
+    }
+    return unitId;
+}
