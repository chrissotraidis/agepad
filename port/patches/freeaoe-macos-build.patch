+Unit::Ptr UnitManager::selectNextIdleVillager()
+{
+    if(m_humanPlayer.expired() || m_units.empty())return nullptr;
+    std::size_t start=0;
+    if(!m_selectedUnits.isEmpty()) {
+        const auto found=std::find(m_units.begin(),m_units.end(),m_selectedUnits.first());
+        if(found!=m_units.end())start=(std::size_t(found-m_units.begin())+1)%m_units.size();
+    }
+    for(std::size_t offset=0;offset<m_units.size();++offset) {
+        const auto &unit=m_units[(start+offset)%m_units.size()];
+        if(!unit || unit->playerId()!=m_humanPlayerID || !unit->isAlive() ||
+           unit->data()->Class!=genie::Unit::Civilian || !unit->garrisonedIn.expired() ||
+           unit->actions.currentAction() || !unit->actions.m_actionQueue.empty())continue;
+        cancelPendingCommand();setSelectedUnits({unit});return unit;
+    }
+    return nullptr;
+}
+
+
+bool UnitManager::eligibleForControlGroup(const Unit::Ptr &unit) const
+{
+    return !m_humanPlayer.expired() && unit && unit->playerId() == m_humanPlayerID &&
+        unit->isAlive() && unit->garrisonedIn.expired() &&
+        std::find(m_units.begin(), m_units.end(), unit) != m_units.end();
+}
+
+UnitVector UnitManager::controlGroupUnits(int slot) const
+{
+    UnitVector result;
+    if (slot < 0 || slot >= ControlGroupCount) return result;
+    for (const auto &member : m_controlGroups[slot]) {
+        auto unit = member.lock();
+        if (eligibleForControlGroup(unit)) result.push_back(std::move(unit));
+    }
+    return result;
+}
+
+std::size_t UnitManager::controlGroupSize(int slot) const
+{
+    return controlGroupUnits(slot).size();
+}
+
+bool UnitManager::assignControlGroup(int slot, bool append)
+{
+    if (slot < 0 || slot >= ControlGroupCount) return false;
+    // Empty or enemy-only selections must not silently erase a useful group.
+    UnitSet members;
+    for (const auto &unit : m_selectedUnits)
+        if (eligibleForControlGroup(unit)) members.add(unit);
+    if (members.isEmpty()) return false;
+    auto &group = m_controlGroups[slot];
+    if (!append) group.clear();
+    for (const auto &unit : members) {
+        const auto found = std::find_if(group.begin(), group.end(),
+            [&](const std::weak_ptr<Unit> &old) { return old.lock() == unit; });
+        if (found == group.end()) group.push_back(unit);
+    }
+    return true;
+}
+
+bool UnitManager::recallControlGroup(int slot, bool append)
+{
+    const auto members = controlGroupUnits(slot);
+    if (members.empty()) return false;
+    UnitSet selection;
+    if (append) for (const auto &unit : m_selectedUnits)
+        if (eligibleForControlGroup(unit)) selection.add(unit);
+    for (const auto &unit : members) selection.add(unit);
+    cancelPendingCommand();
+    setSelectedUnits(selection.units);
+    return true;
+}
