@@ -0,0 +1,86 @@
+#pragma once
+#include "SaveFile.h"
+#include <bit>
+#include <limits>
+
+namespace agepad {
+// Explicit little-endian scalars. Never serialize native object layouts,
+// pointers, size_t, or enum storage. Floating checks use bits so fast-math
+// cannot optimize away malformed-save rejection.
+class SaveWriter {
+public:
+    SaveBytes bytes;
+    void u32(std::uint32_t value) {
+        room(4);
+        for (unsigned i=0; i<4; ++i) bytes.push_back((value >> (8*i)) & 255);
+    }
+    void u64(std::uint64_t value) {
+        room(8);
+        for (unsigned i=0; i<8; ++i) bytes.push_back((value >> (8*i)) & 255);
+    }
+    void i32(std::int32_t value) { u32(std::bit_cast<std::uint32_t>(value)); }
+    void i64(std::int64_t value) { u64(std::bit_cast<std::uint64_t>(value)); }
+    void blob(const SaveBytes &value, std::size_t limit=maxSaveBytes) {
+        if (value.size()>limit || value.size()>maxSaveBytes) throw SaveError("Saved blob exceeds limit");
+        room(value.size()+4);
+        u32(static_cast<std::uint32_t>(value.size()));
+        bytes.insert(bytes.end(),value.begin(),value.end());
+    }
+    void boolean(bool value) { u32(value ? 1 : 0); }
+    void f32(float value) {
+        static_assert(sizeof(float)==4 && std::numeric_limits<float>::is_iec559);
+        const auto bits=std::bit_cast<std::uint32_t>(value);
+        if ((bits & 0x7f800000u)==0x7f800000u) throw SaveError("Non-finite saved scalar");
+        u32(bits);
+    }
+private:
+    void room(std::size_t count) const {
+        if (bytes.size() > maxSaveBytes || count > maxSaveBytes - bytes.size()) throw SaveError("State section exceeds limit");
+    }
+};
+class SaveReader {
+public:
+    explicit SaveReader(const SaveBytes &bytes) : m_bytes(bytes) {
+        if (bytes.size()>maxSaveBytes) throw SaveError("State section exceeds limit");
+    }
+    std::uint32_t u32() {
+        need(4); std::uint32_t value=0;
+        for (unsigned i=0; i<4; ++i) value |= std::uint32_t(m_bytes[m_pos++]) << (8*i);
+        return value;
+    }
+    std::uint64_t u64() {
+        need(8); std::uint64_t value=0;
+        for (unsigned i=0; i<8; ++i) value |= std::uint64_t(m_bytes[m_pos++]) << (8*i);
+        return value;
+    }
+    std::int32_t i32() { return std::bit_cast<std::int32_t>(u32()); }
+    std::int64_t i64() { return std::bit_cast<std::int64_t>(u64()); }
+    SaveBytes blob(std::size_t limit=maxSaveBytes) {
+        const auto count=u32();
+        if (count>limit) throw SaveError("Saved blob exceeds limit");
+        need(count);
+        SaveBytes result(m_bytes.begin()+m_pos,m_bytes.begin()+m_pos+count);
+        m_pos+=count;
+        return result;
+    }
+    bool boolean() {
+        const auto value=u32();
+        if (value>1) throw SaveError("Invalid saved boolean");
+        return value!=0;
+    }
+    float f32() {
+        const auto bits=u32();
+        if ((bits & 0x7f800000u)==0x7f800000u) throw SaveError("Non-finite saved scalar");
+        return std::bit_cast<float>(bits);
+    }
+    void finish() const {
+        if (m_pos != m_bytes.size()) throw SaveError("Unexpected trailing state bytes");
+    }
+private:
+    const SaveBytes &m_bytes;
+    std::size_t m_pos=0;
+    void need(std::size_t count) const {
+        if (count > m_bytes.size()-m_pos) throw SaveError("Truncated state section");
+    }
+};
+}
diff --git a/src/core/SaveFile.cpp b/src/core/SaveFile.cpp
new file mode 100644
index 0000000..54a0d24
--- /dev/null
+++ b/src/core/SaveFile.cpp
@@ -0,0 +1,146 @@
+#include "SaveFile.h"
+
+#include <array>
+#include <cerrno>
+#include <cstring>
+#include <cstdio>
+#include <cstdlib>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <zlib.h>
+
+namespace agepad {
+namespace {
+constexpr std::array<std::uint8_t, 8> magic{'A','G','E','P','A','D','S',0};
+constexpr std::uint32_t envelopeVersion = 1;
+void put32(SaveBytes &out, std::uint32_t value) {
+    for (unsigned i = 0; i < 4; ++i) out.push_back((value >> (8 * i)) & 255);
+}
+struct Reader {
+    const SaveBytes &bytes;
+    std::size_t pos = 0;
+    void need(std::size_t count) const {
+        if (count > bytes.size() - pos) throw SaveError("Truncated save");
+    }
+    std::uint32_t u32() {
+        need(4);
+        std::uint32_t value = 0;
+        for (unsigned i = 0; i < 4; ++i) value |= std::uint32_t(bytes[pos++]) << (8 * i);
+        return value;
+    }
+    std::string identity() {
+        const auto count = u32();
+        if (!count || count > 4096) throw SaveError("Invalid save identity length");
+        need(count);
+        std::string value(bytes.begin() + pos, bytes.begin() + pos + count);
+        pos += count;
+        if (value.find('\0') != std::string::npos) throw SaveError("Invalid save identity");
+        return value;
+    }
+};
+void putIdentity(SaveBytes &out, const std::string &value) {
+    if (value.empty() || value.size() > 4096 || value.find('\0') != std::string::npos)
+        throw SaveError("Invalid save identity");
+    put32(out, static_cast<std::uint32_t>(value.size()));
+    out.insert(out.end(), value.begin(), value.end());
+}
+std::uint32_t checksum(const SaveBytes &bytes, std::size_t count) {
+    return static_cast<std::uint32_t>(crc32(0, bytes.data(), static_cast<uInt>(count)));
+}
+std::string ioError(const char *operation) {
+    return std::string(operation) + ": " + std::strerror(errno);
+}
+struct File {
+    int fd = -1;
+    explicit File(int descriptor) : fd(descriptor) {}
+    ~File() { if (fd >= 0) ::close(fd); }
+    File(const File &) = delete;
+    File &operator=(const File &) = delete;
+};
+}
+SaveBytes encodeSave(const SaveDocument &document) {
+    if (document.payload.size() > maxSaveBytes - 16384) throw SaveError("Save exceeds size limit");
+    if (!document.identity.schema) throw SaveError("Invalid simulation schema");
+    SaveBytes bytes(magic.begin(), magic.end());
+    put32(bytes, envelopeVersion);
+    put32(bytes, document.identity.schema);
+    putIdentity(bytes, document.identity.input);
+    putIdentity(bytes, document.identity.rules);
+    put32(bytes, static_cast<std::uint32_t>(document.payload.size()));
+    bytes.insert(bytes.end(), document.payload.begin(), document.payload.end());
+    put32(bytes, checksum(bytes, bytes.size()));
+    return bytes;
+}
+SaveDocument decodeSave(const SaveBytes &bytes, const SaveIdentity &expected) {
+    if (bytes.size() > maxSaveBytes) throw SaveError("Save exceeds size limit");
+    Reader reader{bytes};
+    reader.need(magic.size());
+    for (auto c : magic) if (bytes[reader.pos++] != c) throw SaveError("Invalid save signature");
+    if (reader.u32() != envelopeVersion) throw SaveError("Unsupported save envelope version");
+    SaveDocument document;
+    document.identity.schema = reader.u32();
+    document.identity.input = reader.identity();
+    document.identity.rules = reader.identity();
+    const auto count = reader.u32();
+    reader.need(4);
+    if (count != bytes.size() - reader.pos - 4) throw SaveError("Invalid save payload length");
+    const auto start = reader.pos;
+    reader.pos += count;
+    if (reader.u32() != checksum(bytes, bytes.size() - 4)) throw SaveError("Save checksum mismatch");
+    if (!document.identity.schema || document.identity != expected) throw SaveError("Incompatible save input, ruleset or simulation schema");
+    document.payload.assign(bytes.begin() + start, bytes.end() - 4);
+    return document;
+}
+SaveDocument readSave(const std::filesystem::path &path, const SaveIdentity &expected) {
+    File file(::open(path.c_str(), O_RDONLY | O_NOFOLLOW | O_NONBLOCK));
+    if (file.fd < 0) throw SaveError(ioError("Open save"));
+    struct stat info{};
+    if (::fstat(file.fd, &info) != 0) throw SaveError(ioError("Inspect save"));
+    if (!S_ISREG(info.st_mode) || info.st_size < 0 || std::uint64_t(info.st_size) > maxSaveBytes)
+        throw SaveError("Save must be a bounded regular file");
+    SaveBytes bytes(static_cast<std::size_t>(info.st_size));
+    std::size_t offset = 0;
+    while (offset < bytes.size()) {
+        const auto count = ::read(file.fd, bytes.data() + offset, bytes.size() - offset);
+        if (count < 0 && errno == EINTR) continue;
+        if (count < 0) throw SaveError(ioError("Read save"));
+        if (!count) throw SaveError("Save changed or was truncated during read");
+        offset += static_cast<std::size_t>(count);
+    }
+    std::uint8_t extra;
+    ssize_t count;
+    do { count = ::read(file.fd, &extra, 1); } while (count < 0 && errno == EINTR);
+    if (count != 0) throw SaveError("Save changed or failed during read");
+    return decodeSave(bytes, expected);
+}
+void writeSaveAtomic(const std::filesystem::path &path, const SaveDocument &document) {
+    const auto bytes = encodeSave(document); // Validate before touching the old save.
+    const auto parent = path.has_parent_path() ? path.parent_path() : std::filesystem::path(".");
+    File directory(::open(parent.c_str(), O_RDONLY | O_DIRECTORY));
+    if (directory.fd < 0) throw SaveError(ioError("Open save directory"));
+    std::string temporary = (parent / (path.filename().string() + ".tmp.XXXXXX")).string();
+    File file(::mkstemp(temporary.data()));
+    if (file.fd < 0) throw SaveError(ioError("Create save temporary file"));
+    bool renamed = false;
+    try {
+        std::size_t offset = 0;
+        while (offset < bytes.size()) {
+            const auto count = ::write(file.fd, bytes.data() + offset, bytes.size() - offset);
+            if (count < 0 && errno == EINTR) continue;
+            if (count <= 0) throw SaveError(ioError("Write save"));
+            offset += static_cast<std::size_t>(count);
+        }
+        if (::fsync(file.fd) != 0) throw SaveError(ioError("Sync save"));
+        const int descriptor = file.fd;
+        file.fd = -1;
+        if (::close(descriptor) != 0) throw SaveError(ioError("Close save"));
+        if (::rename(temporary.c_str(), path.c_str()) != 0) throw SaveError(ioError("Commit save"));
+        renamed = true;
+        if (::fsync(directory.fd) != 0) throw SaveError(ioError("Save committed; directory sync failed"));
+    } catch (...) {
+        if (!renamed) ::unlink(temporary.c_str());
+        throw;
+    }
+}
+}
diff --git a/src/core/SaveFile.h b/src/core/SaveFile.h
new file mode 100644
index 0000000..9c04574
--- /dev/null
+++ b/src/core/SaveFile.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace agepad {
+using SaveBytes = std::vector<std::uint8_t>;
+
+// The payload schema belongs to the simulation serializer, separately from the
+// storage envelope. Input/rules identities must come from verified runtime data.
+struct SaveIdentity {
+    std::string input;
+    std::string rules;
+    std::uint32_t schema = 0;
+    bool operator==(const SaveIdentity &) const = default;
+};
+struct SaveDocument {
+    SaveIdentity identity;
+    SaveBytes payload;
+};
+class SaveError : public std::runtime_error {
+public:
+    using std::runtime_error::runtime_error;
+};
+
+constexpr std::size_t maxSaveBytes = 256 * 1024 * 1024;
+SaveBytes encodeSave(const SaveDocument &document);
+SaveDocument decodeSave(const SaveBytes &bytes, const SaveIdentity &expected);
+SaveDocument readSave(const std::filesystem::path &path, const SaveIdentity &expected);
+// Writes a private sibling temporary file, syncs it, then atomically renames it.
+// A pre-rename failure preserves the old destination. A post-rename directory
+// sync failure is reported explicitly: the new save is visible but durability
+// cannot be promised. Leftover temporary files are never treated as saves.
+void writeSaveAtomic(const std::filesystem::path &path, const SaveDocument &document);
+}
diff --git a/src/core/SaveFingerprint.h b/src/core/SaveFingerprint.h
new file mode 100644
index 0000000..4858a3f
--- /dev/null
+++ b/src/core/SaveFingerprint.h
@@ -0,0 +1,61 @@
+#pragma once
+#include "SaveArchive.h"
+#include <filesystem>
+#include <fstream>
+#include <algorithm>
+#include <array>
+#ifdef __APPLE__
+#include <CommonCrypto/CommonDigest.h>
+#endif
+
+namespace agepad {
+class SaveFingerprint {
+public:
+    SaveFingerprint() {
+#ifdef __APPLE__
+        CC_SHA256_Init(&context);
+#else
+        throw SaveError("Save fingerprints require the Apple platform backend");
+#endif
+    }
+    void add(const void *data,std::size_t size) {
+#ifdef __APPLE__
+        const auto *p=static_cast<const unsigned char*>(data);
+        while(size){const auto n=std::min<std::size_t>(size,1<<20);CC_SHA256_Update(&context,p,CC_LONG(n));p+=n;size-=n;}
+#endif
+    }
+    std::string finish() {
+#ifdef __APPLE__
+        unsigned char bytes[CC_SHA256_DIGEST_LENGTH];CC_SHA256_Final(bytes,&context);
+        static const char hex[]="0123456789abcdef";std::string result;
+        for(auto b:bytes){result+=hex[b>>4];result+=hex[b&15];}return result;
+#else
+        throw SaveError("Save fingerprints unavailable");
+#endif
+    }
+    static std::string bytes(const SaveBytes &bytes) {SaveFingerprint h;h.add(bytes.data(),bytes.size());return h.finish();}
+    static std::string inputTree(const std::filesystem::path &root) {
+        std::vector<std::filesystem::path> files;
+        for(const auto &entry:std::filesystem::recursive_directory_iterator(root)) {
+            if(entry.is_symlink())throw SaveError("Input fingerprint requires a frozen tree without symbolic links");
+            if(entry.is_regular_file())files.push_back(entry.path());
+        }
+        std::sort(files.begin(),files.end());
+        if(files.empty())throw SaveError("Cannot fingerprint empty input tree");
+        SaveFingerprint h;std::array<char,65536> buffer;
+        for(const auto &file:files) {
+            const auto name=file.lexically_relative(root).generic_string();const auto length=std::filesystem::file_size(file);
+            SaveWriter record;record.blob(SaveBytes(name.begin(),name.end()),65536);record.u64(length);h.add(record.bytes.data(),record.bytes.size());
+            std::ifstream in(file,std::ios::binary);if(!in)throw SaveError("Cannot read input fingerprint file");
+            std::uint64_t read=0;
+            while(in){in.read(buffer.data(),buffer.size());const auto n=in.gcount();h.add(buffer.data(),n);read+=n;}
+            if(!in.eof() || read!=length)throw SaveError("Input changed while fingerprinting");
+        }
+        return h.finish();
+    }
+private:
+#ifdef __APPLE__
+    CC_SHA256_CTX context;
+#endif
+};
+}
diff --git a/src/core/SimulationClock.h b/src/core/SimulationClock.h
new file mode 100644
index 0000000..8462120
--- /dev/null
+++ b/src/core/SimulationClock.h
@@ -0,0 +1,30 @@
+#pragma once
+#include "SaveFile.h"
+#include <cstdint>
+#include <limits>
+
+namespace agepad {
+// Wall time is supplied by the platform. Saved game time excludes intervals
+// when simulation updates are paused. Loading sets a new wall-time origin.
+class SimulationClock {
+public:
+    void reset(std::int64_t savedTime, std::int64_t wallTime) {
+        if (savedTime < 0 || wallTime < 0) throw SaveError("Invalid simulation clock origin");
+        m_time = savedTime;
+        m_wall = wallTime;
+    }
+    std::int64_t sample(std::int64_t wallTime, bool running) {
+        if (wallTime < m_wall) throw SaveError("Simulation wall clock moved backward");
+        const auto delta = wallTime - m_wall;
+        if (running && delta > std::numeric_limits<std::int64_t>::max() - m_time)
+            throw SaveError("Simulation time overflow");
+        if (running) m_time += delta;
+        m_wall = wallTime;
+        return m_time;
+    }
+    std::int64_t time() const { return m_time; }
+private:
+    std::int64_t m_time = 0;
+    std::int64_t m_wall = 0;
+};
+}
diff --git a/src/core/SimulationRandom.h b/src/core/SimulationRandom.h
new file mode 100644
index 0000000..19f046f
--- /dev/null
+++ b/src/core/SimulationRandom.h
@@ -0,0 +1,31 @@
+#pragma once
+#include "SaveArchive.h"
+#include <stdexcept>
+
+namespace agepad {
+// Explicit minstd_rand transition: integer behavior and saved state do not
+// depend on the host C library's process-global rand implementation.
+class SimulationRandom {
+public:
+    std::uint32_t next() noexcept {
+        m_state=std::uint64_t(m_state)*48271u % 2147483647u;
+        return m_state;
+    }
+    std::uint32_t bounded(std::uint32_t limit) {
+        if(limit==0 || limit>2147483646u)throw std::invalid_argument("Invalid random bound");
+        return next()%limit;
+    }
+    SaveBytes saveRuntime() const {
+        SaveWriter writer;writer.u32(1);writer.u32(m_state);return std::move(writer.bytes);
+    }
+    void restoreRuntime(const SaveBytes &bytes) {
+        SaveReader reader(bytes);
+        if(reader.u32()!=1)throw SaveError("Unsupported simulation random version");
+        const auto state=reader.u32();reader.finish();
+        if(state==0 || state>=2147483647u)throw SaveError("Invalid simulation random state");
+        m_state=state;
+    }
+private:
+    std::uint32_t m_state=1;
+};
+}
diff --git a/src/core/TextWrap.h b/src/core/TextWrap.h
new file mode 100644
index 0000000..a6c6099
--- /dev/null
+++ b/src/core/TextWrap.h
@@ -0,0 +1,30 @@
+#pragma once
+#include <string>
+#include <vector>
+
+namespace agepad {
+// Break at spaces when possible, then at UTF-8 codepoint boundaries for a
+// single word wider than the viewport. The caller supplies actual font metrics.
+template<class Measure>
+std::vector<std::string> wrapText(const std::string &text, float width, Measure measure)
+{
+    std::vector<std::string> lines;
+    std::string line;
+    for(std::size_t start=0;start<text.size();) {
+        if(text[start]=='\n') { lines.push_back(line);line.clear();++start;continue; }
+        std::size_t end=start+1;
+        while(end<text.size() && (static_cast<unsigned char>(text[end])&0xc0)==0x80)++end;
+        auto next=text.substr(start,end-start);
+        if(!line.empty() && measure(line+next)>width) {
+            const auto space=line.find_last_of(" ");
+            if(space!=std::string::npos) {
+                lines.push_back(line.substr(0,space));line.erase(0,space+1);
+            } else { lines.push_back(line);line.clear(); }
+        }
+        if(!(line.empty() && next==" ")) line+=next;
+        start=end;
+    }
+    if(!line.empty())lines.push_back(line);
+    return lines;
+}
+}
