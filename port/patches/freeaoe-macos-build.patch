diff --git a/src/core/AppleUrl.mm b/src/core/AppleUrl.mm
new file mode 100644
index 0000000..fefa6bb
--- /dev/null
+++ b/src/core/AppleUrl.mm
@@ -0,0 +1,61 @@
+#include <string>
+#include <vector>
+#include <stdexcept>
+#import <UIKit/UIKit.h>
+#import <objc/runtime.h>
+
+// SFML 2.x only sets the deprecated application-wide status-bar property.
+// Add the modern preference to its controller, without changing UIKit globally.
+static BOOL agepadPrefersHiddenStatusBar(id, SEL) { return YES; }
+
+
+// Return whether UIKit accepted the request for dispatch, not browser completion.
+bool agepadOpenUrl(const std::string &url, std::string *error)
+{
+    NSString *text = [[NSString alloc] initWithBytes:url.data() length:url.size()
+                                          encoding:NSUTF8StringEncoding];
+    NSURL *target = text ? [NSURL URLWithString:text] : nil;
+    if (!target || !target.scheme.length) {
+        if (error) *error = "Invalid external URL";
+        return false;
+    }
+    __block BOOL accepted = NO;
+    void (^request)(void) = ^{
+        UIApplication *app = [UIApplication sharedApplication];
+        accepted = [app canOpenURL:target];
+        if (accepted) {
+            [app openURL:target options:@{} completionHandler:^(BOOL success) {
+                if (!success) NSLog(@"AgePad: external URL request failed");
+            }];
+        }
+    };
+    if ([NSThread isMainThread]) request();
+    else dispatch_sync(dispatch_get_main_queue(), request);
+    if (!accepted && error) *error = "No available handler for external URL";
+    return accepted;
+}
+
+std::vector<std::string> agepadAppleArguments()
+{
+    Class controller = NSClassFromString(@"SFViewController");
+    SEL preference = @selector(prefersStatusBarHidden);
+    Method inherited = class_getInstanceMethod([UIViewController class], preference);
+    if (controller && inherited)
+        class_addMethod(controller, preference, (IMP)agepadPrefersHiddenStatusBar, method_getTypeEncoding(inherited));
+    NSFileManager *files = [NSFileManager defaultManager];
+    NSURL *documents = [files URLForDirectory:NSDocumentDirectory inDomain:NSUserDomainMask
+                          appropriateForURL:nil create:YES error:nil];
+    if (!documents || ![files changeCurrentDirectoryPath:documents.path])
+        throw std::runtime_error("Cannot open writable app Documents directory");
+    std::vector<std::string> arguments;
+    for (NSString *argument in [NSProcessInfo processInfo].arguments)
+        arguments.emplace_back(argument.UTF8String);
+    bool hasGamePath = false;
+    for (const auto &argument : arguments)
+        if (argument == "--game-path" || argument.starts_with("--game-path=")) hasGamePath = true;
+    if (!hasGamePath) {
+        NSURL *data = [documents URLByAppendingPathComponent:@"GameData" isDirectory:YES];
+        arguments.emplace_back(std::string("--game-path=") + data.path.UTF8String);
+    }
+    return arguments;
+}
diff --git a/src/core/CampaignCatalog.h b/src/core/CampaignCatalog.h
new file mode 100644
index 0000000..79cc697
--- /dev/null
+++ b/src/core/CampaignCatalog.h
@@ -0,0 +1,58 @@
+#pragma once
+#include <filesystem>
+#include <string>
+#include <vector>
+
+namespace agepad {
+struct CampaignEntry {
+    std::string key;
+    std::string group;
+    std::string screen;
+    int titleString;
+    int firstMissionString;
+    unsigned missionCount;
+    std::filesystem::path archive;
+    bool available() const { return !archive.empty(); }
+};
+
+// The declared AoK/AoC baseline. Expansion archives outside this catalog retain
+// their separate scope; presence of a file does not establish gameplay support.
+inline std::vector<CampaignEntry> campaignCatalog(const std::filesystem::path &root, bool hd) {
+    std::vector<CampaignEntry> entries={
+        {"cam8","kings","cam8.sin",35146,35139,7,{}},
+        {"cam1","kings","cam1.sin",34935,34929,6,{}},
+        {"cam2","kings","cam2.sin",34965,34959,6,{}},
+        {"cam3","kings","cam3.sin",34995,34989,6,{}},
+        {"cam4","kings","cam4.sin",35025,35019,6,{}},
+        {"xcam1","conquerors","xcam1.sin",35245,35229,6,{}},
+        {"xcam2","conquerors","xcam2.sin",35275,35259,6,{}},
+        {"xcam3","conquerors","xcam3.sin",35305,35289,6,{}},
+        {"xcam4","conquerors","xcam4.sin",35335,35319,8,{}}
+    };
+    auto lower=[](std::string value) {
+        for(char &c:value)if(c>='A' && c<='Z')c+=('a'-'A');
+        return value;
+    };
+    auto child=[&](const std::filesystem::path &parent,const std::string &name) {
+        std::error_code error;
+        if(!std::filesystem::is_directory(parent,error))return std::filesystem::path{};
+        for(const auto &entry:std::filesystem::directory_iterator(parent))
+            if(lower(entry.path().filename().string())==lower(name))return entry.path();
+        return std::filesystem::path{};
+    };
+    for(auto &entry:entries) {
+        auto folder=root;
+        const std::vector<std::string> parts=hd
+            ? std::vector<std::string>{"resources","_common","drs","retail-campaigns","dlc0",entry.group}
+            : std::vector<std::string>{"Campaign"};
+        for(const auto &part:parts) {folder=child(folder,part);if(folder.empty())break;}
+        if(folder.empty())continue;
+        // Classic releases may package AoK as CPN or CPX; imported HD AoC uses CPX.
+        for(const auto &extension:{".cpn",".cpx"}) {
+            const auto file=child(folder,entry.key+extension);
+            if(!file.empty() && std::filesystem::is_regular_file(file)) {entry.archive=file;break;}
+        }
+    }
+    return entries;
+}
+}
diff --git a/src/core/CampaignProgress.h b/src/core/CampaignProgress.h
new file mode 100644
index 0000000..4000f16
--- /dev/null
+++ b/src/core/CampaignProgress.h
@@ -0,0 +1,57 @@
+#pragma once
+#include "SaveArchive.h"
+#include <set>
+#include <algorithm>
+
+namespace agepad {
+// Separate from world saves: replaying or loading an older mission never clears
+// completion. The engine supplies verified input/rules and scenario identities.
+class CampaignProgress {
+public:
+    CampaignProgress(std::filesystem::path path, SaveIdentity identity)
+        : m_path(std::move(path)), m_identity(std::move(identity)) {
+        m_identity.rules += "/campaign-progress-v1";
+        m_identity.schema = 1;
+        if (!std::filesystem::exists(m_path)) return;
+        const auto document = readSave(m_path, m_identity);
+        SaveReader reader(document.payload);
+        if (reader.u32() != 1) throw SaveError("Unsupported campaign progress version");
+        const auto count = reader.u32();
+        if (count > maxMissions) throw SaveError("Too many completed missions");
+        std::string previous;
+        for (std::uint32_t i = 0; i < count; ++i) {
+            const auto bytes = reader.blob(64);
+            const std::string scenario(bytes.begin(), bytes.end());
+            validate(scenario);
+            if (!previous.empty() && scenario <= previous) throw SaveError("Unordered campaign progress");
+            m_completed.insert(scenario); previous = scenario;
+        }
+        reader.finish();
+    }
+    bool completed(const std::string &scenario) const { validate(scenario); return m_completed.count(scenario); }
+    std::size_t size() const { return m_completed.size(); }
+    // Idempotent. Commit memory only after the atomic file write succeeds.
+    bool markCompleted(const std::string &scenario) {
+        validate(scenario);
+        if (m_completed.count(scenario)) return false;
+        if (m_completed.size() >= maxMissions) throw SaveError("Too many completed missions");
+        auto staged = m_completed; staged.insert(scenario);
+        SaveWriter writer; writer.u32(1); writer.u32(staged.size());
+        for (const auto &id : staged) writer.blob(SaveBytes(id.begin(), id.end()), 64);
+        std::filesystem::create_directories(m_path.parent_path());
+        writeSaveAtomic(m_path, {m_identity, std::move(writer.bytes)});
+        m_completed.swap(staged);
+        return true;
+    }
+private:
+    static constexpr std::size_t maxMissions = 4096;
+    static void validate(const std::string &id) {
+        if (id.size() != 64 || !std::all_of(id.begin(), id.end(), [](char c) {
+            return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+        })) throw SaveError("Invalid completed scenario identity");
+    }
+    std::filesystem::path m_path;
+    SaveIdentity m_identity;
+    std::set<std::string> m_completed;
+};
+}
