+class GameState;
+
+// Edits are staged while the single-player world is paused. Closing the
+// screen without committing has no effect on diplomacy or resources.
+class DiplomacySession {
+public:
+    struct Row {
+        int playerId;
+        Player::DiplomaticStance original, stance, theirs;
+        std::array<int,4> tribute{};
+    };
+    explicit DiplomacySession(std::shared_ptr<GameState> state);
+    const std::vector<Row> &rows() const { return m_rows; }
+    std::shared_ptr<Player> player(int id) const;
+    int humanId() const;
+    bool locked() const;
+    bool alliedVictory() const {return m_alliedVictory;}
+    void setAlliedVictory(bool enabled) {m_alliedVictory=enabled;}
+    bool hasMarket() const;
+    float taxRate() const;
+    std::array<float,4> costs() const;
+    std::array<float,4> remaining() const;
+    bool incrementTribute(int playerId,int resource,bool subtract=false);
+    bool setStance(int playerId, Player::DiplomaticStance stance);
+    bool setTribute(int playerId, int resource, int amount);
+    void clearTributes();
+    bool commit(std::string &error);
+    static constexpr std::array<genie::ResourceType,4> resources = {
+        genie::ResourceType::WoodStorage, genie::ResourceType::FoodStorage,
+        genie::ResourceType::GoldStorage, genie::ResourceType::StoneStorage};
+private:
+    std::shared_ptr<GameState> m_state;
+    std::vector<Row> m_rows;
+    bool m_alliedVictory=false;
+};
