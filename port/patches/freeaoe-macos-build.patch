+void Engine::panCameraTo(const ScreenPos &point,const std::shared_ptr<GameState> &state)
+{
+    auto camera=renderTarget_->camera();
+    auto position=camera->targetPosition().toScreen();
+    const auto delta=worldScreen(point)-worldScreen(m_touchPanPrevious);
+    position.x-=delta.x;
+    position.y+=delta.y;
+    camera->setTargetPosition(position.toMap().clamped(state->map()->pixelSize()));
+    m_touchPanPrevious=point;
