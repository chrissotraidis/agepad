+IAction::UpdateResult ActionFollow::update(Time time)
+{
+    const auto unit=m_unit.lock(),target=m_target.lock();
+    if(!unit || !target || target->healthLeft()<=0 || !unit->map() || target->map()!=unit->map())
+        return UpdateResult::Completed;
+    const float sight=std::max(0.f,unit->data()->LineOfSight)*Constants::TILE_SIZE;
+    // Stay assigned while waiting; movement completion is not order completion.
+    if(unit->distanceTo(target)<=sight) {
+        const bool moved=bool(m_move);m_move.reset();
+        return moved?UpdateResult::Updated:UpdateResult::NotUpdated;
+    }
+    if(!m_move)m_move=ActionMove::moveUnitTo(unit,target);
+    if(!m_move)return UpdateResult::Failed;
+    m_move->maxDistance=sight;
+    const auto result=m_move->update(time);
+    if(result==UpdateResult::Completed) {m_move.reset();return UpdateResult::Updated;}
+    return result;
+}
+agepad::SaveBytes ActionFollow::saveRuntime() const
+{
+    const auto unit=m_unit.lock();if(!unit)throw agepad::SaveError("Follow owner unavailable");
+    agepad::SaveWriter w;w.u32(1);w.u64(unit->id);
+    w.u64(agepad::EntitySaveIndex::reference(m_target.lock()));w.boolean(bool(m_move));
+    if(m_move) {
+        if(m_move->owner()!=unit)throw agepad::SaveError("Follow movement owner mismatch");
+        w.blob(m_move->saveRuntime());
+    }
+    return std::move(w.bytes);
+}
+std::shared_ptr<ActionFollow> ActionFollow::fromRuntime(const agepad::SaveBytes &bytes,
+    const agepad::EntitySaveIndex &entities,Time time)
+{
+    agepad::SaveReader r(bytes);if(r.u32()!=1)throw agepad::SaveError("Unsupported follow version");
+    const auto unit=entities.unit(r.u64()),target=entities.unit(r.u64());
+    std::shared_ptr<ActionMove> move;if(r.boolean())move=ActionMove::fromRuntime(r.blob(),entities,time);
+    r.finish();auto action=std::make_shared<ActionFollow>(unit,target);
+    if(move && move->owner()!=unit)throw agepad::SaveError("Follow movement owner mismatch");
+    action->m_move=std::move(move);return action;
+}
