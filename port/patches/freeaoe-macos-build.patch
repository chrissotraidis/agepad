+agepad::SaveBytes Map::saveTerrain() const
+{
+    if (rows_<=0 || cols_<=0 || rows_>Constants::MAP_MAX_SIZE || cols_>Constants::MAP_MAX_SIZE ||
+        tiles_.size()!=std::size_t(rows_)*std::size_t(cols_))
+        throw agepad::SaveError("Invalid live map dimensions");
+    agepad::SaveWriter writer;
+    writer.u32(1);
+    writer.u32(cols_);
+    writer.u32(rows_);
+    for (const auto &tile : tiles_) {
+        if (tile.terrainId>=DataManager::Inst().terrainBlock().Terrains.size() || tile.elevation<0 || tile.elevation>255)
+            throw agepad::SaveError("Invalid live terrain tile");
