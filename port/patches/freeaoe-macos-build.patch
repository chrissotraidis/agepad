+agepad::SaveBytes ScenarioController::saveRuntime() const
+{
+    agepad::SaveWriter writer;
+    writer.u32(2); // Adds explicit trigger completion history.
+    writer.i64(m_lastUpdateTime);
+    writer.u32(static_cast<std::uint32_t>(m_triggers.size()));
+    for (const auto &trigger : m_triggers) {
+        writer.boolean(trigger.enabled);
+        writer.u32(static_cast<std::uint32_t>(trigger.conditions.size()));
+        for (const auto &condition : trigger.conditions) writer.f32(condition.amountRequired);
+    }
+    for(const auto &trigger:m_triggers)writer.boolean(trigger.hasFired);
+    return std::move(writer.bytes);
+}
+
+std::string ScenarioController::objectiveReport() const
+{
+    std::string report;
+    for(const auto &objective:m_objectives) {
+        const auto &trigger=m_triggers[objective.index];
+        if(!trigger.enabled && !trigger.hasFired)continue;
+        if(!report.empty())report+="\n\n";
+        report+=(trigger.hasFired?"[x] ":"[ ] ")+objective.text;
+    }
+    return report;
+}
+
+void ScenarioController::restoreRuntime(const agepad::SaveBytes &bytes, Time simulationTime)
+{
+    agepad::SaveReader reader(bytes);
+    const auto version=reader.u32();
+    if(version!=1 && version!=2)throw agepad::SaveError("Unsupported scenario runtime version");
+    const Time lastUpdate = reader.i64();
+    if (lastUpdate < 0 || lastUpdate > simulationTime)
+        throw agepad::SaveError("Scenario time outside saved simulation timeline");
+    if (reader.u32() != m_triggers.size()) throw agepad::SaveError("Scenario trigger count mismatch");
+    struct State { bool enabled; std::vector<float> amounts; bool fired=false; };
+    std::vector<State> states;
+    states.reserve(m_triggers.size());
+    for (const auto &trigger : m_triggers) {
+        State state{reader.boolean(), {}};
+        if (reader.u32() != trigger.conditions.size()) throw agepad::SaveError("Scenario condition count mismatch");
+        for (std::size_t i=0; i<trigger.conditions.size(); ++i) state.amounts.push_back(reader.f32());
+        states.push_back(std::move(state));
+    }
+    // Version1 had no completion history. Do not infer it from disabled state.
+    if(version>=2)for(auto &state:states)state.fired=reader.boolean();
+    reader.finish();
+    // Parse and validate the entire section before changing live state. Do not
+    // activate triggers or emit gameplay events while restoring counters.
+    m_lastUpdateTime = lastUpdate;
+    for (std::size_t i=0; i<m_triggers.size(); ++i) {
+        m_triggers[i].enabled = states[i].enabled;
+        m_triggers[i].hasFired = states[i].fired;
+        for (std::size_t j=0; j<m_triggers[i].conditions.size(); ++j)
+            m_triggers[i].conditions[j].amountRequired = states[i].amounts[j];
+    }
 }
 
