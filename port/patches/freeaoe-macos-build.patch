+    const auto camera = renderTarget_->camera();
+    Unit::Ptr nearest;
+    for (const auto &unit : m_unitManager->units()) {
+        if (!unit || unit->playerId()!=m_humanPlayer->playerId || !unit->isAlive() || !unit->garrisonedIn.expired()) continue;
+        if (playableArea.contains(camera->absoluteScreenPos(unit->position()))) return false;
+        if (!nearest || unit->distanceTo(camera->targetPosition()) < nearest->distanceTo(camera->targetPosition()) ||
+            (unit->distanceTo(camera->targetPosition()) == nearest->distanceTo(camera->targetPosition()) && unit->id < nearest->id)) nearest=unit;
+    }
+    if (!nearest) return false;
+    m_initialCameraUnit=nearest;
+    m_initialPlayableArea=playableArea;
+    camera->setTargetPosition(nearest->position());
+    DBG << "Adapted empty initial scenario view to" << nearest->debugName;
+    return true;
