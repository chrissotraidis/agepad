+agepad::SaveBytes VisibilityMap::saveRuntime() const
+{
+    agepad::SaveWriter writer;
+    writer.u32(1);
+    writer.i32(m_playerId);
+    writer.u32(Constants::MAP_MAX_SIZE);
+    writer.u32(static_cast<std::uint32_t>(m_visibility.size()));
+    for (const int count : m_visibility) {
+        if (count < 0 && count != Unexplored)
+            throw agepad::SaveError("Invalid live visibility reference count");
+        writer.i32(count);
+    }
+    return std::move(writer.bytes);
+}
+
+void VisibilityMap::restoreRuntime(const agepad::SaveBytes &bytes)
+{
+    agepad::SaveReader reader(bytes);
+    if (reader.u32() != 1) throw agepad::SaveError("Unsupported visibility section version");
+    if (reader.i32() != m_playerId) throw agepad::SaveError("Visibility player mismatch");
+    if (reader.u32() != Constants::MAP_MAX_SIZE || reader.u32() != m_visibility.size())
+        throw agepad::SaveError("Visibility dimensions mismatch");
+    // Heap staging avoids putting the full 255x255 map on the mobile stack.
+    std::vector<int> counts;
+    counts.reserve(m_visibility.size());
+    for (std::size_t i=0; i<m_visibility.size(); ++i) {
+        const auto count = reader.i32();
+        if (count < 0 && count != Unexplored)
+            throw agepad::SaveError("Invalid saved visibility reference count");
+        counts.push_back(count);
+    }
+    reader.finish();
+    std::copy(counts.begin(), counts.end(), m_visibility.begin());
+    isDirty = true; // Rebuild rendering, without gameplay discovery side effects.
+}
