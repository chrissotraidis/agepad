+bool Player::researchRequirementsMet(const genie::Tech &research) const
+{
+    int satisfied=0;
+    for (const int required : research.RequiredTechs) {
+        if (required>=0 && m_completedResearch.count(required)) ++satisfied;
     }
+    return research.RequiredTechCount>=0 && satisfied>=research.RequiredTechCount;
+}
