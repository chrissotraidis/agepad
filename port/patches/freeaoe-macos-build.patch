+class CampaignBrowser : public UiScreen {
+public:
+    CampaignBrowser(std::vector<agepad::CampaignEntry> catalog, const agepad::CampaignProgress &progress);
+    bool init() override;
+    bool handleMouseEvent(const sf::Event &) override;
+    void handleKeyEvent(const sf::Event &) override;
