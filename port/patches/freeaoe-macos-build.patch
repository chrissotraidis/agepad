+agepad::SaveBytes GraphicRender::saveRuntime() const
+{
+    agepad::SaveWriter writer;writer.u32(2);
+    std::size_t nodes=0;
+    std::function<void(const GraphicRender &,unsigned)> write=[&](const GraphicRender &g,unsigned depth){
+        if(depth>8 || ++nodes>4096)throw agepad::SaveError("Graphic state nesting exceeds limit");
+        writer.i32(g.m_sprite ? g.m_sprite->m_spriteId : -1);
+        writer.i64(g.m_lastFrameTime);writer.i32(g.m_playerColor);writer.i32(g.m_civId);
+        writer.i32(g.m_currentFrame);writer.f32(g.m_angle);
+        writer.boolean(g.m_frameChanged);writer.i32(g.m_currentSound);writer.boolean(g.m_playSounds);writer.boolean(g.m_runOnce);
+        writer.u32(g.m_deltas.size());
+        for(const auto &delta:g.m_deltas){
+            if(!delta.graphic)throw agepad::SaveError("Missing graphic delta");
+            writer.f32(delta.offset.x);writer.f32(delta.offset.y);writer.i32(delta.angleToDrawOn);
+            write(*delta.graphic,depth+1);
+        }
+        writer.boolean(bool(g.m_damageOverlay));
+        if(g.m_damageOverlay)write(*g.m_damageOverlay,depth+1);
+    };
+    write(*this,0);return std::move(writer.bytes);
+}
+
+std::unique_ptr<GraphicRender> GraphicRender::fromRuntime(const agepad::SaveBytes &bytes,Time simulationTime)
+{
+    agepad::SaveReader reader(bytes);
+    if(reader.u32()!=2)throw agepad::SaveError("Unsupported graphic state version");
+    std::size_t nodes=0;
+    std::function<std::unique_ptr<GraphicRender>(unsigned)> read=[&](unsigned depth){
+        if(depth>8 || ++nodes>4096)throw agepad::SaveError("Graphic state nesting exceeds limit");
+        auto g=std::make_unique<GraphicRender>();
+        const auto spriteID=reader.i32();
+        g->m_lastFrameTime=reader.i64();g->m_playerColor=reader.i32();g->m_civId=reader.i32();
+        g->m_currentFrame=reader.i32();g->m_angle=reader.f32();
+        g->m_frameChanged=reader.boolean();g->m_currentSound=reader.i32();g->m_playSounds=reader.boolean();g->m_runOnce=reader.boolean();
+        if(spriteID < -1 || (spriteID>=0 && std::size_t(spriteID)>=DataManager::Inst().graphicCount()) ||
+           g->m_lastFrameTime<0 || g->m_lastFrameTime>simulationTime || g->m_currentFrame<0 ||
+           g->m_playerColor < -1 || g->m_playerColor>255 || g->m_civId<0 || std::size_t(g->m_civId)>=DataManager::Inst().civilizations().size() ||
+           g->m_currentSound<0 || g->m_currentSound>2)
+            throw agepad::SaveError("Invalid graphic state");
+        if(spriteID>=0){
+            g->m_sprite=AssetManager::Inst()->getGraphic(spriteID);
+            if(!g->m_sprite || !g->m_sprite->isValid() || g->m_currentFrame>=std::max<int>(1,g->m_sprite->frameCount()))
+                throw agepad::SaveError("Saved graphic/frame unavailable");
+        }else if(g->m_currentFrame!=0)throw agepad::SaveError("Frame without sprite");
+        const auto count=reader.u32();
+        if(count>4096-nodes)throw agepad::SaveError("Too many graphic deltas");
+        for(std::uint32_t i=0;i<count;++i){
+            GraphicDelta delta;delta.offset.x=reader.f32();delta.offset.y=reader.f32();delta.angleToDrawOn=reader.i32();
+            if(delta.angleToDrawOn < -1 || delta.angleToDrawOn>255)throw agepad::SaveError("Invalid delta angle");
+            delta.graphic=read(depth+1);g->m_deltas.push_back(std::move(delta));
+        }
+        if(reader.boolean())g->m_damageOverlay=read(depth+1);
+        return g;
+    };
+    auto result=read(0);reader.finish();return result;
+}
