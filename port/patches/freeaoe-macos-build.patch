+#include "CampaignScreen.h"
+#include "resource/LanguageManager.h"
+#include "render/SfmlRenderTarget.h"
+#include <SFML/Graphics/RenderWindow.hpp>
+#include <SFML/Graphics/Text.hpp>
+#include <SFML/Window/Event.hpp>
+#include <algorithm>
+
+CampaignScreen::CampaignScreen(std::vector<std::string> labels, std::vector<bool> completed)
+    : UiScreen("cam8.sin"), m_labels(std::move(labels)), m_completed(std::move(completed)) {}
+
+bool CampaignScreen::init() {
+    if(m_labels.size()!=7 || m_completed.size()!=m_labels.size() || !UiScreen::init())return false;
+    const float x=m_backgroundSize.width/1366.f,y=m_backgroundSize.height/768.f;
+    const ScreenPos points[]={{200,55},{330,175},{340,285},{450,375},{710,460},{640,550},{800,635}};
+    for(const auto&p:points)m_missions.emplace_back(p.x*x,p.y*y,510*x,80*y);
+    m_back.text="Main Menu";m_back.rect=ScreenRect(20*x,680*y,260*x,65*y);
+    return true;
+}
+bool CampaignScreen::handleMouseEvent(const sf::Event&e) {
+    if(e.type!=sf::Event::MouseButtonPressed && e.type!=sf::Event::MouseButtonReleased)return false;
+    if(e.mouseButton.button!=sf::Mouse::Left)return false;
+    const ScreenPos p(e.mouseButton.x,e.mouseButton.y);
+    int hit=-1;
+    for(std::size_t i=0;i<m_missions.size();++i)if(m_missions[i].contains(p))hit=int(i);
+    if(m_back.rect.contains(p))hit=7;
+    if(e.type==sf::Event::MouseButtonPressed){m_pressed=hit;m_back.pressed=hit==7;return false;}
+    const bool activate=hit>=0 && hit==m_pressed;cancelInteraction();
+    if(!activate)return false;
+    m_selection=hit==7?-1:hit;return true;
+}
+void CampaignScreen::handleKeyEvent(const sf::Event&e) {
+    if(e.type!=sf::Event::KeyPressed)return;
+    if(e.key.code==sf::Keyboard::Escape){m_selection=-1;m_renderWindow->close();}
+    if(e.key.code>=sf::Keyboard::Num1 && e.key.code<=sf::Keyboard::Num7){
+        m_selection=e.key.code-sf::Keyboard::Num1;m_renderWindow->close();
+    }
+}
+void CampaignScreen::render() {
+    for(std::size_t i=0;i<m_labels.size();++i) {
+        sf::Text text; text.setFont(SfmlRenderTarget::plainFont());
+        text.setString(sf::String::fromUtf8(m_labels[i].begin(),m_labels[i].end()));
+        text.setCharacterSize(std::max(18,int(30*m_backgroundSize.width/1366.f)));text.setFillColor(m_pressed==int(i)?sf::Color(255,240,180):sf::Color::White);
+        text.setOutlineColor(sf::Color::Black);text.setOutlineThickness(1);
+        auto bounds=text.getLocalBounds();
+        if(bounds.width>m_missions[i].width-10)text.setScale((m_missions[i].width-10)/bounds.width,1);
+        text.setPosition(m_missions[i].x,m_missions[i].y+8);m_renderWindow->draw(text);
+        if(m_completed[i]){text.setScale(1,1);text.setCharacterSize(std::max(14,int(22*m_backgroundSize.width/1366.f)));text.setString("Completed");text.move(0,28*m_backgroundSize.height/768.f);m_renderWindow->draw(text);}
+    }
+    m_back.render(this);
+}
