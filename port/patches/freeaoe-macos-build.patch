diff --git a/src/mechanics/UnitGraphSave.h b/src/mechanics/UnitGraphSave.h
new file mode 100644
index 0000000..4856bee
--- /dev/null
+++ b/src/mechanics/UnitGraphSave.h
@@ -0,0 +1,362 @@
+#pragma once
+
+#include "EntitySaveIndex.h"
+#include "UnitFactory.h"
+#include "UnitManager.h"
+#include "Map.h"
+#include "Missile.h"
+#include "Building.h"
+#include "Farm.h"
+#include "Player.h"
+#include "core/SaveArchive.h"
+#include <cmath>
+#include <unordered_map>
+#include <unordered_set>
+
+namespace agepad {
+// Detached entities staged for an isolated destination manager. The outer
+// GameState loader must finish all sections before exposing the resumed world.
+struct StagedUnitGraph {
+    std::vector<Unit::Ptr> roots;
+    std::vector<Unit::Ptr> records;
+    EntitySaveIndex index;
+    std::vector<Missile::Ptr> missiles;
+    std::unordered_set<StaticEntity::Ptr> effects;
+};
+
+class UnitGraphSave {
+    static constexpr std::size_t limit=65536;
+    static void validate(const std::vector<Unit::Ptr> &roots,const std::vector<Unit::Ptr> &records) {
+        std::unordered_set<const Unit*> all,rootSet,guests;
+        std::unordered_map<const Unit*,const Unit*> parents;
+        for(const auto &u:records)if(!u || !all.insert(u.get()).second)throw SaveError("Duplicate unit graph record");
+        for(const auto &u:roots)if(!u || !all.contains(u.get()) || !rootSet.insert(u.get()).second)throw SaveError("Invalid unit graph root");
+        for(const auto &u:records) {
+            for(const auto &annex:u->annexes) {
+                if(!annex.unit || !all.contains(annex.unit.get()) || rootSet.contains(annex.unit.get()) ||
+                   !parents.emplace(annex.unit.get(),u.get()).second)throw SaveError("Invalid or shared annex");
+            }
+            if(auto host=u->garrisonedIn.lock()) {
+                if(!all.contains(host.get()) || host.get()==u.get())throw SaveError("Invalid garrison host");
+                std::size_t matches=0;
+                for(const auto &guest:host->garrisonedUnits)if(guest.lock()==u)++matches;
+                if(matches!=1)throw SaveError("Garrison links disagree");
+            }
+            if(auto building=Building::fromUnit(u)) {
+                for(const auto &weak:building->garrisonedUnits) {
+                    const auto guest=weak.lock();
+                    if(!guest || !all.contains(guest.get()) || guest->garrisonedIn.lock()!=building ||
+                       !guests.insert(guest.get()).second)throw SaveError("Invalid garrison guest");
+                }
+            }
+        }
+        for(const auto &u:records) {
+            const Unit *node=u.get();std::size_t depth=0;
+            while(parents.contains(node)) {
+                if(++depth>64)throw SaveError("Cyclic or overly deep annex graph");
+                node=parents.at(node);
+            }
+            if(!rootSet.contains(node))throw SaveError("Orphaned annex record");
+            auto host=u->garrisonedIn.lock();depth=0;
+            while(host) {
+                if(++depth>64)throw SaveError("Cyclic or overly deep garrison graph");
+                host=host->garrisonedIn.lock();
+            }
+        }
+    }
+public:
+    static SaveBytes saveEffects(const UnitManager &manager) {
+        SaveWriter w;w.u32(1);
+        if(manager.m_missiles.size()>limit || manager.m_staticEntities.size()>limit)throw SaveError("Effects exceed count limit");
+        w.u32(manager.m_missiles.size());
+        for(const auto &missile:manager.m_missiles) {if(!missile)throw SaveError("Missing missile");w.u64(missile->id);w.blob(missile->saveRuntime());}
+        std::vector<StaticEntity::Ptr> effects(manager.m_staticEntities.begin(),manager.m_staticEntities.end());
+        std::sort(effects.begin(),effects.end(),[](const auto &a,const auto &b){return a->id<b->id;});
+        w.u32(effects.size());
+        for(const auto &effect:effects) {
+            if(!effect)throw SaveError("Missing static entity");
+            w.u64(effect->id);
+            if(effect->isDecayingEntity()) {w.u32(0);w.blob(std::static_pointer_cast<DecayingEntity>(effect)->saveRuntime());}
+            else if(effect->isDoppleganger()) {w.u32(1);w.blob(DopplegangerEntity::fromEntity(effect)->saveRuntime());}
+            else throw SaveError("Unsupported static entity kind");
+        }
+        return std::move(w.bytes);
+    }
+    static void stageEffects(StagedUnitGraph &graph,const SaveBytes &bytes,const std::vector<Player::Ptr> &players,
+                             UnitManager &manager,Time time) {
+        if(!graph.missiles.empty() || !graph.effects.empty() || !manager.map())throw SaveError("Effects already staged or terrain missing");
+        for(const auto &u:graph.records)if(!u || !u->isRestoreStaging() || &u->unitManager()!=&manager || u->map()!=manager.map())throw SaveError("Effects require destination staged unit graph");
+        std::unordered_map<int,Player::Ptr> owners;
+        for(const auto &p:players)if(!p || p->m_map.lock()!=manager.map() || !owners.emplace(p->playerId,p).second)throw SaveError("Invalid effects roster");
+        SaveReader r(bytes);if(r.u32()!=1)throw SaveError("Unsupported effects version");
+        auto count=[&](){auto n=r.u32();if(n>limit)throw SaveError("Saved effects exceed limit");return n;};
+        std::vector<Missile::Ptr> missiles;std::unordered_set<StaticEntity::Ptr> effects;
+        std::vector<std::pair<EntitySaveIndex::ID,EntityPtr>> extra;
+        for(auto n=count();n;--n) {
+            const auto id=r.u64();const auto payload=r.blob();SaveReader identity(payload);
+            identity.u32();identity.i32();const int owner=identity.i32();
+            if(!owners.contains(owner))throw SaveError("Missile owner missing");
+            auto missile=Missile::fromRuntime(payload,owners.at(owner),manager,manager.map(),graph.index,time,true);
+            missiles.push_back(missile);extra.emplace_back(id,missile);
+        }
+        for(auto n=count();n;--n) {
+            const auto id=r.u64();const auto kind=r.u32();const auto payload=r.blob();
+            StaticEntity::Ptr effect;
+            if(kind==0)effect=DecayingEntity::fromRuntime(payload,time);
+            else if(kind==1) {
+                SaveReader identity(payload);identity.u32();identity.i32();const auto owner=identity.i32();
+                if(!owners.contains(owner))throw SaveError("Fog memory owner missing");
+                effect=DopplegangerEntity::fromRuntime(payload,owners.at(owner),manager,graph.index,time);
+            } else throw SaveError("Unsupported static effect kind");
+            effect->Entity::setMap(manager.map());
+            effects.insert(effect);extra.emplace_back(id,effect);
+        }
+        r.finish();
+        auto index=graph.index.extended(extra);
+        std::unordered_map<const Unit*,int> counts;
+        for(const auto &missile:missiles)if(auto source=missile->m_sourceUnit.lock())++counts[source.get()];
+        for(const auto &u:graph.records)if(u->activeMissiles!=counts[u.get()])throw SaveError("Saved missiles disagree with unit count");
+        graph.index=std::move(index);graph.missiles.swap(missiles);graph.effects.swap(effects);
+    }
+
+    static SaveBytes saveManager(const UnitManager &manager) {
+        SaveWriter w;w.u32(1);w.i64(manager.m_lastUpdateTime);w.boolean(manager.m_unitsMoved);
+        w.blob(manager.m_random.saveRuntime());w.i32(manager.m_humanPlayerID);
+        w.u32(manager.m_players.size());
+        for(const auto &weak:manager.m_players) {
+            auto p=weak.lock();if(!p)throw SaveError("Missing manager player");w.i32(p->playerId);
+        }
+        auto writeSet=[&](const auto &units) {
+            if(units.size()>limit)throw SaveError("Manager unit set exceeds limit");
+            w.u32(units.size());for(const auto &u:units)w.u64(EntitySaveIndex::reference(u));
+        };
+        writeSet(manager.m_unitsWithActions);writeSet(manager.m_selectedUnits);
+        for(int i=0;i<UnitManager::ControlGroupCount;++i)writeSet(manager.controlGroupUnits(i));
+        std::vector<std::pair<int,int>> blinking(manager.m_targetBlinkTimeLeft.begin(),manager.m_targetBlinkTimeLeft.end());
+        std::sort(blinking.begin(),blinking.end());w.u32(blinking.size());
+        for(const auto &[id,time]:blinking){w.u64(id);w.i32(time);}
+        if(!manager.m_map)throw SaveError("Manager map missing");
+        w.u32(manager.m_map->columnCount());w.u32(manager.m_map->rowCount());
+        w.u32(manager.m_map->m_tileUnits.size());
+        for(const auto &tile:manager.m_map->m_tileUnits) {
+            std::vector<EntityPtr> entities;
+            for(const auto &weak:tile)if(auto entity=weak.lock())entities.push_back(entity);
+            w.u32(entities.size());for(const auto &entity:entities)w.u64(EntitySaveIndex::reference(entity));
+        }
+        return std::move(w.bytes);
+    }
+
+    // Commit into an isolated, terrain-only destination. The outer GameState
+    // loader must finish all other sections before exposing this manager.
+    static void activate(StagedUnitGraph &graph,UnitManager &manager,
+                         const std::vector<Player::Ptr> &players,const std::vector<SaveBytes> &memberships,
+                         const SaveBytes &managerBytes,Time time,
+                         const std::unordered_set<const Unit*> &authoredOutside = {}) {
+        const auto map=manager.m_map;
+        if(!map || !manager.m_moveTargetMarker || !manager.m_units.empty() || !manager.m_staticEntities.empty() || !manager.m_missiles.empty() ||
+           players.size()!=memberships.size() || !manager.m_selectedUnits.isEmpty() || !manager.m_unitsWithActions.isEmpty() ||
+           !manager.m_buildingsToPlace.empty())throw SaveError("Activation requires empty destination world");
+        for(const auto &tile:map->m_tileUnits)for(const auto &weak:tile)
+            if(!weak.expired())throw SaveError("Activation destination already has occupancy");
+        validate(graph.roots,graph.records);
+        std::unordered_set<const Unit*> all;
+        for(const auto &u:graph.records) {
+            if(!u->m_restoreStaging || &u->unitManager()!=&manager || u->map()!=map || (!map->isValidPosition(u->position()) && !authoredOutside.contains(u.get())))
+                throw SaveError("Unit is not staged in destination world");
+
+            all.insert(u.get());
+        }
+        std::unordered_set<const Entity*> allEntities;
+        for(const auto &u:graph.records)allEntities.insert(u.get());
+        std::unordered_map<const Unit*,int> projectileCounts;
+        for(const auto &missile:graph.missiles) {
+            if(!missile || !missile->m_restoreStaging || &missile->m_unitManager!=&manager || missile->map()!=map || !map->isValidPosition(missile->position()) || !allEntities.insert(missile.get()).second)
+                throw SaveError("Invalid staged missile");
+            if(auto source=missile->m_sourceUnit.lock()) {
+                if(!all.contains(source.get()))throw SaveError("Missile source outside graph");
+                ++projectileCounts[source.get()];
+            }
+        }
+        for(const auto &u:graph.records)if(u->activeMissiles!=projectileCounts[u.get()])throw SaveError("Projectile links disagree with source counters");
+        for(const auto &effect:graph.effects) {
+            if(!effect || effect->map()!=map || !map->isValidPosition(effect->position()) || !allEntities.insert(effect.get()).second)throw SaveError("Invalid staged effect");
+        }
+        std::unordered_map<int,Player::Ptr> owners;
+        std::vector<Player::PreparedUnitMembership> prepared;
+        for(std::size_t i=0;i<players.size();++i) {
+            const auto &p=players[i];
+            if(!p || !p->m_units.empty() || p->m_map.lock()!=map || !owners.emplace(p->playerId,p).second)
+                throw SaveError("Activation requires empty restored players");
+            for(const auto &group:p->m_unitGroups)if(!group.empty())throw SaveError("Destination player already has groups");
+            prepared.push_back(p->prepareUnitMembership(memberships[i],graph.index));
+            for(auto *u:prepared.back().units)if(!all.contains(u))throw SaveError("Membership outside unit graph");
+        }
+        for(const auto &u:graph.records)
+            if(!owners.contains(u->playerId()) || owners.at(u->playerId())!=u->player().lock())throw SaveError("Unit owner outside destination roster");
+        for(const auto &missile:graph.missiles) {
+            const auto owner=missile->m_player.lock();
+            if(!owner || !owners.contains(owner->playerId) || owners.at(owner->playerId)!=owner)throw SaveError("Missile owner outside destination roster");
+        }
+        SaveReader r(managerBytes);if(r.u32()!=1)throw SaveError("Unsupported manager state version");
+        const Time previous=r.i64();const bool moved=r.boolean();SimulationRandom random;random.restoreRuntime(r.blob());
+        const int human=r.i32();
+        if(previous<0 || previous>time || !owners.contains(human))throw SaveError("Invalid saved manager clock or human");
+        auto count=[&](){auto n=r.u32();if(n>limit)throw SaveError("Manager state count exceeds limit");return n;};
+        std::vector<std::weak_ptr<Player>> roster;std::unordered_set<int> rosterIDs;
+        for(auto n=count();n;--n) {
+            const int id=r.i32();if(!owners.contains(id) || !rosterIDs.insert(id).second)throw SaveError("Invalid manager roster");
+            roster.push_back(owners.at(id));
+        }
+        if(roster.size()!=players.size())throw SaveError("Manager roster omits a player");
+        auto readSet=[&]() {
+            UnitSet set;
+            for(auto n=count();n;--n) {
+                auto u=graph.index.unit(r.u64());
+                if(!u || !all.contains(u.get()) || set.contains(u))throw SaveError("Invalid manager unit reference");
+                set.add(u);
+            }
+            return set;
+        };
+        auto automatic=readSet(),selected=readSet();
+        std::array<std::vector<std::weak_ptr<Unit>>,UnitManager::ControlGroupCount> groups;
+        for(auto &group:groups)for(const auto &u:readSet())group.push_back(u);
+        std::unordered_map<int,int> blinking;
+        for(auto n=count();n;--n) {
+            auto u=graph.index.unit(r.u64());const int remaining=r.i32();
+            if(!u || u->id>std::size_t(std::numeric_limits<int>::max()) || remaining<=0 || !blinking.emplace(int(u->id),remaining).second)
+                throw SaveError("Invalid target blink state");
+        }
+        const auto columns=r.u32(),rows=r.u32();
+        if(columns!=std::uint32_t(map->columnCount()) || rows!=std::uint32_t(map->rowCount()) || r.u32()!=map->m_tileUnits.size())
+            throw SaveError("Saved occupancy dimensions mismatch");
+        std::vector<std::vector<std::weak_ptr<Entity>>> occupancy(map->m_tileUnits.size());
+        std::unordered_set<const Entity*> occupied;
+        for(std::size_t tile=0;tile<occupancy.size();++tile)for(auto n=count();n;--n) {
+            auto u=graph.index.entity(r.u64());
+            if(!u || !allEntities.contains(u.get()) || !occupied.insert(u.get()).second)throw SaveError("Invalid occupancy reference");
+            const int x=u->position().x/Constants::TILE_SIZE,y=u->position().y/Constants::TILE_SIZE;
+            if(std::size_t(y*map->columnCount()+x)!=tile)throw SaveError("Occupancy disagrees with saved position");
+            occupancy[tile].push_back(u);
+        }
+        r.finish();
+        // Build every allocating container before commit. Foundation terrain and
+        // visibility are already restored snapshots; do not emit creation,
+        // movement, discovery, population or terrain events while registering.
+        auto roots=graph.roots;
+        for(std::size_t i=0;i<players.size();++i) {
+            players[i]->m_units.swap(prepared[i].units);players[i]->m_unitGroups.swap(prepared[i].groups);
+        }
+        map->m_tileUnits.swap(occupancy);manager.m_units.swap(roots);
+        for(const auto &missile:graph.missiles) {missile->m_restoreStaging=false;missile->m_countedForSource=!missile->m_sourceUnit.expired();}
+        manager.m_missiles.swap(graph.missiles);manager.m_staticEntities.swap(graph.effects);
+        manager.m_unitsWithActions.units.swap(automatic.units);manager.m_selectedUnits.units.swap(selected.units);
+        manager.m_controlGroups.swap(groups);manager.m_targetBlinkTimeLeft.swap(blinking);manager.m_players.swap(roster);
+        manager.m_humanPlayer=owners.at(human);manager.m_humanPlayerID=human;
+        manager.m_random=random;manager.m_lastUpdateTime=previous;manager.m_unitsMoved=moved;
+        manager.m_availableActionsChanged=true;manager.cancelPendingCommand();
+        for(const auto &u:graph.records)u->m_restoreStaging=false;
+        graph.roots.clear();graph.records.clear();graph.index=EntitySaveIndex();
+    }
+
+    static SaveBytes save(const std::vector<Unit::Ptr> &roots) {
+        if(roots.size()>limit)throw SaveError("Too many unit roots");
+        std::vector<Unit::Ptr> records=roots;
+        std::unordered_set<const Unit*> found;
+        for(std::size_t i=0;i<records.size();++i) {
+            if(records.size()>limit || !records[i] || !found.insert(records[i].get()).second)
+                throw SaveError("Invalid or duplicate unit graph traversal");
+            for(const auto &annex:records[i]->annexes)records.push_back(annex.unit);
+        }
+        validate(roots,records);
+        auto reference=[&](const Unit::Ptr &u) {
+            if(u && !found.contains(u.get()))throw SaveError("Unit graph reference outside snapshot");
+            return EntitySaveIndex::reference(u);
+        };
+        SaveWriter w;w.u32(2);w.u32(roots.size());
+        for(const auto &u:roots)w.u64(reference(u));
+        w.u32(records.size());
+        for(const auto &u:records) {
+            w.u64(reference(u));w.blob(u->saveBaseRuntime());w.blob(u->actions.saveRuntime());
+            const auto attacker=u->lastAttacker.lock();
+            w.u64(attacker && found.contains(attacker.get())?reference(attacker):EntitySaveIndex::nullID);
+            w.u64(u->attackRevision);
+            if(auto b=Building::fromUnit(u)) {w.blob(b->saveProductionRuntime());w.i32(b->constructors);}
+            if(auto f=std::dynamic_pointer_cast<Farm>(u))w.blob(f->saveFarmRuntime());
+            w.u32(u->annexes.size());
+            for(const auto &a:u->annexes) {w.u64(reference(a.unit));w.f32(a.offset.x);w.f32(a.offset.y);w.f32(a.offset.z);}
+            w.u64(reference(u->garrisonedIn.lock()));
+            if(auto b=Building::fromUnit(u)) {
+                w.u32(b->garrisonedUnits.size());for(const auto &g:b->garrisonedUnits)w.u64(reference(g.lock()));
+            }
+        }
+        return std::move(w.bytes);
+    }
+
+    static StagedUnitGraph stage(const SaveBytes &bytes,const std::vector<Player::Ptr> &players,
+                                UnitManager &manager,Time time) {
+        if(time<0)throw SaveError("Invalid unit graph simulation time");
+        if(!manager.map() || !manager.units().empty() || !manager.missiles().empty() || !manager.staticEntities().empty())
+            throw SaveError("Unit graph staging requires an empty manager with restored terrain");
+        std::unordered_map<int,Player::Ptr> owners;
+        for(const auto &p:players)if(!p || !owners.emplace(p->playerId,p).second)throw SaveError("Duplicate unit graph player");
+        SaveReader r(bytes);const auto version=r.u32();
+        if(version!=1 && version!=2)throw SaveError("Unsupported unit graph version");
+        auto count=[&]() {auto n=r.u32();if(n>limit)throw SaveError("Unit graph count exceeds limit");return n;};
+        std::vector<std::uint64_t> roots;for(auto n=count();n;--n)roots.push_back(r.u64());
+        struct Pending {
+            SaveBytes actions;
+            std::uint64_t attacker=EntitySaveIndex::nullID,attackRevision=0;
+            std::vector<std::pair<std::uint64_t,MapPos>> annexes;
+            std::uint64_t host=EntitySaveIndex::nullID;
+            std::vector<std::uint64_t> guests;
+            int constructors=0;
+        };
+        StagedUnitGraph graph;std::vector<Pending> pending;
+        for(auto n=count();n;--n) {
+            const auto id=r.u64();const auto base=r.blob();
+            SaveReader identity(base);identity.u32();identity.i32();const auto ownerID=identity.i32();
+            if(!owners.contains(ownerID))throw SaveError("Missing unit graph player");
+            auto u=UnitFactory::restoreUnitBase(base,owners.at(ownerID),manager,time);
+            graph.index.add(id,u);graph.records.push_back(u);Pending p;p.actions=r.blob();
+            if(version>=2){p.attacker=r.u64();p.attackRevision=r.u64();}
+            if(auto b=Building::fromUnit(u)) {
+                b->restoreProductionRuntime(r.blob(),time);p.constructors=r.i32();
+                if(p.constructors<0 || p.constructors>int(limit))throw SaveError("Invalid constructor count");
+            }
+            if(auto f=std::dynamic_pointer_cast<Farm>(u))f->restoreFarmRuntime(r.blob());
+            for(auto a=count();a;--a) {
+                const auto target=r.u64();MapPos offset;offset.x=r.f32();offset.y=r.f32();offset.z=r.f32();
+                if(std::abs(offset.x)>1e6 || std::abs(offset.y)>1e6 || std::abs(offset.z)>1e6)throw SaveError("Invalid annex offset");
+                p.annexes.emplace_back(target,offset);
+            }
+            p.host=r.u64();if(u->isBuilding())for(auto g=count();g;--g)p.guests.push_back(r.u64());
+            pending.push_back(std::move(p));
+        }
+        r.finish();graph.index.seal();
+        for(auto id:roots)graph.roots.push_back(graph.index.unit(id));
+        // Validate topology using temporary links; remove all strong annex links
+        // on failure so even malicious cycles cannot retain staged objects.
+        try {
+            for(std::size_t i=0;i<graph.records.size();++i) {
+                const auto &u=graph.records[i];const auto &p=pending[i];
+                u->lastAttacker=graph.index.unit(p.attacker);u->attackRevision=p.attackRevision;
+                for(const auto &[id,offset]:p.annexes)u->annexes.push_back({graph.index.unit(id),offset});
+                const auto host=graph.index.unit(p.host);
+                if(host && !host->isBuilding())throw SaveError("Garrison host is not a building");
+                u->garrisonedIn=Building::fromUnit(host);
+                if(auto b=Building::fromUnit(u))for(auto id:p.guests)b->garrisonedUnits.push_back(graph.index.unit(id));
+            }
+            validate(graph.roots,graph.records);
+            // Movement readers need restored terrain dimensions. Bind map references
+            // without registering occupancy or emitting unit movement/visibility events.
+            for(const auto &u:graph.records)u->Entity::setMap(manager.map());
+            for(std::size_t i=0;i<graph.records.size();++i)
+                graph.records[i]->actions.restoreRuntime(pending[i].actions,graph.index,time);
+            for(std::size_t i=0;i<graph.records.size();++i)
+                if(auto b=Building::fromUnit(graph.records[i]);b && b->constructors!=pending[i].constructors)
+                    throw SaveError("Saved constructor count disagrees with action graph");
+        } catch(...) {for(const auto &u:graph.records)u->annexes.clear();throw;}
+        return graph;
+    }
+};
+}
