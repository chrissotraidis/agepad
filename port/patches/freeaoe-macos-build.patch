+        for(std::size_t pos=0;(pos=value.find("\\n",pos))!=std::string::npos;++pos)value.replace(pos,2,"\n");
+        return value;
+    };
+    auto objectives=resolve(data.instructions,data.instructionsStringTable);
+    const auto current=m_scenarioController->objectiveReport();
+    if(!current.empty()) {
+        if(objectives.empty() || current.find(objectives)!=std::string::npos)objectives=current;
+        else objectives+="\n\n"+current;
+    }
+    return {objectives,resolve(data.hints,data.hintsStringTable),resolve(data.scouts,data.scoutsStringTable)};
+}
