diff --git a/src/mechanics/EntitySaveIndex.h b/src/mechanics/EntitySaveIndex.h
new file mode 100644
index 0000000..ba4a037
--- /dev/null
+++ b/src/mechanics/EntitySaveIndex.h
@@ -0,0 +1,59 @@
+#pragma once
+#include "core/SaveFile.h"
+#include "Entity.h"
+#include "Unit.h"
+#include <limits>
+#include <vector>
+#include <unordered_map>
+#include <unordered_set>
+
+namespace agepad {
+// Saved IDs identify records within one save. New runtime IDs may differ; all
+// stored references must resolve through this index, never through vector order
+// or a scenario spawnId (which is absent for dynamically created entities).
+class EntitySaveIndex {
+public:
+    using ID = std::uint64_t;
+    static constexpr ID nullID = std::numeric_limits<ID>::max();
+    static ID reference(const std::shared_ptr<Entity> &entity) {
+        if (!entity) return nullID;
+        if (entity->id == nullID) throw SaveError("Entity ID collides with null reference");
+        return static_cast<ID>(entity->id);
+    }
+    void add(ID savedID, const std::shared_ptr<Entity> &entity) {
+        if (m_sealed) throw SaveError("Entity registration after reference resolution began");
+        if (savedID==nullID || !entity) throw SaveError("Invalid saved entity registration");
+        if (m_entities.contains(savedID) || m_registered.contains(entity.get()))
+            throw SaveError("Duplicate saved entity ID or object");
+        m_entities.emplace(savedID,entity);
+        try { m_registered.insert(entity.get()); }
+        catch (...) { m_entities.erase(savedID); throw; }
+    }
+    void seal() { m_sealed=true; }
+    std::shared_ptr<Entity> entity(ID savedID) const {
+        if (!m_sealed) throw SaveError("Entity reference resolved before registration completed");
+        if (savedID==nullID) return {};
+        const auto found=m_entities.find(savedID);
+        if (found==m_entities.end()) throw SaveError("Saved entity reference is missing");
+        return found->second;
+    }
+    std::shared_ptr<Unit> unit(ID savedID) const {
+        const auto object=entity(savedID);
+        if (!object) return {};
+        if (!object->isUnit()) throw SaveError("Saved unit reference targets another entity type");
+        return std::static_pointer_cast<Unit>(object);
+    }
+    EntitySaveIndex extended(const std::vector<std::pair<ID,EntityPtr>> &additional) const {
+        if(!m_sealed)throw SaveError("Cannot extend an unresolved entity index");
+        EntitySaveIndex result;
+        for(const auto &[id,entity]:m_entities)result.add(id,entity);
+        for(const auto &[id,entity]:additional)result.add(id,entity);
+        result.seal();return result;
+    }
+    std::size_t size() const { return m_entities.size(); }
+private:
+    bool m_sealed=false;
+    std::unordered_map<ID,std::shared_ptr<Entity>> m_entities;
+    std::unordered_set<const Entity *> m_registered;
+};
+}
