+++ b/src/ui/CampaignBrowser.cpp
@@ -0,0 +1,136 @@
+#include "CampaignBrowser.h"
+#include "core/SaveFingerprint.h"
+#include "resource/AssetManager.h"
+#include "resource/LanguageManager.h"
+#include "resource/Resource.h"
+#include "render/SfmlRenderTarget.h"
+#include <genie/resource/UIFile.h>
+#include <genie/resource/SlpFile.h>
+#include <SFML/Graphics/RenderWindow.hpp>
+#include <SFML/Graphics/Sprite.hpp>
+#include <SFML/Graphics/Text.hpp>
+#include <SFML/Window/Event.hpp>
+#include <sstream>
+
+namespace {
+ScreenRect cardRect(int index) {return {224.f+(index%2)*290.f,75.f+(index/2)*132.f,262,112};}
+ScreenRect missionRect(int index) {return {835,125.f+index*62.f,320,60};}
+}
+CampaignBrowser::CampaignBrowser(std::vector<agepad::CampaignEntry> catalog,const agepad::CampaignProgress &progress)
+    : UiScreen("cam.sin"),m_catalog(std::move(catalog)),m_progress(progress) {}
+
+bool CampaignBrowser::init() {
+    if(!UiScreen::init())return false;
+    const auto folder=AssetManager::Inst()->assetsPath()+"/textures/ui/campaign-menu/";
+    // Use the shipped HD browser art and its 1366x768 coordinate system.
+    if(!m_background.loadFromFile(folder+"background.jpg"))return false;
+    m_backgroundSize={1366,768};
+    m_renderWindow->setView(sf::View(sf::FloatRect(0,0,1366,768)));
+    if(!m_border.loadFromFile(folder+"campaigns/normal.png") ||
+       !m_down.loadFromFile(folder+"campaigns/down.png") ||
+       !m_back.loadFromFile(folder+"back/up.png"))return false;
+    m_cards.resize(m_catalog.size());
+    for(std::size_t i=0;i<m_catalog.size();++i) {
+        if(i<5) {m_cards[i].loadFromFile(folder+"campaigns/retail"+std::to_string(i+1)+".png");continue;}
+        // Conquerors cards use their own original campaign-map artwork.
+        const auto ui=AssetManager::Inst()->getUIFile(m_catalog[i].screen);
+        if(!ui)continue;
+        const auto slp=AssetManager::Inst()->getSlp(ui->backgroundLarge.filename+".slp",AssetManager::ResourceType::Interface);
+        if(slp && slp->getFrame(0))m_cards[i].loadFromImage(Resource::convertFrameToImage(slp->getFrame(0),AssetManager::Inst()->getPalette(ui->paletteFile.id)));
+    }
+    selectCampaign(0);return true;
+}
+
+void CampaignBrowser::selectCampaign(int index) {
+    m_selected=index;m_missionCount=0;m_completed.clear();m_error.clear();
+    const auto &entry=m_catalog.at(index);
+    if(!entry.available()){m_error="Campaign files are missing from the imported data.";return;}
+    try {
+        genie::CpxFile archive;archive.setFileName(entry.archive.string());archive.load();
+        if(archive.getFilecount()!=entry.missionCount)throw agepad::SaveError("Unexpected campaign mission count");
+        for(unsigned i=0;i<entry.missionCount;++i) {
+            auto scenario=archive.getScnFile(i);
+            if(!scenario)throw agepad::SaveError("Campaign mission could not be read");
+            std::ostringstream stream(std::ios::binary);scenario->writeObject(stream);const auto bytes=stream.str();
+            m_completed.push_back(m_progress.completed(agepad::SaveFingerprint::bytes(agepad::SaveBytes(bytes.begin(),bytes.end()))));
+            ++m_missionCount;
+        }
+    } catch(const std::exception &) {m_missionCount=0;m_completed.clear();m_error="This campaign could not be loaded. Check the imported game data.";}
+}
+
+int CampaignBrowser::hit(const ScreenPos &p) const {
+    if(ScreenRect(224,20,262,45).contains(p))return 100;
+    if(ScreenRect(514,20,262,45).contains(p))return 101;
+    if(ScreenRect(357,684,193,43).contains(p))return 102;
+    const int first=m_group?5:0,count=m_group?4:5;
+    for(int i=0;i<count;++i)if(cardRect(i).contains(p))return first+i;
+    for(std::size_t i=0;i<m_missionCount;++i)if(missionRect(i).contains(p))return 200+i;
+    return -1;
+}
+bool CampaignBrowser::handleMouseEvent(const sf::Event &e) {
+    if((e.type!=sf::Event::MouseButtonPressed && e.type!=sf::Event::MouseButtonReleased) || e.mouseButton.button!=sf::Mouse::Left)return false;
+    const int target=hit({float(e.mouseButton.x),float(e.mouseButton.y)});
+    if(e.type==sf::Event::MouseButtonPressed){m_pressed=target;return false;}
+    const bool activate=target>=0 && target==m_pressed;cancelInteraction();if(!activate)return false;
+    if(target==102)return true;
+    if(target==100 || target==101){m_group=target-100;selectCampaign(m_group?5:0);return false;}
+    if(target>=200){
+        // Genie scenario serialization has process-wide version fields. Reload
+        // only the chosen scenario after catalog inspection, as the game loader does.
+        try {
+            genie::CpxFile archive;archive.setFileName(m_catalog[m_selected].archive.string());archive.load();
+            m_scenario=archive.getScnFile(target-200);return bool(m_scenario);
+        } catch(const std::exception &) {m_error="This mission could not be loaded.";return false;}
+    }
+    selectCampaign(target);return false;
+}
+void CampaignBrowser::handleKeyEvent(const sf::Event &e) {
+    if(e.type==sf::Event::KeyPressed && e.key.code==sf::Keyboard::Escape)m_renderWindow->close();
+}
+void CampaignBrowser::text(const std::string &label,float x,float y,float width,unsigned size,sf::Color color) {
+    sf::Text value;value.setFont(SfmlRenderTarget::plainFont());value.setCharacterSize(size);value.setFillColor(color);
+    // Wrap original localized mission names within the parchment column.
+    const auto input=sf::String::fromUtf8(label.begin(),label.end());sf::String output,line;
+    for(std::size_t i=0;i<input.getSize();++i) {
+        line+=input[i];value.setString(line);
+        if(value.getLocalBounds().width>width && line.getSize()>1) {
+            auto split=line.getSize()-1;
+            while(split>0 && line[split]!=' ')--split;
+            if(split==0)split=line.getSize()-1;
+            output+=line.substring(0,split);output+='\n';line=line.substring(split+(line[split]==' '?1:0));
+        }
+    }
+    output+=line;value.setString(output);value.setPosition(x,y);m_renderWindow->draw(value);
+}
+void CampaignBrowser::render() {
+    const sf::Color ink(52,34,18),selected(115,30,12);
+    auto draw=[&](const sf::Texture &texture,ScreenRect r) {
+        const auto size=texture.getSize();if(!size.x || !size.y)return;
+        sf::Sprite sprite(texture);sprite.setPosition(r.x,r.y);sprite.setScale(r.width/size.x,r.height/size.y);m_renderWindow->draw(sprite);
+    };
+    text("Age of Kings",240,25,240,27,m_group==0?selected:ink);
+    text("The Conquerors",526,25,250,27,m_group==1?selected:ink);
+    const int first=m_group?5:0,count=m_group?4:5;
+    for(int i=0;i<count;++i) {
+        const int index=first+i;const auto r=cardRect(i);
+        draw(m_cards[index],{r.x+9,r.y+5,244,77});
+        draw(index==m_selected || index==m_pressed?m_down:m_border,r);
+        const auto label=LanguageManager::getString(m_catalog[index].titleString);
+        sf::Text caption(sf::String::fromUtf8(label.begin(),label.end()),SfmlRenderTarget::plainFont(),22);
+        while(caption.getLocalBounds().width>244 && caption.getCharacterSize()>14)
+            caption.setCharacterSize(caption.getCharacterSize()-1);
+        if(caption.getLocalBounds().width>244)caption.setScale(244/caption.getLocalBounds().width,1);
+        caption.setFillColor(ink);caption.setPosition(r.x+9,r.y+77);m_renderWindow->draw(caption);
+    }
+    if(m_selected>=0) {
+        text(LanguageManager::getString(m_catalog[m_selected].titleString),835,75,320,28,ink);
+        if(!m_error.empty())text(m_error,835,135,320,22,ink);
+        for(std::size_t i=0;i<m_missionCount;++i) {
+            const auto r=missionRect(i);
+            const auto label=LanguageManager::getString(m_catalog[m_selected].firstMissionString+i);
+            text(label,r.x,r.y,320,22,m_pressed==200+int(i)?selected:ink);
+            if(m_completed[i])text("Completed",r.x,r.y+40,320,16,selected);
+        }
+    }
+    draw(m_back,{357,684,193,43});text("Main Menu",384,691,180,23,ink);
+}
