diff --git a/src/ui/TechnologyTreeModel.cpp b/src/ui/TechnologyTreeModel.cpp
new file mode 100644
index 0000000..ed1d077
--- /dev/null
+++ b/src/ui/TechnologyTreeModel.cpp
@@ -0,0 +1,156 @@
+#include "TechnologyTreeModel.h"
+#include "mechanics/Player.h"
+#include "resource/DataManager.h"
+#include <genie/dat/TechTree.h>
+#include <set>
+#include <algorithm>
+#include <stdexcept>
+int TechnologyTreeModel::representedUnitId(const Player &player,Key key)
+{
+    int id=key.second;
+    if(key.first!=Kind::Building)return id;
+    const auto &unit=player.civilization.unitData(id);
+    if(unit.Creatable.TrainLocationID<0) {
+        // A visible stacked building can have a separate construction record
+        // in the authored tree. Use that record's costs and current variant.
+        for(const auto &node:DataManager::Inst().techTree().BuildingConnections) {
+            const auto &candidate=player.civilization.unitData(node.ID);
+            if(candidate.ID>=0 && candidate.Creatable.TrainLocationID>=0 && candidate.Building.StackUnitID==id){id=node.ID;break;}
+        }
+    }
+    return player.upgradedUnitId(id);
+}
+TechnologyTreeModel::TechnologyTreeModel(const Player &player):m_player(player),m_research(DataManager::Inst().allTechs()),m_reachability(m_research.size(),-1)
+{
+    const auto &tree=DataManager::Inst().techTree();
+    std::set<Edge> edges;
+    auto add=[&](Node node){
+        if(!m_index.emplace(node.key,m_nodes.size()).second)throw std::runtime_error("Duplicate technology-tree node");
+        m_nodes.push_back(node);
+    };
+    auto child=[&](Key parent,Kind kind,const auto &ids){for(int id:ids)if(id>=0)edges.emplace(parent,Key{kind,id});};
+    auto common=[&](Node &node,const genie::techtree::Common &c){
+        const auto count=std::min({std::size_t(std::max(c.SlotsUsed,0)),c.Mode.size(),c.UnitResearch.size()});
+        for(std::size_t i=0;i<count;++i){
+            const int id=c.UnitResearch[i],mode=c.Mode[i];
+            if(id<0 || mode<0 || mode>3)continue;
+            if(mode==0){node.age=id;if(id==0)continue;}
+            edges.emplace(Key{static_cast<Kind>(mode),id},node.key);
+        }
+    };
+    for(const auto &n:tree.TechTreeAges){
+        Node node{{Kind::Age,n.ID}};node.age=n.ID;
+        node.unlocked=player.resourcesAvailable(genie::ResourceType::CurrentAge)>=n.ID-1;
+        add(node);child(node.key,Kind::Building,n.Buildings);child(node.key,Kind::Unit,n.Units);child(node.key,Kind::Research,n.Techs);
+    }
+    for(const auto &n:tree.BuildingConnections){
+        Node node{{Kind::Building,n.ID}};node.slot=n.LocationInAge;node.visible=n.LocationInAge!=0;node.enablingResearch=n.EnablingResearch;
+        common(node,n.Common);add(node);child(node.key,Kind::Building,n.Buildings);child(node.key,Kind::Unit,n.Units);child(node.key,Kind::Research,n.Techs);
+    }
+    for(const auto &n:tree.UnitConnections){
+        Node node{{Kind::Unit,n.ID}};node.building=n.UpperBuilding;node.line=n.VerticalLine;node.slot=n.LocationInAge;
+        node.enablingResearch=n.EnablingResearch;node.upgradeResearch=n.RequiredResearch;
+        common(node,n.Common);add(node);child(node.key,Kind::Unit,n.Units);
+        if(n.UpperBuilding>=0)edges.emplace(Key{Kind::Building,n.UpperBuilding},node.key);
+    }
+    for(const auto &n:tree.ResearchConnections){
+        Node node{{Kind::Research,n.ID}};node.building=n.UpperBuilding;node.line=n.VerticalLine;node.slot=n.LocationInAge;node.visible=n.LocationInAge!=0;
+        common(node,n.Common);add(node);child(node.key,Kind::Building,n.Buildings);child(node.key,Kind::Unit,n.Units);child(node.key,Kind::Research,n.Techs);
+        if(n.UpperBuilding>=0)edges.emplace(Key{Kind::Building,n.UpperBuilding},node.key);
+    }
+    for(const auto &unit:DataManager::Inst().civilization(player.civilization.id()).Units)
+        if(unit.ID>=0 && unit.Type==genie::Unit::BuildingType && unit.Building.TechID>=0)
+            m_buildingMarkers[unit.Building.TechID].push_back(unit.ID);
+    for(auto &node:m_nodes){
+        if(node.key.first==Kind::Research){
+            const auto future=researchReachability(node.key.second);
+            node.disabled=future==Reachability::Impossible;
+            node.availabilityKnown=future!=Reachability::Unknown;
+            node.researched=player.researchCompleted(node.key.second);
+            node.unlocked=player.researchAvailable(node.key.second) || node.researched;
+        }else if(node.key.first!=Kind::Age){
+            const auto &unit=player.civilization.unitData(representedUnitId(player,node.key));
+            node.disabled=unit.ID<0;
+            for(int research:{node.enablingResearch,node.upgradeResearch})if(research>=0){
+                const auto future=researchReachability(research);
+                if(future==Reachability::Impossible)node.disabled=true;
+                if(future==Reachability::Unknown)node.availabilityKnown=false;
+            }
+            node.unlocked=unit.ID>=0 && unit.Enabled;
+            // The Castle displays this civilization's unique unit line. Other
+            // producers retain unavailable entries (e.g. Longboat at the Dock),
+            // matching the supplied civilization charts. Keep hidden nodes in
+            // the graph so authored prerequisite links still resolve.
+            if(node.key.first==Kind::Unit && node.building==82)
+                for(int research:{node.enablingResearch,node.upgradeResearch})
+                    if(research>=0 && std::size_t(research)<m_research.size()) {
+                        const int owner=m_research[research].Civ;
+                        if(owner>=0 && owner!=player.civilization.id())node.visible=false;
+                    }
+        }
+    }
+    // Unit upgrades are represented by the resulting unit's icon, even when
+    // Common references the research ID (e.g. War Galley -> heavy ships).
+    auto representations=[&](Key key){
+        std::vector<Key> result;
+        if(m_index.count(key))result.push_back(key);
+        else if(key.first==Kind::Research)for(const auto &node:m_nodes)
+            if(node.upgradeResearch==key.second)result.push_back(node.key);
+        return result;
+    };
+    std::set<Edge> resolved;
+    for(const auto &edge:edges){
+        const auto from=representations(edge.first),to=representations(edge.second);
+        if(from.empty() || to.empty())m_unresolvedEdges.push_back(edge);
+        else for(const auto &a:from)for(const auto &b:to)if(a!=b)resolved.emplace(a,b);
+    }
+    m_edges.assign(resolved.begin(),resolved.end());
+}
+const TechnologyTreeModel::Node *TechnologyTreeModel::find(Kind kind,int id) const
+{
+    const auto it=m_index.find({kind,id});return it==m_index.end()?nullptr:&m_nodes[it->second];
+}
+TechnologyTreeModel::Reachability TechnologyTreeModel::researchReachability(int id) const {return resolveResearch(id);}
+TechnologyTreeModel::Reachability TechnologyTreeModel::resolveResearch(int id) const
+{
+    if(id<0 || std::size_t(id)>=m_research.size())return Reachability::Impossible;
+    int &cached=m_reachability[id];
+    if(cached==-2)return Reachability::Unknown; // Cyclic metadata must not invent a permanent exclusion.
+    if(cached>=0)return static_cast<Reachability>(cached);
+    const auto &tech=m_research[id];
+    if(m_player.civilization.researchDisabled(id) || (tech.Civ!=-1 && tech.Civ!=m_player.civilization.id())){
+        cached=int(Reachability::Impossible);return Reachability::Impossible;
+    }
+    cached=-2;
+    int possible=0,unknown=0;
+    for(int required:tech.RequiredTechs){
+        if(required<0)continue;
+        const auto result=resolveResearch(required);
+        possible+=result==Reachability::Possible;unknown+=result==Reachability::Unknown;
+    }
+    auto result=tech.RequiredTechCount<0?Reachability::Unknown:
+        possible>=tech.RequiredTechCount?Reachability::Possible:
+        possible+unknown>=tech.RequiredTechCount?Reachability::Unknown:Reachability::Impossible;
+    if(result==Reachability::Possible){cached=int(result);return result;}
+    // Building.TechID can independently grant a hidden marker. It is an
+    // alternative to normal prerequisites, not a replacement: Watch Tower's
+    // availability tech is also granted by constructing a Watch Tower.
+    if(const auto marker=m_buildingMarkers.find(id);marker!=m_buildingMarkers.end()){
+        bool markerUnknown=false;
+        const auto &units=DataManager::Inst().civilization(m_player.civilization.id()).Units;
+        for(int unitId:marker->second){
+            if(std::size_t(unitId)>=units.size())continue;
+            if(units[unitId].Enabled){cached=int(Reachability::Possible);return Reachability::Possible;}
+            const Node *building=find(Kind::Building,unitId);
+            if(!building)for(const auto &candidate:m_nodes)
+                if(candidate.key.first==Kind::Building && m_player.civilization.matchesBuildingReference(unitId,candidate.key.second)){building=&candidate;break;}
+            if(!building || building->enablingResearch<0){markerUnknown=true;continue;}
+            const auto available=resolveResearch(building->enablingResearch);
+            if(available==Reachability::Possible){cached=int(available);return available;}
+            markerUnknown|=available==Reachability::Unknown;
+        }
+        if(markerUnknown)result=Reachability::Unknown;
+    }
+    cached=result==Reachability::Unknown?-1:int(result);
+    return result;
+}
