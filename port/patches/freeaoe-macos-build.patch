+ActionGuard::ActionGuard(const std::shared_ptr<Unit> &unit,const std::shared_ptr<Unit> &target)
+    : IAction(Type::Guard,unit,Task::move()),m_target(target),m_follow(std::make_shared<ActionFollow>(unit,target)),
+      m_seenAttackRevision(target?target->attackRevision:0) {}
+IAction::UnitState ActionGuard::unitState() const
+{
+    return m_attack?m_attack->unitState():m_follow->unitState();
+}
+bool ActionGuard::canEngage(const std::shared_ptr<Unit> &enemy, bool reacting) const
+{
+    const auto unit=m_unit.lock(),target=m_target.lock();
+    if(!unit || !target || !enemy || enemy==target || enemy==unit || enemy->healthLeft()<=0 ||
+       unit->stance==Unit::Stance::NoAttack || enemy->map()!=unit->map())return false;
+    const auto owner=unit->player().lock();
+    if(!owner || (reacting?owner->isAllied(enemy->playerId()):owner->diplomaticStance(enemy->playerId())!=Player::Enemy))return false;
+    const float sight=unit->data()->LineOfSight*Constants::TILE_SIZE;
+    if(unit->distanceTo(target)>sight ||
+       (!reacting && target->distanceTo(enemy)>target->data()->LineOfSight*Constants::TILE_SIZE) ||
+       target->distanceTo(enemy)>sight+unit->data()->Combat.MaxRange*Constants::TILE_SIZE)return false;
+    if(unit->stance==Unit::Stance::StandGround) {
+        if(!enemy->mapRect().overlaps(unit->mapRect()) &&
+           unit->distanceTo(enemy)>unit->data()->Combat.MaxRange*Constants::TILE_SIZE)return false;
+        if(unit->position().distance(enemy->position())<unit->data()->Combat.MinRange*Constants::TILE_SIZE)return false;
+    }
+    return true;
+}
+Task ActionGuard::findTarget() const
+{
+    const auto unit=m_unit.lock(),target=m_target.lock();
+    if(!unit || !target || !unit->map())return {};
+    const auto map=unit->map();const auto owner=unit->player().lock();
+    const int radius=std::ceil(std::max(0.f,target->data()->LineOfSight))+1;
+    const int x=target->position().x/Constants::TILE_SIZE,y=target->position().y/Constants::TILE_SIZE;
+    Task best;float nearest=std::numeric_limits<float>::max();
+    for(int col=std::max(0,x-radius);col<=std::min(map->columnCount()-1,x+radius);++col)
+        for(int row=std::max(0,y-radius);row<=std::min(map->rowCount()-1,y+radius);++row)
+            for(const auto &entity:map->entitiesAt(col,row)) {
+                const auto enemy=Unit::fromEntity(entity);
+                if(!canEngage(enemy) || unit->distanceTo(enemy)>=nearest)continue;
+                const auto task=UnitActionHandler::findMatchingTask(owner,enemy,unit->actions.m_autoTargetTasks);
+                if(!task.data || (task.data->ActionType!=genie::ActionType::Combat && task.data->ActionType!=genie::ActionType::Attack))continue;
+                best=task;best.target=enemy;nearest=unit->distanceTo(enemy);
+            }
+    return best;
+}
+IAction::UpdateResult ActionGuard::update(Time time)
+{
+    const auto unit=m_unit.lock(),target=m_target.lock();
+    if(!unit || !target || target->healthLeft()<=0 || !unit->map() || target->map()!=unit->map())return UpdateResult::Completed;
+    if(m_seenAttackRevision!=target->attackRevision) {
+        m_seenAttackRevision=target->attackRevision;
+        const auto attacker=target->lastAttacker.lock();
+        if(canEngage(attacker,true)) {
+            const auto task=unit->actions.findTaskWithTarget(attacker);
+            if(task.data && (task.data->ActionType==genie::ActionType::Combat || task.data->ActionType==genie::ActionType::Attack)) {
+                // Repeated hits from the same source must not restart the
+                // guard's attack animation and prevent it from firing.
+                if(!m_attack || m_enemy.lock()!=attacker) {
+                    m_enemy=attacker;m_attack=std::make_shared<ActionAttack>(unit,task);
+                    m_follow=std::make_shared<ActionFollow>(unit,target);
+                }
+                m_reacting=true;
+            }
+        }
+    }
+    if(m_attack && !canEngage(m_enemy.lock(),m_reacting)) {m_attack.reset();m_enemy.reset();m_reacting=false;}
+    if(!m_attack) {
+        const auto task=findTarget();
+        if(task.isValid()) {
+            m_enemy=task.target;m_attack=std::make_shared<ActionAttack>(unit,task);
+            m_follow=std::make_shared<ActionFollow>(unit,target);
+        }
+    }
+    if(m_attack) {
+        const auto before=unit->position();const auto result=m_attack->update(time);
+        if(unit->distanceTo(target)>unit->data()->LineOfSight*Constants::TILE_SIZE) {
+            unit->setPosition(before);m_attack.reset();m_enemy.reset();m_reacting=false;
+        } else if(result==UpdateResult::Completed || result==UpdateResult::Failed) {
+            m_attack.reset();m_enemy.reset();m_reacting=false;return UpdateResult::Updated;
+        } else return result;
+    }
+    return m_follow->update(time);
+}
+agepad::SaveBytes ActionGuard::saveRuntime() const
+{
+    const auto unit=m_unit.lock();if(!unit)throw agepad::SaveError("Guard owner unavailable");
+    agepad::SaveWriter w;w.u32(2);w.u64(unit->id);w.u64(agepad::EntitySaveIndex::reference(m_target.lock()));
+    w.blob(m_follow->saveRuntime());w.u64(agepad::EntitySaveIndex::reference(m_enemy.lock()));w.boolean(bool(m_attack));
+    if(m_attack)w.blob(m_attack->saveRuntime());
+    w.u64(m_seenAttackRevision);w.boolean(m_reacting);return std::move(w.bytes);
+}
+std::shared_ptr<ActionGuard> ActionGuard::fromRuntime(const agepad::SaveBytes &bytes,
+    const agepad::EntitySaveIndex &entities,Time time)
+{
+    agepad::SaveReader r(bytes);const auto version=r.u32();if(version!=1 && version!=2)throw agepad::SaveError("Unsupported guard version");
+    const auto unit=entities.unit(r.u64()),target=entities.unit(r.u64());
+    auto follow=ActionFollow::fromRuntime(r.blob(),entities,time);const auto enemy=entities.unit(r.u64());
+    std::shared_ptr<ActionAttack> attack;if(r.boolean())attack=ActionAttack::fromRuntime(r.blob(),entities,time);
+    const auto seen=version>=2?r.u64():(target?target->attackRevision:0);
+    const bool reacting=version>=2?r.boolean():false;r.finish();
