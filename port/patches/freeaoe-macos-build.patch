diff --git a/src/settings/PinchInput.h b/src/settings/PinchInput.h
new file mode 100644
index 0000000..94283a3
--- /dev/null
+++ b/src/settings/PinchInput.h
@@ -0,0 +1,40 @@
+#pragma once
+#include <SFML/Window/Event.hpp>
+#include <cmath>
+#include <optional>
+#include <unordered_map>
+
+// Two world contacts zoom; any third contact blocks until every finger lifts.
+class PinchInput {
+public:
+    struct Change { float ratio, x, y; };
+    std::optional<Change> translate(const sf::Event &event, bool inWorld) {
+        if(event.type==sf::Event::LostFocus || event.type==sf::Event::Closed) { contacts.clear();blocked=false;return {}; }
+        if(event.type==sf::Event::TouchBegan) {
+            if(contacts.empty()) blocked=false;
+            contacts[event.touch.finger]={float(event.touch.x),float(event.touch.y)};
+            if(!inWorld || contacts.size()>2) blocked=true;
+            return {};
+        }
+        if(event.type==sf::Event::TouchEnded) {contacts.erase(event.touch.finger);return {};}
+        if(event.type!=sf::Event::TouchMoved) return {};
+        const auto found=contacts.find(event.touch.finger);
+        if(found==contacts.end()) return {};
+        const float before=distance();
+        found->second={float(event.touch.x),float(event.touch.y)};
+        if(!inWorld) blocked=true;
+        const float after=distance();
+        if(blocked || contacts.size()!=2 || before<12 || after<12) return {};
+        auto a=contacts.begin(),b=a;++b;
+        return Change{after/before,(a->second.x+b->second.x)/2,(a->second.y+b->second.y)/2};
+    }
+private:
+    struct Point {float x,y;};
+    float distance() const {
+        if(contacts.size()!=2) return 0;
+        auto a=contacts.begin(),b=a;++b;
+        return std::hypot(a->second.x-b->second.x,a->second.y-b->second.y);
+    }
+    std::unordered_map<unsigned,Point> contacts;
+    bool blocked=false;
+};
diff --git a/src/settings/TouchInput.h b/src/settings/TouchInput.h
new file mode 100644
index 0000000..ffb8b90
--- /dev/null
+++ b/src/settings/TouchInput.h
@@ -0,0 +1,65 @@
+#pragma once
+#include <SFML/Window/Event.hpp>
+#include <vector>
+#include <cstdint>
+#include <unordered_set>
+
+// Minimal single-contact bridge: tap selects, drag box-selects, hold orders.
+// Commands still travel through the ordinary mouse/UI handlers.
+class TouchInput {
+public:
+    bool takeCancellation() { const bool result=cancelled;cancelled=false;return result; }
+    std::vector<sf::Event> translate(const sf::Event &input, std::int64_t now,
+                                     bool allowOrder, float slop = 12.f) {
+        if (input.type == sf::Event::LostFocus || input.type == sf::Event::Closed) {
+            active = dragging = false;contacts.clear();blocked=false;cancelled=true;
+            return {input};
+        }
+        if (input.type != sf::Event::TouchBegan && input.type != sf::Event::TouchMoved &&
+            input.type != sf::Event::TouchEnded) return {input};
+        if(input.type==sf::Event::TouchBegan) {
+            contacts.insert(input.touch.finger);
+            if(input.touch.finger!=0 || contacts.size()>1) {
+                active=dragging=false;blocked=true;cancelled=true;
+            }
+        }
+        if(input.type==sf::Event::TouchEnded)contacts.erase(input.touch.finger);
+        if(blocked) {
+            if(contacts.empty())blocked=false;
+            return {};
+        }
+        if (input.touch.finger != 0) return {};
+        const int x = input.touch.x, y = input.touch.y;
+        if (input.type == sf::Event::TouchBegan) {
+            active = true; dragging = false; startX = x; startY = y; started = now;
+            return {};
+        }
+        if (!active) return {};
+        std::vector<sf::Event> output;
+        const double dx = x - startX, dy = y - startY;
+        if (!dragging && dx*dx + dy*dy > slop*slop) {
+            dragging = true;
+            output.push_back(button(sf::Event::MouseButtonPressed, startX, startY, sf::Mouse::Left));
+        }
+        if (dragging) {
+            sf::Event moved{}; moved.type = sf::Event::MouseMoved;
+            moved.mouseMove.x = x; moved.mouseMove.y = y; output.push_back(moved);
+        }
+        if (input.type == sf::Event::TouchEnded) {
+            const auto which = !dragging && allowOrder && now-started >= 450 ? sf::Mouse::Right : sf::Mouse::Left;
+            if (!dragging) output.push_back(button(sf::Event::MouseButtonPressed, x, y, which));
+            output.push_back(button(sf::Event::MouseButtonReleased, x, y, which));
+            active = dragging = false;
+        }
+        return output;
+    }
+private:
+    static sf::Event button(sf::Event::EventType type, int x, int y, sf::Mouse::Button which) {
+        sf::Event event{}; event.type = type; event.mouseButton = {which, x, y}; return event;
+    }
+    bool active = false, dragging = false;
+    bool blocked = false, cancelled = false;
+    std::unordered_set<unsigned> contacts;
+    int startX = 0, startY = 0;
+    std::int64_t started = 0;
+};
