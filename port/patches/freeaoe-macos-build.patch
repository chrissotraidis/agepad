+
+void Unit::restoreBaseRuntime(const agepad::SaveBytes &bytes,Time simulationTime)
+{
+    // A live unit would require changing occupancy, visibility and membership
+    // accounting. Stage detached units, then rebuild that graph in the loader.
+    if(map() || actions.currentAction() || !actions.m_actionQueue.empty())
+        throw agepad::SaveError("Unit base restore requires detached inactive unit");
+    agepad::SaveReader reader(bytes);
+    if(reader.u32()!=1)throw agepad::SaveError("Unsupported unit base version");
+    const auto unitID=reader.i32(),ownerID=reader.i32();const bool building=reader.boolean();
+    if(unitID!=data()->ID || ownerID!=playerId() || building!=isBuilding())
+        throw agepad::SaveError("Unit base identity mismatch");
+    const auto spawn=reader.i32();const auto visible=reader.boolean();
+    MapPos pos;pos.x=reader.f32();pos.y=reader.f32();pos.z=reader.f32();
+    const auto angle=reader.f32(),creation=reader.f32(),damage=reader.f32();
+    const auto previous=reader.i64();const auto sight=reader.i32(),savedStance=reader.i32(),missiles=reader.i32();
+    const auto attackTime=reader.i64();
+    if(pos.x<0 || pos.y<0 || pos.x>=Constants::MAP_MAX_SIZE*Constants::TILE_SIZE || pos.y>=Constants::MAP_MAX_SIZE*Constants::TILE_SIZE)
+        throw agepad::SaveError("Invalid saved unit position");
+    // Non-creatable scenery retains the DAT's negative train-time sentinel.
+    // Preserve that exact initialized value, without accepting arbitrary
+    // negative construction progress for trainable units or buildings.
+    const int trainTime = data()->Creatable.TrainTime;
+    if(trainTime < 0 ? creation != trainTime : (creation < 0 || creation > trainTime))
+        throw agepad::SaveError("Invalid saved unit construction progress");
+    if(previous<0 || previous>simulationTime || attackTime<0 || attackTime>simulationTime)
+        throw agepad::SaveError("Invalid saved unit timestamp");
+    // Scenery may retain a negative DAT sight sentinel and reveals no tiles.
+    // Accept only its exact initialized value, not arbitrary negative radii.
+    if((sight<0 && sight!=int(data()->LineOfSight)) || sight>Constants::MAP_MAX_SIZE)
+        throw agepad::SaveError("Invalid saved unit sight radius");
+    if(savedStance < -1 || savedStance>int(Stance::NoAttack) || missiles<0)
+        throw agepad::SaveError("Invalid saved unit combat state");
+    const auto count=reader.u32();
+    if(count>65536)throw agepad::SaveError("Too many unit resources");
+    ResourceMap savedResources;int last=std::numeric_limits<int>::min();
+    for(std::uint32_t i=0;i<count;++i){
+        const int key=reader.i32();const float value=reader.f32();
+        if(key < -32768 || key>32767 || key<=last)throw agepad::SaveError("Invalid unit resource key");
+        last=key;savedResources.emplace(genie::ResourceType(key),value);
+    }
+    auto graphic=GraphicRender::fromRuntime(reader.blob(),simulationTime);
+    reader.finish();
+    // Everything above is staged. Direct scalar commit emits no unit movement,
+    // damage, creation, discovery or resource events and does not reapply costs.
+    Entity::setPosition(pos,true);
+    spawnId=spawn;isVisible=visible;m_angle=angle;m_creationProgress=creation;m_damageTaken=damage;
+    m_prevTime=previous;m_lineOfSight=sight;stance=Stance(savedStance);
+    activeMissiles=missiles;lastAttackTime=attackTime;
+    lastAttacker.reset();attackRevision=0; // Cross-unit damage links are restored by the graph.
+    resources.swap(savedResources);m_renderer.swap(graphic);
+}
