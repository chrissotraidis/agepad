+TechnologyTreePanel::TechnologyTreePanel(UiScreen *screen,std::shared_ptr<GameState> state)
+    :m_screen(screen),m_state(std::move(state)),m_model(*m_state->humanPlayer())
+{
+    auto &assets=AssetManager::Inst();
+    auto load=[&](sf::Texture &texture,const char *file,int frame){if(auto slp=assets->getSlp(file))texture.loadFromImage(Resource::convertFrameToImage(slp->getFrame(frame)));};
+    load(m_background,"techback.slp",2);load(m_ages,"techages.slp",13);load(m_tile,"tech_tile.slp",0);
+    for(int i=0;i<6;++i)load(m_frames[i],"technodex.slp",i);
+    const auto &civ=m_state->humanPlayer()->civilization;
+    const TechnologyTreeLayout placement(m_model);
+    m_extent=placement.width();
+    for(const auto &node:m_model.nodes()) {
+        if(!node.visible || node.key.first==TechnologyTreeModel::Kind::Age)continue;
+        const auto point=placement.positions().at(node.key);
+        Item item;item.key=node.key;item.x=point.x;item.y=point.y;
+        int icon=-1;unsigned name=0;
+        auto type=AssetManager::StandardSlpType::Technology;
+        if(node.key.first==TechnologyTreeModel::Kind::Research) {
+            const auto &tech=DataManager::Inst().getTech(node.key.second);icon=tech.IconID;name=tech.LanguageDLLName;
+        } else {
+            const auto &unit=civ.unitData(node.key.second);icon=unit.IconID;name=unit.LanguageDLLName;
+            type=node.key.first==TechnologyTreeModel::Kind::Building?AssetManager::StandardSlpType::Buildings:AssetManager::StandardSlpType::Units;
+        }
+        item.name=LanguageManager::getString(name);
+        if(item.name.empty())item.name="ID "+std::to_string(node.key.second);
+        if(auto slp=assets->getInterfaceSlp(type,civ.id()))if(icon>=0 && unsigned(icon)<slp->getFrameCount())item.icon.loadFromImage(Resource::convertFrameToImage(slp->getFrame(icon)));
+        m_extent=std::max(m_extent,item.x+80);m_index[item.key]=m_items.size();m_items.push_back(std::move(item));
+    }
+    m_left.text="<";m_right.text=">";m_close.text="Close";m_detailsButton.text="Details";
+    layout(800,600);
+}
+void TechnologyTreePanel::layout(float width,float height)
+{
+    m_width=width;m_height=height;m_scale=std::max(0.1f,(height-160)/600.f);
+    m_left.rect=ScreenRect(16,height-40,44,30);m_right.rect=ScreenRect(68,height-40,44,30);m_close.rect=ScreenRect(width-126,height-40,110,30);m_detailsButton.rect=ScreenRect(width-248,height-40,110,30);scroll(0);
+}
+void TechnologyTreePanel::scroll(float amount) {m_offset=std::clamp(m_offset+amount,0.f,std::max(0.f,m_extent-(m_width-94)/m_scale));}
+bool TechnologyTreePanel::back() {if(!m_details)return false;m_details.reset();cancelInteraction();return true;}
+void TechnologyTreePanel::cancelInteraction() {if(m_details)m_details->cancelInteraction();m_detailsButton.pressed=false;m_down=false;m_pressed=-1;m_left.pressed=m_right.pressed=m_close.pressed=false;}
+int TechnologyTreePanel::hit(float x,float y) const
+{
+    if(x<94 || y<40 || y>=m_height-120)return -1;
+    x=(x-94)/m_scale+m_offset;y=(y-40)/m_scale;
+    for(std::size_t i=0;i<m_items.size();++i)if(x>=m_items[i].x && x<m_items[i].x+64 && y>=m_items[i].y && y<m_items[i].y+64)return int(i);
+    return -1;
+}
+void TechnologyTreePanel::render(std::shared_ptr<sf::RenderWindow> &target)
+{
+    const auto size=target->getView().getSize();layout(size.x,size.y);
+    if(m_details){m_details->render(target);return;}
+    auto draw=[&](const sf::Texture &texture,float x,float y,float sx=1,float sy=1){if(!texture.getSize().x)return;sf::Sprite sprite(texture);sprite.setPosition(x,y);sprite.setScale(sx,sy);target->draw(sprite);};
+    for(float y=0;y<m_height;y+=300)for(float x=0;x<m_width;x+=300)draw(m_tile,x,y);
+    auto label=[&](const std::string &value,float x,float y,unsigned size,float width){sf::Text text(sf::String::fromUtf8(value.begin(),value.end()),SfmlRenderTarget::plainFont(),size);text.setFillColor(sf::Color(40,25,12));auto str=text.getString();while(text.getLocalBounds().width>width && str.getSize()>1){str.erase(str.getSize()-1);text.setString(str+"...");}text.setPosition(x,y);target->draw(text);};
+    label(m_state->humanPlayer()->civilization.name()+" — Technology Tree",18,8,22,m_width-36);
+    draw(m_ages,0,40,94.f/150,m_scale);
+    // A separate view clips both branches and icons to the scrollable tree.
+    const auto saved=target->getView();sf::View tree(sf::FloatRect(m_offset,0,(m_width-94)/m_scale,600));
+    const auto viewport=saved.getViewport();tree.setViewport(sf::FloatRect(viewport.left+viewport.width*94/m_width,viewport.top+viewport.height*40/m_height,viewport.width*(m_width-94)/m_width,viewport.height*(m_height-160)/m_height));target->setView(tree);
+    for(float x=std::floor(m_offset/150)*150;x<m_offset+(m_width-94)/m_scale;x+=150)draw(m_background,x,0);
+    for(const auto &edge:m_model.edges()) {
+        auto a=m_index.find(edge.first),b=m_index.find(edge.second);if(a==m_index.end() || b==m_index.end())continue;
+        const auto &from=m_items[a->second],&to=m_items[b->second];
+        // Show the selected item's prerequisites without obscuring the entire tree with all producer links.
+        if(std::abs(from.x-to.x)>80 && int(a->second)!=m_selected && int(b->second)!=m_selected)continue;
+        sf::VertexArray lines(sf::LineStrip,4);const sf::Color ink(90,55,25);
+        lines[0]=sf::Vertex({from.x+32,from.y+64},ink);lines[1]=sf::Vertex({from.x+32,from.y+68},ink);lines[2]=sf::Vertex({to.x+32,from.y+68},ink);lines[3]=sf::Vertex({to.x+32,to.y},ink);target->draw(lines);
+    }
+    for(std::size_t i=0;i<m_items.size();++i) {
+        const auto &item=m_items[i];if(item.x+64<m_offset || item.x>m_offset+(m_width-94)/m_scale)continue;
+        const auto *node=m_model.find(item.key.first,item.key.second);
+        int frame=item.key.first==TechnologyTreeModel::Kind::Building?0:item.key.first==TechnologyTreeModel::Kind::Unit?2:4;
+        draw(m_frames[frame+(int(i)==m_selected?1:0)],item.x,item.y);
+        if(item.icon.getSize().x){sf::Sprite icon(item.icon);icon.setPosition(item.x+14,item.y+3);icon.setScale(36.f/item.icon.getSize().x,36.f/item.icon.getSize().y);if(node->disabled)icon.setColor(sf::Color(120,120,120));target->draw(icon);}
+        sf::Text name("",SfmlRenderTarget::plainFont(),10);name.setFillColor(sf::Color::White);
+        auto lines=agepad::wrapText(item.name,60,[&](const std::string &s){name.setString(sf::String::fromUtf8(s.begin(),s.end()));return name.getLocalBounds().width;});
+        for(std::size_t row=0;row<std::min<std::size_t>(2,lines.size());++row){name.setString(sf::String::fromUtf8(lines[row].begin(),lines[row].end()));name.setPosition(item.x+2,item.y+40+row*11);target->draw(name);}
+        if(node->disabled){sf::VertexArray cross(sf::Lines,4);cross[0]=sf::Vertex({item.x+5,item.y+5},sf::Color::Red);cross[1]=sf::Vertex({item.x+59,item.y+59},sf::Color::Red);cross[2]=sf::Vertex({item.x+59,item.y+5},sf::Color::Red);cross[3]=sf::Vertex({item.x+5,item.y+59},sf::Color::Red);target->draw(cross);}
+    }
+    target->setView(saved);
+    if(m_selected>=0) {
+        const auto &item=m_items[m_selected];const auto *node=m_model.find(item.key.first,item.key.second);
+        label(item.name,18,m_height-112,20,m_width-36);
+        const std::string status=node->disabled?"Unavailable to this civilization":node->researched?"Researched":node->unlocked?"Unlocked":"Requires further advancement";
+        label(status,18,m_height-86,15,m_width-36);
+        std::string prerequisites;
+        for(const auto &edge:m_model.edges())if(edge.second==item.key){auto found=m_index.find(edge.first);if(found!=m_index.end()){if(!prerequisites.empty())prerequisites+=", ";prerequisites+=m_items[found->second].name;}}
+        if(!prerequisites.empty())label("Connected prerequisites: "+prerequisites,18,m_height-64,13,m_width-36);
+    } else label("Select an icon to inspect it. Red crosses mark unavailable units and technologies.",18,m_height-106,15,m_width-36);
+    label("Drag or scroll to explore.",128,m_height-36,14,m_width-388);
+    if(m_selected>=0 && m_screen)m_detailsButton.render(m_screen);
+    for(auto *button:{&m_left,&m_right,&m_close})if(m_screen)button->render(m_screen);
+}
+bool TechnologyTreePanel::handleEvent(const sf::Event &event)
+{
+    if(m_details){if(event.type==sf::Event::KeyPressed && event.key.code==sf::Keyboard::Escape){back();return false;}if(m_details->handleEvent(event)==Dialog::Cancel)back();return false;}
+    if(event.type==sf::Event::KeyPressed){if(event.key.code==sf::Keyboard::Escape)return true;if(event.key.code==sf::Keyboard::Left)scroll(-240);if(event.key.code==sf::Keyboard::Right)scroll(240);if(event.key.code==sf::Keyboard::Home)scroll(-m_extent);if(event.key.code==sf::Keyboard::End)scroll(m_extent);}
+    if(event.type==sf::Event::MouseWheelScrolled)scroll(-event.mouseWheelScroll.delta*160);
+    if(event.type==sf::Event::MouseMoved && m_down){const float x=event.mouseMove.x;if(std::abs(x-m_downX)>5 || std::abs(event.mouseMove.y-m_downY)>5)m_dragged=true;if(m_dragged)scroll((m_lastX-x)/m_scale);m_lastX=x;}
+    if((event.type==sf::Event::MouseButtonPressed || event.type==sf::Event::MouseButtonReleased) && event.mouseButton.button==sf::Mouse::Left){
+        ScreenPos p(event.mouseButton.x,event.mouseButton.y);int control=m_left.rect.contains(p)?0:m_right.rect.contains(p)?1:m_close.rect.contains(p)?2:m_selected>=0 && m_detailsButton.rect.contains(p)?3:-1;
+        if(event.type==sf::Event::MouseButtonPressed){m_pressed=control;m_down=control<0 && p.x>=94 && p.y>=40 && p.y<m_height-120;m_downX=m_lastX=p.x;m_downY=p.y;m_dragged=false;m_left.pressed=control==0;m_right.pressed=control==1;m_close.pressed=control==2;m_detailsButton.pressed=control==3;}
+        else {const bool activate=control>=0 && control==m_pressed;if(m_down && !m_dragged)m_selected=hit(p.x,p.y);cancelInteraction();if(activate){if(control==0)scroll(-480);if(control==1)scroll(480);if(control==2)return true;if(control==3){m_details=std::make_shared<Dialog>(m_screen);const auto &item=m_items[m_selected];m_details->showInfo(item.name,agepad::technologyTreeDescription(*m_state->humanPlayer(),item.key));}}}
+    }
+    return false;
+}
