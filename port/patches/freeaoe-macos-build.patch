+    enableUnit(toId);
+}
+
+agepad::SaveBytes Civilization::saveUnitAttributes() const
+{
+    agepad::SaveWriter writer;
+    writer.u32(1);
+    writer.i32(m_civId);
+    writer.u32(static_cast<std::uint32_t>(m_unitsData.size()));
+    for (const auto &unit : m_unitsData) {
+        writer.i32(unit.ID);
+        writer.u32(static_cast<std::uint32_t>(unit.Combat.Armours.size()));
+        writer.u32(static_cast<std::uint32_t>(unit.Combat.Attacks.size()));
+        agepad::visitUnitAttributes(unit,[&](auto value) { agepad::writeAttribute(writer,value); });
+    }
+    return std::move(writer.bytes);
+}
+
+void Civilization::restoreUnitAttributes(const agepad::SaveBytes &bytes)
+{
+    agepad::SaveReader reader(bytes);
+    if (reader.u32()!=1) throw agepad::SaveError("Unsupported unit attribute section version");
+    if (reader.i32()!=m_civId || reader.u32()!=m_unitsData.size())
+        throw agepad::SaveError("Civilization attribute baseline mismatch");
+    auto staged=m_unitsData;
+    for (auto &unit : staged) {
+        if (reader.i32()!=unit.ID || reader.u32()!=unit.Combat.Armours.size() || reader.u32()!=unit.Combat.Attacks.size())
+            throw agepad::SaveError("Unit attribute shape mismatch");
+        agepad::visitUnitAttributes(unit,[&](auto &value) { agepad::readAttribute(reader,value); });
+        if (unit.Enabled!=0 && unit.Enabled!=1) throw agepad::SaveError("Invalid saved unit availability");
+    }
+    reader.finish();
+    // Build derived availability before commit; pointers refer to stable live
+    // records, not the temporary copies. No research/resource events are fired.
+    decltype(m_creatableUnits) creatable;
+    for (std::size_t i=0;i<staged.size();++i) {
+        const auto &unit=staged[i];
+        if (unit.Enabled && unit.Creatable.TrainLocationID>0)
+            creatable[unit.Creatable.TrainLocationID].push_back(&m_unitsData[i]);
+    }
+    // Assign scalar attributes only, retaining addresses of live unit records
+    // and their task/attack/armor arrays used elsewhere in the engine.
+    agepad::SaveReader commit(bytes);
+    commit.u32(); commit.i32(); commit.u32();
+    for (auto &unit : m_unitsData) {
+        commit.i32(); commit.u32(); commit.u32();
+        agepad::visitUnitAttributes(unit,[&](auto &value) { agepad::readAttribute(commit,value); });
+    }
+    m_creatableUnits.swap(creatable);
+}
