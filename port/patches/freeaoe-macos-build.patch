+#pragma once
+#include "core/SaveArchive.h"
+#include <genie/dat/Unit.h>
+#include <type_traits>
+
+namespace agepad {
+// Every field modified by Civilization::applyUnitAttributeModifier plus Enabled.
+// Extend this inventory when adding a new mutable civilization attribute.
+template<class Unit, class Visitor>
+void visitUnitAttributes(Unit &u, Visitor &&visit) {
+    visit(u.Enabled); visit(u.HitPoints); visit(u.LineOfSight);
+    visit(u.GarrisonCapacity); visit(u.Size.x); visit(u.Size.y); visit(u.Speed);
+    visit(u.Moving.RotationSpeed); visit(u.Combat.ReloadTime);
+    visit(u.Combat.AccuracyPercent); visit(u.Combat.MaxRange);
+    visit(u.Action.WorkRate); visit(u.ResourceCapacity); visit(u.Combat.BaseArmor);
+    visit(u.Combat.ProjectileUnitID); visit(u.IconID); visit(u.Combat.DefenseTerrainBonus);
+    visit(u.Missile.SmartMode); visit(u.Combat.MinRange); visit(u.Combat.BlastWidth);
+    visit(u.Action.SearchRadius); visit(u.Creatable.TrainTime);
+    visit(u.Creatable.TotalProjectiles); visit(u.Creatable.MaxTotalProjectiles);
+    visit(u.Building.GarrisonHealRate); visit(u.Creatable.HeroMode);
+    for (auto &cost : u.Creatable.ResourceCosts) visit(cost.Amount);
+    for (auto &armor : u.Combat.Armours) visit(armor.Amount);
+    for (auto &attack : u.Combat.Attacks) visit(attack.Amount);
+}
+template<class T> void writeAttribute(SaveWriter &writer, T value) {
+    if constexpr (std::is_floating_point_v<T>) {
+        static_assert(std::is_same_v<T,float>);
+        writer.f32(value);
+    } else {
+        static_assert(std::is_integral_v<T> && sizeof(T)<=4);
+        writer.i64(value);
+    }
+}
+template<class T> void readAttribute(SaveReader &reader, T &value) {
+    if constexpr (std::is_floating_point_v<T>) {
+        static_assert(std::is_same_v<T,float>);
+        value=reader.f32();
+    } else {
+        static_assert(std::is_integral_v<T> && sizeof(T)<=4);
+        auto saved=reader.i64();
+        if (saved<std::numeric_limits<T>::min() || saved>std::numeric_limits<T>::max())
+            throw SaveError("Unit attribute outside native range");
+        value=static_cast<T>(saved);
+    }
+}
+}
